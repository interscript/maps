system "BSI:kor-Kore:Latn:6505-1982" {

metadata {
  authority_id bsi
  id 6505-1982
  language iso-639-2:kor
  source_script Kore
  destination_script Latn
  name "PD 6505:1982 Guide to the romanization of Korean (BSI mechanical system)"
  url ""
  creation_date 1982
  adoption_date
  description {    BSI PD 6505:1982, Guide to the romanization of Korean. A mechanical,
    orthographic system: 14 consonants (the circle is silent initially and
    ng finally), 14 vowels including /ai/ /ei/ /yai/ /yei/, and the
    horizontal-stroke vowel rendered w; compound vowels are the plain
    concatenation of their components' values (\uC640 = oa, \uC65C = uei,
    \uC758 = wi). Not McCune-Reischauer. Transcribed visually from the
    scan (no text layer); letter tables and syllable mechanics from
    sections 2-3 read verbatim.
  }

  notes {
    note "DRAFT: sections 13-15 of the source (basic romanization word
    rules, phonetic detail, letter names) are not yet transcribed; the
    map implements the captured letter tables and syllable mechanics.
    Tense consonants (\u1101 etc.) follow member-doubling; a few rare
    trailing clusters are provisional. Tests are limited to examples
    read unambiguously at high zoom. In maps-staging pending the
    remaining rule sections."
  }
}

tests {
   "\uC544" ->  "a"
   "\uC57C" ->  "ya"
   "\uC5B4" ->  "e"
   "\uC640" ->  "oa"
   "\uC65C" ->  "uei"
   "\uC704" ->  "ui"
   "\uD558" ->  "ha"
   "\uB300" ->  "tai"
}

