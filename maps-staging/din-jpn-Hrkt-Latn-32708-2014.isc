    sub "モ" "mo"
    sub "や" "ya"
    sub "ヤ" "ya"
    sub "ゆ" "yu"
    sub "ユ" "yu"
    sub "よ" "yo"
    sub "ヨ" "yo"
    sub "ら" "ra"
    sub "ラ" "ra"
    sub "り" "ri"
    sub "リ" "ri"
    sub "る" "ru"
    sub "ル" "ru"
    sub "れ" "re"
    sub "レ" "re"
    sub "ろ" "ro"
    sub "ロ" "ro"
    sub "わ" "wa"
    sub "ワ" "wa"
    sub "ゐ" "i"
    sub "ヰ" "i"
    sub "ゑ" "e"
    sub "ヱ" "e"
    sub "を" "o"
    sub "ヲ" "o"
    sub "ん" "n"
    sub "ン" "n"
  }

  # long-vowel and diphthong merges (after the kana pass)
  parallel {
    sub "ou" "ō"
    sub "oo" "ō"
    sub "uu" "ū"
    sub "ei" "ē"
  }
}

}
