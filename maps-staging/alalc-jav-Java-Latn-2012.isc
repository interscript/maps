   "\uA98F\uA9BE" ->  "kya"
   "\uA98F\uA9BF" ->  "kra"
   "\uA98F\uA9BD" ->  "krĕ"
   "\uA9A5\uA9B3" ->  "fa"
   "\uA98F\uA9B3" ->  "kha"
   "\uA994\uA9B3" ->  "\u2019a"
   "\uA997\uA9B3" ->  "za"
   "\uA9D1" ->  "1"
   "\uA9A4\uA9B2" ->  "naha"
   "\uA9B2" ->  "ha"
}

