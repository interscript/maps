system "T:pp-tests-meta:1" {
  metadata {
    authority_id tst
    id 1
    language iso-639-2:eng
    source_script Latn
    destination_script Latn
    name Test meta
    url https://example.com
    creation_date 2024
    description { A description here.
    }
    notes {
      note "note one"
      note "note two"
    }
  }
  stage main {
    parallel { sub "a" "b" }
  }
  tests {
    "ab" -> "bb"
  }
}
