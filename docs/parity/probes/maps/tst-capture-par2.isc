# P10c: capture AFTER a plain rule in the same parallel block —
# group-numbering shift in the megaregexp join.
system "T:tst-capture-par2:1" {
  stage main {
    parallel {
      sub "k" "K"
      sub {
        from capture(any("a".."z")) + capture(any("0".."9"))
        to ref(2) + ref(1)
      }
    }
  }
}
