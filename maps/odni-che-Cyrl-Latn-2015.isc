system "ODNI:che-Cyrl:Latn:2015" {

metadata {
  authority_id odni
  id 2015
  language iso-639-2:che
  source_script Cyrl
  destination_script Latn
  name ICS-630-01 Romanization of Chechen Cyrillic Personal Names (2015)
  source ICS-630-01 Annex C
  creation_date 2015
  confirmation_date 2015

  description {    This system is the Intelligence Community (IC) standard for the transliteration of Chechen names
    that will be applied to all final written reports and products for IC consumers. It is not intended to
    eliminate variations of a name that can contribute forensic information. Rather, it is to provide an
    IC standard Romanized (English) transliteration from Chechen that can then be linked to forensic
    information in ways that will help identify the referent of the name.
    In cases where an individual’s name has already been transliterated in a variant spelling, the IC
    Standard spelling should appear first, followed by the variant spelling(s) in parentheses at the first
    usage. In addition, if the original Cyrillic or Arabic-script spelling is known, that spelling should
    also appear in parentheses following the name, if possible, following best practices of the issuing
    organization and taking into consideration information system capabilities. For example: Ilyas
    Akhmadkant (also seen as Ilyas Axmadkhant, Ильяс Ахмадкӏант). This convention is designed
    to ensure that vital forensic information is not lost.
    For names of persons who are known to not be part of the Chechen-speaking community, use the
    relevant IC transliteration standard for names from that language (e.g., Mikhail, Yitzhak). A
    translator’s note may be used to clarify the known origin of the person. Spell names of
    individuals from languages that are written in Roman letters as they are spelled in those
    languages (e.g., George Clooney, Jorge Garcia, Georges Pompidou).
    In the case of active senior government officials in the on-line CIA World Factbook and the online
    directory of Chiefs of State and Cabinet Members of Foreign Governments, the spellings
    given in these on-line reference works should be used in place of the IC Standard. For any
    individual who has at one time been listed in the Factbook or Chiefs of State directory but who no
    longer appears in those resources (i.e. is no longer a government official), the IC Standard
    spelling should appear first, with the spelling, if known, as it previously appeared in those
    resources listed within parentheses at the first usage.
    The primary goal is to produce a consistent Romanized transcription of names that is specifically
    readable to the English-speaking non-specialist. The system uses the 26 letters of the standard
    (English) Roman alphabet plus the apostrophe. Some ambiguities in the Romanized form will
    occur without the use of diacritics. However, within the context of a report, where additional
    information about the individual is provided, the referent will be clearly identified. This system
    will be used in conjunction with on-line tools, name dictionaries, and lists containing
    conventional spellings of names of well-known individuals.
  }

  notes {
    note "Add a preceding 'y' if the vowel is preceded by the sound of a 'y' consonant."
    note "      This is a single apostrophe as found on regular US keyboards (ASCII character 39),\n      though software may render the apostrophe with differing appearances (e.g. curved left or right).\n      Note that the same apostrophe is used for 'ъ', '|', 'ӏ', and '1'."
    note "A word-initial hard sign 'ъ' is not represented, but instead is left out of the transliteration."
    note "The romanization follows the dialect spoken in Chechnya rather than other local pronunciations."
    note "Long and short vowels are not distinguished in this system."
    note "In the Roman, no distinction is made between digraphs such as 'sh' and single contiguous letters (e.g. 's' followed by 'h')."
    note "The Cyrillic soft sign ('ь') by itself (not part of a digraph) is not represented, but instead is left out of the transliteration."
    note "Interpretation of Cyrillic digraphs in Table 1 takes precedence over interpretation of the individual\n characters. Thus, 'кх' -> 'q', and not to 'k' followed by 'kh'."
    note "Transliteration of Cyrillic digraphs for diphthongs will follow the combination of the transliteration of\n the individual characters. Thus, 'aй' -> 'ay', 'oй' -> 'oy', and both 'эй' and 'eй' -> 'ey'."
  }
}

tests {
   "Ильяс Ахмадкӏант" ->  "Ilyas Akhmadkant"
   "Ильяс Ахмадк1ант" ->  "Ilyas Akhmadkant"
# Exhaustive per-row tests for odni-che-Cyrl-Latn-2015, generated from the source
# document's table.
# Source: ICS 630-01 Annex C (ANNEX C - Chechen_Personal_Names_FLTS
# (U).pdf), p. 2 (letter table); held source
# interscript-private-references/ics-630-01/ANNEX C -
# Chechen_Personal_Names_FLTS (U).pdf. Extraction: annex text layer, every
# value cell cross-checked against the rendered page image. Two-column table
# read in document order. The palochka cell "|, ӏ, 1" (three keys, one value
# cell) transcribed as three rows: U+04C0, U+04CF and ASCII "1". Footnote 2
# (verbatim): "This is a single apostrophe as found on regular US keyboards
# (ASCII character 39)...". Other notes (verbatim): digraph interpretation
# takes precedence over individual characters (кх -> q, not k + kh);
# diphthong digraphs combine (aй -> ay, oй -> oy, эй/eй -> ey). Skipped
# printed rows: е — printed value cell "e , ye¹"; footnote 1 (verbatim):
# "Add a preceding 'y' if the vowel is preceded by the sound of a 'y'
# consonant." — the value is position-dependent, un-expressible as a plain
# row. The map implements footnote 1 as a word-initial rule (boundary+е ->
# Ye/ye), so a plain-row test of "е" would take the word-initial path and
# fail. | ъ — printed value cell "' ²,³"; footnote 3: "A word-initial hard
# sign 'ъ' is not represented, but instead is left out of the
# transliteration." — context-dependent (word-initial dropped); the map
# encodes ъ -> ' unconditionally and does not implement footnote 3. Skipped
# rather than forced. | пӏ — printed value cell "p", but the map has no пӏ
# digraph rule: lowercase пӏ falls through to п + ӏ -> "p'" and uppercase Пӏ
# is encoded as "Ph" (a value this annex never prints). The printed row
# fails against the map as encoded — recorded as a finding, never forced
# green. | цӏ — printed key is the two-glyph sequence ц + palochka (U+0446 +
# U+04CF); the map encodes the single codepoint ҹ (U+04B9) -> ts and ҹ + ӏ
# (U+04B9 + U+04CF) -> ts, but not the printed ц + ӏ sequence (which falls
# through to "ts'"). Key-mismatch finding; row left untested. | ц — printed
# row ц -> ts FAILS end-to-end: the map encodes no plain ц rule at all (only
# the single codepoint ҹ U+04B9), so printed-key input passes through
# unchanged ("ац" -> "aц"). Finding, never forced green. | 1 (the palochka
# cell's ASCII-1 key) — printed value "' ²"; FAILS end-to-end standalone:
# the map's 1 -> ӏ normalization rules (before/after not_word conditions) do
# not fire at a string edge, so standalone "1" passes through unchanged ("1"
# -> "1"). Inside a word the chain works ("а1а" -> "a'a"); the standalone
# printed-key reading fails. Finding. | ь — the Other notes state the
# standalone soft sign is not represented; the map encodes ь -> empty, which
# the generator contract cannot express as a row (no printed value cell
# exists either). Findings (map-vs-source) resolved in the E3 corpus-fixes round (2026-11-17):
# the printed ц -> ts row is now encoded (plain U+0446 had no rule at all), the
# printed цӏ key (the two-glyph sequence U+0446+U+04CF) is now encoded alongside
# the precomposed ҹ single-codepoint rules the old map carried, and the пӏ
# digraph is completed (lowercase пӏ -> p added; uppercase Пӏ re-voiced
# "Ph" -> "P" — no printed cell supports "Ph"). Still recorded, untouched: the
# "1"-at-string-edge normalization gap (standalone "1" unchanged), footnote 3
# (word-initial ъ dropped) not implemented, footnote 1's е/ye wording difference,
# and the duplicate uppercase Ы rules (observation).
# Provenance artifact: scripts/row-sources/odni-che-Cyrl-Latn-2015.json (41 rows).
# generated-by: maps/scripts/gen-row-tests.mjs (2026-11-16); regenerate from the artifact, do not hand-edit.
  "а" -> "a"
  "б" -> "b"
  "в" -> "v"
  "г" -> "g"
  "гӏ" -> "gh"
  "д" -> "d"
  "ж" -> "j"
  "з" -> "z"
  "и" -> "i"
  "ий" -> "i"
  "й" -> "y"
  "к" -> "k"
  "кӏ" -> "k"
  "кх" -> "q"
  "къ" -> "q"
  "л" -> "l"
  "м" -> "m"
  "н" -> "n"
  "о" -> "o"
  "п" -> "p"
  "пӏ" -> "p"
  "р" -> "r"
  "с" -> "s"
  "т" -> "t"
  "тӏ" -> "t"
  "у" -> "u"
  "ф" -> "f"
  "х" -> "kh"
  "хь" -> "h"
  "хӏ" -> "h"
  "ц" -> "ts"
  "цӏ" -> "ts"
  "ч" -> "ch"
  "чӏ" -> "ch"
  "ш" -> "sh"
  "ы" -> "e"
  "э" -> "e"
  "ю" -> "yu"
  "я" -> "ya"
  "Ӏ" -> "'"
  "ӏ" -> "'"
}

stage main {
  # note[1]
  sub {
    from boundary + "\u0415"
    to "Ye"
    not_before boundary + "\u2019"
  }
  sub {
    from boundary + "\u0435"
    to "ye"
    not_before boundary + "\u2019"
  }
  # note[2]
  sub {
    from "1"
    to "ӏ"
    before not_word
    after not_word
  }
  sub {
    from "1"
    to "ӏ"
    before not_word
  }
  sub {
    from "1"
    to "ӏ"
    after not_word
  }

  parallel {
    sub "\u0410" 'A'
    sub "\u0411" 'B'
    sub "\u0412" 'V'
    sub "\u0413" 'G'
    sub "\u0413\u04C0" 'Gh'
    sub "\u0414" 'D'
    sub "\u0415" 'E'
    sub "\u0416" 'J'
    sub "\u0417" 'Z'
    sub "\u0418" 'I'
    sub "\u0418\u042B" 'I'
    sub "\u042B" 'Y'
    sub "\u041A" 'K'
    sub "\u041A\u04C0" 'K'
    sub "\u041A\u0445" 'Q'
    sub "\u041A\u044A" 'Q'
    sub "\u041B" 'L'
    sub "\u041C" 'M'
    sub "\u041D" 'N'
    sub "\u041E" 'O'
    sub "\u041F" 'P'
    sub "\u041F\u04C0" 'P'
    sub "\u0420" 'R'
    sub "\u0421" 'S'
    sub "\u0422" 'T'
    sub "\u0422\u04C0" 'T'
    sub "\u0423" 'U'
    sub "\u0424" 'F'
    sub "\u0425" 'Kh'
    sub "\u0425\u044C" 'H'
    sub "\u0425\u04C0" 'H'
    sub "\u0426" 'Ts'
    sub "\u0426\u04C0" 'Ts'
    sub "\u04B8" 'Ts'
    sub "\u04B8\u04C0" 'Ts'
    sub "\u0427" 'Ch'
    sub "\u0427\u04C0" 'Ch'
    sub "\u0428" 'Sh'
    sub "\u042A" "'"
    sub "\u042B" 'Е'
    sub "\u042D" 'E'
    sub "\u042E" 'Yu'
    sub "\u042F" 'Ya'
    sub "\u04C0" "'"
    sub "\u042C" ''

    sub "\u0430" 'a'
    sub "\u0431" 'b'
    sub "\u0432" 'v'
    sub "\u0433" 'g'
    sub "\u0433\u04CF" 'gh'
    sub "\u0434" 'd'
    sub "\u0435" 'e'
    sub "\u0436" 'j'
    sub "\u0437" 'z'
    sub "\u0438" 'i'
    sub "\u0438\u0439" 'i'
    sub "\u0439" 'y'
    sub "\u043A" 'k'
    sub "\u043A\u04CF" 'k'
    sub "\u043A\u0445" 'q'
    sub "\u043A\u044A" 'q'
    sub "\u043B" 'l'
    sub "\u043C" 'm'
    sub "\u043D" 'n'
    sub "\u043E" 'o'
    sub "\u043F" 'p'
    sub "\u043F\u04CF" 'p'
    sub "\u0440" 'r'
    sub "\u0441" 's'
    sub "\u0442" 't'
    sub "\u0442\u04CF" 't'
    sub "\u0443" 'u'
    sub "\u0444" 'f'
    sub "\u0445" 'kh'
    sub "\u0445\u044C" 'h'
    sub "\u0445\u04CF" 'h'
    sub "\u0446" 'ts'
    sub "\u0446\u04CF" 'ts'
    sub "\u04B9" 'ts'
    sub "\u04B9\u04CF" 'ts'
    sub "\u0447" 'ch'
    sub "\u0447\u04CF" 'ch'
    sub "\u0448" 'sh'
