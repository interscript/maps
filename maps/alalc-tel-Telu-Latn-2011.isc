system "ALA-LC:tel-Telu:Latn:2011" {

metadata {
  authority_id alalc
  id 2011
  language iso-639-2:tel
  source_script Telu
  destination_script Latn
  name Romanization Table -- Telugu (2011)
  url http://catdir.loc.gov/catdir/cpso/romanization/telugu.pdf
  creation_date 2011
  description {    ALA-LC Romanization table for Telugu
  }

  notes {

    note "      Only the vowel forms that appear at the beginning of a syllable are listed; the forms used for\n      vowels following a consonant can be found in grammars; no distinction between the two is\n      made in transliteration."
    note "      The vowel a is implicit after all consonants and consonant clusters and is supplied in\n      transliteration, with the following exceptions:\n      a) when another vowel is indicated by its appropriate sign; and\n      b) when the absence of any vowel is indicated by the superscript sign ( ౬ ) called valapalagilaka."
    note "      Exception: Sunna is transliterated by:\n      a) ṅ before gutturals,\n      b) ñ before palatals,\n      c) ṇ before cerebrals,\n      d) n before dentals, and\n      e) m before labials."
    note "      Ardhasunna before gutturals and palatal, cerebral, and dental occlusives is transliterated n̐.\n      Before labials, sibilants, semivowels, the aspirate, vowels, and in final position it is\n      transliterated m"
  }
}

tests {
   "తమిళనాడు" ->  "tamiḷanāḍu"
   "దేవాస్‌కు ౮౯౩౯ కోట్లివ్వండి" ->  "dēvāsaku 8939 kŏṭalivavaṃḍi"
   "యూరప్, అమెరికాకు కోవిడ్‌ దడ" ->  "yūrapa, amerikāku kŏviḍa daḍa"
   "జనవరి నాటికి అమెరికాలో టీకా" ->  "janavari nāṭiki amerikālŏ ṭīkā"
   "ఫ్రాన్స్‌ను ముస్లింలు శిక్షించవచ్చు" ->  "pharānasanu musaliṃlu śikaṣiñcavacacu"
   "క్లాస్‌ రూంలో ఉపాధ్యాయుడి వికృత చేష్టలు" ->  "kalāsa rūṃlŏ upādhayāyuḍi vikṛta cēṣaṭalu"
   "భారీ భూకంపం; భయంకరమైన అనుభవాలు" ->  "bhārī bhūkampaṃ; bhayaṅkaramaina anubhavālu"
   "నిట్ట నిలువునా కూలిన అపార్ట్‌మెంట్‌" ->  "niṭaṭa niluvunā kūlina apāraṭameṇṭa"
   "పిచ్చి ప్రయోగాలకు పోతే జరిగేది ఇదే" ->  "picaci parayŏgālaku pŏtē jarigēdi idē"
   "కరోనాపై సీడీసీ వైఫల్యం ఎందుకు?" ->  "karŏnāpai sīḍīsī vaiphalayaṃ eṃduku?"
   "అత్యంత అరుదైన పులి పిల్లలు ఇవే!" ->  "atayanta arudaina puli pilalalu ivē!"
}

dependency "alalc-tel-Telu-Latn-1997" as telulatn

stage main {

  run  map.telulatn.stage.main

}

}
