system "ALA-LC:rue-Cyrl:Latn:2013" {

metadata {
  authority_id alalc
  id 2013
  language iso-639-3:rue
  source_script Cyrl
  destination_script Latn
  name Romanization Table -- Rusyn (2013)
  url https://www.loc.gov/catdir/cpso/romanization/rusyn.pdf
  creation_date 2013
  description {
    ALA-LC romanization table for Rusyn / Carpatho-Rusyn (2013 version,
    no earlier versions). Reflects written variants of Rusyn from
    several regions. Transcribed from the digitized table (pages 1-2).
  }

  notes {
    note "Source prose: this romanization table reflects written variants of the Rusyn / Carpatho-Rusyn language from several regions. Diacritics and characters that are referenced occasionally but used inconsistently (such as Cyrillic ӱ, л̆, г̆) are not included. Use the Church Slavic ALA-LC romanization table for Church Slavic and pre-revolutionary Russian characters."
    note "Note 1: the ligature (tie, U+0361) is necessary to distinguish ж from the combination зг; hence ж = z͡h. Note 3: the ligature is necessary to distinguish х from the combination кг; hence х = k͡h. Note 4: the ligature is necessary to distinguish ц from the combination тс; hence ц = t͡s."
    note "Note 2: romanize the letter и as i for Rusyn materials published in the Serbian Vojvodina, historic Bačka, and Srem regions, with places of publication including Belgrade, Djurdjevo, Kucura, Novi Sad, Pančevo, Ruski Krstur, Sremska Mitrovica, Subotica; romanize и as y for all other Rusyn materials. This map encodes the general rule (и = y); the Vojvodinian i variant depends on publication provenance and cannot be resolved from the text alone."
    note "The iotated vowels є, ю and я are romanized Ī plus tie plus the vowel (Ī͡e, Ī͡u, Ī͡a), exactly as printed in the source."
    note "Source errata, flagged in the pull request: the table's vernacular cells for the yo row print Latin Ë (U+00CB) rather than Cyrillic Ё, so this map keys the Cyrillic inputs Ё/ё (U+0401/U+0451); the o-circumflex row prints Latin Ô (U+00D4), so this map keys Cyrillic О plus combining circumflex (U+0302); the lower-case row for ф prints romanization F, encoded as f; the hard-sign row prints two primes (ʹʹ), encoded as the double prime ʺ (U+02BA) matching the Church Slavic table; the upper-case romanization cell for Я shows only ī, encoded as Ī͡A per the lower-case cell and the pattern of the other iotated rows."
  }
}

tests {
  # every table row, upper and lower (the document has no example words
  # beyond the table itself)
   "А" ->  "A"
   "а" ->  "a"
   "Б" ->  "B"
   "б" ->  "b"
   "В" ->  "V"
   "в" ->  "v"
   "Г" ->  "H"
   "г" ->  "h"
   "Ґ" ->  "G"
   "ґ" ->  "g"
   "Д" ->  "D"
   "д" ->  "d"
   "Е" ->  "E"
   "е" ->  "e"
   "Є" ->  "Ī͡E"
   "є" ->  "ī͡e"
   "Ё" ->  "Ë"
   "ё" ->  "ë"
   "Ж" ->  "Z͡H"
   "ж" ->  "z͡h"
   "З" ->  "Z"
   "з" ->  "z"
   "І" ->  "I"
   "і" ->  "i"
   "Ї" ->  "Ï"
   "ї" ->  "ï"
   "И" ->  "Y"
   "и" ->  "y"
   "Ы" ->  "Ŷ"
   "ы" ->  "ŷ"
   "Й" ->  "Ĭ"
   "й" ->  "ĭ"
   "К" ->  "K"
   "к" ->  "k"
   "Л" ->  "L"
   "л" ->  "l"
   "М" ->  "M"
   "м" ->  "m"
   "Н" ->  "N"
   "н" ->  "n"
   "О" ->  "O"
   "о" ->  "o"
   "О̂" ->  "Ô"
   "о̂" ->  "ô"
   "П" ->  "P"
   "п" ->  "p"
   "Р" ->  "R"
   "р" ->  "r"
   "С" ->  "S"
   "с" ->  "s"
   "Т" ->  "T"
   "т" ->  "t"
   "У" ->  "U"
   "у" ->  "u"
   "Ф" ->  "F"
   "ф" ->  "f"
   "Х" ->  "K͡H"
   "х" ->  "k͡h"
   "Ц" ->  "T͡S"
   "ц" ->  "t͡s"
   "Ч" ->  "Ch"
   "ч" ->  "ch"
   "Ш" ->  "Sh"
   "ш" ->  "sh"
   "Щ" ->  "Shch"
   "щ" ->  "shch"
   "Э" ->  "Ė"
   "э" ->  "ė"
   "Ю" ->  "Ī͡U"
   "ю" ->  "ī͡u"
   "Я" ->  "Ī͡A"
   "я" ->  "ī͡a"
   "Ь" ->  "ʹ"
   "ь" ->  "ʹ"
   "Ъ" ->  "ʺ"
   "ъ" ->  "ʺ"
   "Ѣ" ->  "Î"
   "ѣ" ->  "î"
}

