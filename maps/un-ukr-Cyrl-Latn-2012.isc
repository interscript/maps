system "UN:ukr-Cyrl:Latn:2012" {

metadata {
  authority_id un
  id 2012
  language iso-639-2:ukr
  source_script Cyrl
  destination_script Latn
  name Romanization of Belarusian, Russian And Ukrainian Cyrillic (2012)
  url http://www.eki.ee/wgrs/rom1_uk.htm
  creation_date 2010
}

