system "BGN-PCGN:ady-Cyrl:Latn:2012" {

metadata {
  authority_id bgnpcgn
  id 2012
  language iso-639-2:ady
  source_script Cyrl
  destination_script Latn
  name Romanization of Adyghe (BGN/PCGN 2012 System)
  url https://geonames.nga.mil/gns/html/Romanization/ROMANIZATION%20OF%20ADYGHE.pdf
  creation_date 2012
  confirmation_date 2017-10
  description {    The BGN/PCGN system for Adyghe is designed for use in romanizing names written
    in the Adyghe Cyrillic alphabet. Adyghe, a language of the north-western Caucasian family,
    is principally spoken in Russia’s republic of Adygeya and has been written in a modified
    Cyrillic script since 1938. Also known as West Circassian, Adyghe is, as other languages of
    this family, notable for its rich density of consonant phonemes and corresponding paucity
    of vowels. Given the language’s phonological complexity, and in line with other BGN/PCGN
    Romanization Systems for north-western Caucasian languages, Adyghe letters have been
    addressed in the romanizations below as per their articulation, rather than necessarily
    reflecting their orthography or the BGN/PCGN romanization of Russian Cyrillic: specifically
    glottalised consonants have been marked with an apostrophe, labialized consonants with /w/,
    and retroflex consonants with an underbar. Adyghe contains a number of phonemes not part of
    the Kabardian alphabet, but those phonemes that are shared have been represented in
    romanization as per the BGN/PCGN Kabardian Romanization System.
  }

  notes {
    note "East Circassian, or Kabardian, though very similar, is sufficiently different to be regarded a separate language. See also the BGN/PCGN Romanization System for Kabardian."
    note "У should be romanized as /w/ or /u/ according to context: /w/ should be used word-initially, and /u/ used elsewhere."
    note "The characters Ё, Ъ, Ы & Ь (except as they occur in character combinations addressed elsewhere in the table) appear only in Russian loan words, and are thus romanized in the same style as in the BGN/PCGN Romanization System for Russian."
    note "Except as these characters occur elsewhere in the table above."
    note "An inventory of letter-diacritic combinations, with their Unicode encoding, in addition to the unmodified letters of the basic Roman script is:\n\nAll apostrophes appearing in romanization are U+2019\n\nË (U+00CB) ë (U+00EB)\nŹ (U+0179) ź (U+017A)\nZ\u035FH (U+005A+0048+035F) z\u035Fh (U+007A+0068+035F)\nH\u0331 (0048+0031) h\u0331 (0068+0031)\nČ (U+010C) č (U+010D)\nS\u035FH (U+0053+0048+035F) s\u035Fh (U+0073+0068+035F)\nŚ (U+015A) ś (U+015B)\nÄ (U+00C4) ä (U+00E4)"
    note "The Romanization columns show only lowercase forms but, when romanizing, uppercase and lowercase Roman letters as appropriate should be used."
  }
}

tests {
   "Адыгэбзэ" ->  "Adygäbzä"
   "Мыекъуапэ" ->  "Myeqw’apä"
   "кӀалэ" ->  "k’alä"
   "чӀыпӀэ" ->  "ch’yp’ä"
   "тхылъ" ->  "tkhylh"
   "щыгъу" ->  "śyghw"
   "лъы" ->  "lhy"
   "жъы" ->  "z\u035Fhy"
   "чэщ" ->  "chäś"
   "Къалэ" ->  "Q’alä"
   "хьэ" ->  "\u1E96ä"
   "унэ" ->  "wnä"
   "псы" ->  "psy"
   "джэду" ->  "jädu"
   "шъыпкъэ" ->  "s\u035Fhypq’ä"
   "цӀыф" ->  "ts’yf"
   "жьэ" ->  "źä"
   "чъыг" ->  "čyg"
   "кӀуэн" ->  "kw’än"
}

stage main {

  # RULES
  # note[1]: /w/ word-initially, /u/ elsewhere
  sub {
    from boundary + "\u0423"
    to "W"
  }
  sub {
    from boundary + "\u0443"
    to "w"
  }

  # CHARACTERS
  parallel {
    sub "А" "A"
    sub "а" "a"
    sub "Б" "B"
    sub "б" "b"
    sub "В" "V"
    sub "в" "v"
    sub "Г" "G"
    sub "г" "g"
    sub "Гу" "Gw"
    sub "гу" "gw"
    sub "Гъ" "Gh"
    sub "гъ" "gh"
    sub "Гъу" "Ghw"
    sub "гъу" "ghw"
    sub "Д" "D"
    sub "д" "d"
    sub "Дж" "J"
    sub "дж" "j"
    sub "Дз" "Dz"
    sub "дз" "dz"
    sub "Дзу" "Dzw"
    sub "дзу" "dzw"
    sub "Е" "E"
    sub "е" "e"
    sub "Ё" "Ë"
    sub "ё" "ë"
    sub "Ж" "Zh"
    sub "ж" "zh"
    sub "Жь" "Ź"
    sub "жь" "ź"
    sub "Жъ" "Z\u035FH"
    sub "жъ" "z\u035Fh"
    sub "Жъу" "Z\u035FHw"
    sub "жъу" "z\u035Fhw"
    sub "З" "Z"
    sub "з" "z"
    sub "И" "I"
    sub "и" "i"
    sub "Й" "Y"
    sub "й" "y"
    sub "К" "K"
    sub "к" "k"
    sub "Ку" "Kw"
    sub "ку" "kw"
    sub "КӀ" "K’"
    sub "кӀ" "k’"
    sub "КӀу" "Kw’"
    sub "кӀу" "kw’"
    sub "Къ" "Q’"
    sub "къ" "q’"
    sub "Къу" "Qw’"
    sub "къу" "qw’"
    sub "Л" "L"
    sub "л" "l"
    sub "ЛӀ" "L’"
    sub "лӀ" "l’"
    sub "Лъ" "Lh"
    sub "лъ" "lh"
    sub "М" "M"
    sub "м" "m"
    sub "Н" "N"
    sub "н" "n"
    sub "О" "O"
    sub "о" "o"
    sub "П" "P"
    sub "п" "p"
    sub "ПӀ" "P’"
    sub "пӀ" "p’"
    sub "ПӀу" "Pw’"
    sub "пӀу" "pw’"
    sub "Р" "R"
    sub "р" "r"
    sub "С" "S"
    sub "с" "s"
    sub "Т" "T"
    sub "т" "t"
    sub "ТӀ" "T’"
    sub "тӀ" "t’"
    sub "ТӀу" "Tw’"
    sub "тӀу" "tw’"
    sub "У" "U"
    sub "у" "u"
    sub "Ф" "F"
    sub "ф" "f"
    sub "ФӀ" "F’"
    sub "фӀ" "f’"
    sub "Х" "Kh"
    sub "х" "kh"
    sub "Ху" "Khw"
    sub "ху" "khw"
    sub "Хъ" "X"
    sub "хъ" "x"
    sub "Хъу" "Xw"
    sub "хъу" "xw"
    sub "Хь" "H\u0331"
    sub "хь" "\u1E96"
    sub "Ц" "Ts"
    sub "ц" "ts"
    sub "ЦӀ" "Ts’"
    sub "цӀ" "ts’"
    sub "Цу" "Tsw"
    sub "цу" "tsw"
    sub "Ч" "Ch"
    sub "ч" "ch"
    sub "ЧӀ" "Ch’"
    sub "чӀ" "ch’"
    sub "Чъ" "Č"
    sub "чъ" "č"
    sub "Ш" "Sh"
    sub "ш" "sh"
    sub "ШӀ" "Sh’"
    sub "шӀ" "sh’"
    sub "ШӀу" "Shw’"
    sub "шӀу" "shw’"
    sub "Шъ" "S\u035FH"
    sub "шъ" "s\u035Fh"
    sub "Шъу" "S\u035FHw"
    sub "шъу" "s\u035Fhw"
    sub "Щ" "Ś"
    sub "щ" "ś"
    sub "Ъ" "\u2019\u2019"
    sub "ъ" "\u2019\u2019"
    sub "Ы" "Y"
    sub "ы" "y"
    sub "Ь" "\u2019"
    sub "ь" "\u2019"
    sub "Э" "Ä"
    sub "э" "ä"
