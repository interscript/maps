   "Ӏ" ->  "’"
   "Ӏу" ->  "’w"
  # note 1: У word-initially w, elsewhere u
   "У" ->  "W"
   "у" ->  "w"
   "Уфа" ->  "Wfa"
   "уат" ->  "wat"
   "мау" ->  "mau"
}

stage main {

  # RULES
  # note 1: У word-initially w, elsewhere u
  sub {
    from boundary + "У"
    to "W"
  }
  sub {
    from boundary + "у"
    to "w"
  }

  # CHARACTERS
