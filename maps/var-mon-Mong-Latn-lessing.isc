system "VAR:mon-Mong:Latn:lessing" {

metadata {
  authority_id var
  id lessing
  language iso-639-2:mon
  source_script Mong
  destination_script Latn
  name Lessing transliteration system for Uyghur-Mongolian script
  url https://collab.its.virginia.edu/wiki/tibetan-script/Transliteration%20Schemes%20for%20Mongolian%20Vertical%20Script.html
  creation_date 
  description {    The only system for the Mongolian vertical script which is used commonly throughout
    Mongolian studies worldwide is the Vladimirtsov-Mostaert system (V-M). The only
    dictionary using this system is in an appendix to Antoine Mostaert’s Dictionnaire
    ordos. Thus the Harvard Journal of Asiatic Studies specifies, “please use the written
    Mongolian appendix to Antoine Mostaert’s Dictionnaire ordos. However, the V-M system
    has many difficult diacriticals and non-Latin characters that constitute a significant
    problem for editors and thus is difficult to recommend.
  }

  notes {
    note "A separated final form of vowels a or e is common, and can appear at the end\n of a word, word stem, or suffix. This form requires a final-shaped preceding\n consonant and an inter-word gap in between. The vowels themselves appear as ᠎ᠠ,\n and with consonants as ‍ᠬ᠎ᠠ q‑a, ‍ᠷ᠎ᠠ r‑a/r‑e, etc. This gap can be transliterated\n with a hyphen. In digital typesetting, these forms are triggered by inserting\n a U+180E ᠎ MONGOLIAN VOWEL SEPARATOR (HTML &#6158; · MVS) between the consonant\n and vowel."
    note "All case suffixes, as well as any plural suffixes consisting of one or two\n syllables are likewise separated by a preceding and hyphen-transliterated gap.\n In digital typesetting, this gap is represented by a U+202F   NARROW NO-BREAK SPACE\n (HTML &#8239; · NNBSP). A maximum of two case suffixes can be added to a stem.\n Single-letter vowel suffixes appear with the final-shaped forms of a/e, i, or u/ü,\n as in ᠭᠠᠵᠠᠷ ᠠ γaǰar‑a 'to the country' and ᠡᠳᠦᠷ ᠡ edür‑e 'on the day', or ᠤᠯᠤᠰ ᠢ ulus‑i\n 'the state' etc. Multi-letter suffixes most often start with an initial- (consonants),\n medial- (vowels), or variant-shaped form."
  }
}

tests {
   "ᠬᠥᠬᠡᠬᠣᠲᠠ" ->  "køkexota" # Хөх хот
   "ᠣᠷᠳᠣᠰ ᠬᠣᠲᠠ" ->  "ordos xota" # Ордос хот
   "ᠪᠠᠶᠠᠨᠨᠠᠭᠤᠷ ᠬᠣᠲᠠ" ->  "bajannaγur xota" # Баяннуур хот
   "ᠤᠯᠠᠭᠠᠨᠬᠣᠲᠠ" ->  "ulaγanxota" # Улаан хот
   "ᠬᠣᠣᠯᠢᠠ ᠭᠣᠤᠯ ᠬᠣᠲᠠ" ->  "xoolia γoul xota" # Хоолингол хот
   "ᠡᠷᠢᠶᠡᠨ ᠬᠣᠲᠠ" ->  "erijen xota" #  Эрээн хот
   "ᠷᠠᠰᠢᠶᠠᠨ ᠬᠣᠲᠠ" ->  "rasijan xota" # Рашаан хот
   "ᠪᠠᠭᠠᠷᠢᠨ ᠪᠠᠷᠠᠭᠤᠨ ᠬᠣᠰᠢᠭᠤ" ->  "baγarin baraγun xosiγu" # Баарин баруун хошуу
   "ᠪᠠᠭᠠᠷᠢᠨ ᠵᠡᠭᠦᠨ ᠬᠣᠰᠢᠭᠤ" ->  "baγarin zegyn xosiγu" # Баарин зүүн хошуу
   "ᠲᠦᠩᠯᠢᠶᠣᠤ ᠬᠣᠲᠠ" ->  "tynglijou xota" # Байшинт хот
   "ᠰᠢᠯᠢ ᠶᠢᠨ ᠬᠣᠲᠠ" ->  "sili-jin xota" # Шилийн хот
   "ᠬᠣᠷᠢᠨ ᠭᠡᠷ ᠰᠢᠶᠠᠨ" ->  "xorin ger sijan" # Horinger County
   "ᠤᠳᠠ ᠲᠣᠭᠣᠷᠢᠭ" ->  "uda toγoriγ" # Уда тойрог
   "ᠦᠬᠠᠢ ᠬᠣᠲᠠ" ->  "yxai xota" # Үхай хот
   "ᠬᠠᠶᠢᠨᠠᠨ ᠲᠣᠭᠣᠷᠢᠭ" ->  "xainan toγoriγ" # Hainan District
   "ᠬᠠᠶᠢᠷᠤᠪ ᠤᠨ ᠲᠣᠬᠣᠢ ᠲᠣᠭᠣᠷᠢᠭ" ->  "xairub-un toxoi toγoriγ" # Haibowan District
   "ᠤᠯᠠᠭᠠᠨᠴᠠᠪ ᠬᠣᠲᠠ" ->  "ulaγancab xota" # Улаанцав хот
   "ᠵᠢᠨᠢᠩ ᠲᠣᠭᠣᠷᠢᠭ" ->  "zining toγoriγ" # Жинин тойрог
   "ᠹᠸᠩᠵᠸᠡ ᠬᠣᠲᠠ" ->  "fvngzve xota" # Фенжень хот
   "ᠱᠠᠩᠳᠤ ᠰᠢᠶᠠᠨ" ->  "šangdu sijan" # Шанду шянь
   "ᠯᠢᠶᠠᠩᠴᠠᠩ ᠰᠢᠶᠠᠨ" ->  "lijangcang sijan" # Liangcheng County
   "ᠴᠠᠬᠠᠷ ᠪᠠᠷᠠᠭᠤᠨ ᠭᠠᠷᠤᠨ ᠡᠮᠦᠨᠡᠳᠦ ᠬᠣᠰᠢᠭᠤ" ->  "caxar baraγun γarun emynedy xosiγu" # Цахар баруун гарын өмнөд хошуу
   "ᠴᠠᠬᠠᠷ ᠪᠠᠷᠠᠭᠤᠨ ᠭᠠᠷᠤᠨ ᠳᠤᠮᠳᠠᠳᠤ ᠬᠣᠰᠢᠭᠤ" ->  "caxar baraγun γarun dumdadu xosiγu" # Цахар баруун гарын дундад хошуу
   "ᠴᠠᠬᠠᠷ ᠪᠠᠷᠠᠭᠤᠨ ᠭᠠᠷᠤᠨ ᠬᠣᠶᠢᠲᠤ ᠬᠣᠰᠢᠭᠤ" ->  "caxar baraγun γarun xoitu xosiγu" # Цахар баруун гарын хойд хошуу
   "ᠳᠥᠷᠪᠡᠳ ᠬᠣᠰᠢᠭᠤ" ->  "dørbed xosiγu" # Дөрвөд хошуу
   "ᠪᠤᠭᠤᠲᠤ ᠬᠣᠲᠠ" ->  "buγutu xota" # Бугaт хот
   "ᠬᠥᠨᠳᠡᠯᠡᠨ ᠲᠣᠭᠣᠷᠢᠭ" ->  "køndelen toγoriγ" # Hondlon District
   "ᠴᠢᠩᠱᠠᠨ ᠲᠣᠭᠣᠷᠢᠭ" ->  "cingšan toγoriγ" # Qingshan District
   "ᠰᠢᠭᠤᠶᠢᠲᠤ ᠲᠣᠭᠣᠷᠢᠭ" ->  "siγuitu toγoriγ" # Шигуай тойрог
   "ᠵᠢᠦ ᠶᠤᠸᠠᠨ ᠲᠣᠭᠣᠷᠢᠭ" ->  "ziy juvan toγoriγ" # Jiuyuan District
   "ᠭᠦᠶᠠᠩ ᠰᠢᠶᠠᠨ" ->  "gyjang sijan" # Guyang County
   "ᠲᠦᠮᠡᠳ ᠵᠡᠭᠦᠨ ᠬᠣᠰᠢᠭᠤ" ->  "tymed zegyn xosiγu" # Түмэд Зүүн хошуу
   "ᠲᠦᠮᠡᠳ ᠪᠠᠷᠠᠭᠤᠨ ᠬᠣᠰᠢᠭᠤ" ->  "tymed baraγun xosiγu" # Түмэд Баруун хошуу
   "ᠳᠠᠷᠬᠠᠨ ᠮᠤᠤᠮᠢᠩᠭ᠋ᠠᠨ ᠬᠣᠯᠪᠣᠭᠠᠲᠤ ᠬᠣᠰᠢᠭᠤ" ->  "darxan muumingγ᠋an xolboγatu xosiγu" # Darhan Muminggan United Banner
   "ᠬᠡᠰᠢᠭᠲᠡᠨ ᠬᠣᠰᠢᠭᠤ" ->  "kesiγten xosiγu" # Hexigten Banner
   "ᠰᠢᠨ᠎ᠡ ᠪᠠᠷᠭᠤ ᠵᠡᠭᠦᠨ ᠬᠣᠰᠢᠭᠤ" ->  "sin-e barγu zegyn xosiγu" # New Barag Left Banner
   "ᠰᠢᠨ᠎ᠡ ᠪᠠᠷᠭᠤ ᠪᠠᠷᠠᠭᠤᠨ ᠬᠣᠰᠢᠭᠤ" ->  "sin-e barγu baraγun xosiγu" # New Barag Right Banner
   "ᠣᠲᠣᠭ ᠬᠣᠰᠢᠭᠤ" ->  "otoγ xosiγu" # Otog Banner
   "ᠳᠠᠯᠠᠳ ᠬᠣᠰᠢᠭᠤ" ->  "dalad xosiγu" # Dalad Banner
   "ᠵᠡᠭᠦᠨᠭᠠᠷ ᠬᠣᠰᠢᠭᠤ" ->  "zegynγar xosiγu" # Jungar Banner
   "ᠣᠲᠣᠭ ᠤᠨ ᠡᠮᠦᠨᠡᠳᠦ ᠬᠣᠰᠢᠭᠤ" ->  "otoγ-un emynedy xosiγu" # Otog Front Banner
   "ᠬᠠᠩᠭᠢᠨ ᠬᠣᠰᠢᠭᠤ" ->  "xanggin xosiγu" # Hanggin Banner
   "ᠦᠦᠰᠢᠨ ᠬᠣᠰᠢᠭᠤ" ->  "yysin xosiγu" # Uxin Banner
   "ᠡᠵᠢᠨ ᠬᠣᠷᠣᠭ᠎ᠠ ᠬᠣᠰᠢᠭᠤ" ->  "ezin xoroγ-a xosiγu" # Эзэн Хороо хошуу
   "ᠵᠠᠯᠠᠨ ᠠᠢ᠌ᠯ ᠬᠣᠲᠠ" ->  "zalan ai᠌l xota" # Жалан-Айл хот
   "ᠶᠠᠭᠰᠢ ᠬᠣᠲᠠ" ->  "jaγsi xota" # Ягши хот
   "ᠮᠠᠨᠵᠤᠤᠷ ᠬᠣᠲᠠ" ->  "manzuur xota" # Манжуур хот
   "ᠬᠠᠶᠢᠯᠠᠷ ᠲᠣᠭᠣᠷᠢᠭ" ->  "xailar toγoriγ" # Хайлаар тойрог
   "ᠬᠣᠷᠴᠢᠨ ᠲᠣᠭᠣᠷᠢᠭ" ->  "xorcin toγoriγ" # Horqin District
   "ᠺᠠᠶᠢᠯᠦ ᠰᠢᠶᠠᠨ" ->  "kaily sijan" # Kailu County
   "ᠬᠦᠷᠢᠶ᠎ᠡ ᠬᠣᠰᠢᠭᠤ" ->  "kyrij-e xosiγu" # Hure Banner
   "ᠨᠠᠢᠮᠠᠨ ᠬᠣᠰᠢᠭᠤ" ->  "naiman xosiγu" # Naiman Banner
   "ᠵᠠᠷᠤᠳ ᠬᠣᠰᠢᠭᠤ" ->  "zarud xosiγu" # Jarud Banner
   "ᠬᠣᠷᠴᠢᠨ ᠪᠠᠷᠠᠭᠤᠨ ᠭᠠᠷᠤᠨ ᠳᠤᠮᠳᠠᠳᠤ ᠬᠣᠰᠢᠭᠤ" ->  "xorcin baraγun γarun dumdadu xosiγu" # Хорчин Баруун Гарын Дундад Хошуу
   "ᠬᠣᠷᠴᠢᠨ ᠵᠡᠭᠦᠨ ᠭᠠᠷᠤᠨ ᠳᠤᠮᠳᠠᠳᠤ ᠬᠣᠰᠢᠭᠤ" ->  "xorcin zegyn γarun dumdadu xosiγu" # Horqin Left Middle Banner
   "ᠬᠣᠷᠴᠢᠨ ᠵᠡᠭᠦᠨ ᠭᠠᠷᠤᠨ ᠬᠣᠶᠢᠲᠤ ᠬᠣᠰᠢᠭᠤ" ->  "xorcin zegyn γarun xoitu xosiγu" # Horqin Left Rear Banner
   "ᠤᠯᠠᠭᠠᠨᠬᠠᠳᠠ ᠬᠣᠲᠠ" ->  "ulaγanxada xota" # Улаанхад хот
   "ᠰᠡᠷᠡᠴᠢ" ->  "sereci" # Salaqi
   "ᠭᠡᠭᠡᠨ ᠭᠣᠤᠯ ᠬᠣᠲᠠ" ->  "gegen γoul xota" # Гэгээнгол хот
   "ᠠᠯᠠᠱᠠ ᠵᠡᠭᠦᠨ ᠬᠣᠰᠢᠭᠤ" ->  "alaša zegyn xosiγu" # Alxa Left Banner
   "ᠠᠯᠠᠱᠠ ᠪᠠᠷᠠᠭᠤᠨ ᠬᠣᠰᠢᠭᠤ" ->  "alaša baraγun xosiγu" # Alxa Right Banner # Alaša Baraγun xosiγu
   "ᠡᠵᠡᠨ᠎ᠡ ᠬᠣᠰᠢᠭᠤ" ->  "ezen-e xosiγu" # Ejin Banner
   "ᠬᠥᠪᠡᠭᠡᠲᠦ ᠰᠢᠷ᠎ᠠ ᠬᠣᠰᠢᠭᠤ" ->  "købegety sir-a xosiγu" # Хөвөөт Шар хошуу
   "ᠦᠶᠤᠸᠠᠨ ᠰᠢᠶᠠᠨ" ->  "yjuvan sijan" # Үюань шянь
   "ᠦᠴᠤᠸᠠᠨ ᠰᠢᠶᠠᠨ" ->  "ycuvan sijan" # Wuchuan County
   "ᠲᠦᠴᠢᠤᠸᠠᠨ ᠰᠢᠶᠠᠨ" ->  "tyciuvan sijan" # Тучуань шянь
   "ᠯᠢᠨᠰᠢ ᠰᠢᠶᠠᠨ" ->  "linsi sijan" # Linxi County
   "ᠬᠠᠷᠠᠴᠢᠨ ᠬᠣᠰᠢᠭᠤ" ->  "xaracin xosiγu" # Harqin Banner
   "ᠠᠤᠬᠠᠨ ᠬᠣᠰᠢᠭᠤ" ->  "auxan xosiγu" # Aohan Banner
   "ᠬᠣᠳᠣᠩ ᠠᠷᠠᠳ ᠤᠨ ᠲᠣᠭᠣᠷᠢᠭ" ->  "xodong arad-un toγoriγ" # Huimin District
   "ᠰᠠᠶᠢᠬᠠᠨ ᠲᠣᠭᠣᠷᠢᠭ" ->  "saixan toγoriγ" # Saihan District
   "ᠰᠢᠨ᠎ᠡ ᠬᠣᠲᠠ ᠲᠣᠭᠣᠷᠢᠭ" ->  "sin-e xota toγoriγ" # Xincheng District
   "ᠬᠠᠶᠢᠷᠤᠪ ᠤᠨ ᠲᠣᠬᠣᠢ ᠲᠣᠭᠣᠷᠢᠭ" ->  "xairub-un toxoi toγoriγ" # Haibowan (Hairibin Tohoi) District
   "ᠰᠦᠩ ᠱᠠᠨ ᠲᠣᠭᠣᠷᠢᠭ" ->  "syng šan toγoriγ" # Songshan District
   "ᠬᠦᠩ ᠱᠠᠨ ᠲᠣᠭᠣᠷᠢᠭ" ->  "kyng šan toγoriγ" # Hongshan District
   "ᠠᠷᠤᠨ ᠬᠣᠰᠢᠭᠤ" ->  "arun xosiγu" # Арун хошуу
   "ᠶᠤᠸᠠᠨ ᠪᠣᠣ ᠱᠠᠨ ᠲᠣᠭᠣᠷᠢᠭ" ->  "juvan boo šan toγoriγ" # Юаньбаошань тойрог
   "ᠰᠢᠯᠤᠭᠤᠨ ᠬᠥᠪᠡᠭᠡᠲᠦ ᠴᠠᠭᠠᠨ ᠬᠣᠰᠢᠭᠤ" ->  "siluγun købegety caγan xosiγu" # Шулуун Хөвөөт Цагаан хошуу
   "ᠰᠢᠯᠤᠭᠤᠨ ᠬᠥᠬᠡ ᠬᠣᠰᠢᠭᠤ" ->  "siluγun køke xosiγu" # Шулуун хөх хошуу
   "ᠤᠷᠠᠳ ᠤᠨ ᠳᠤᠮᠳᠠᠳᠤ ᠬᠣᠰᠢᠭᠤ" ->  "urad-un dumdadu xosiγu" # Урадын Дундад Хошуу
   "ᠤᠷᠠᠳ ᠤᠨ ᠡᠮᠦᠨᠡᠳᠦ ᠬᠣᠰᠢᠭᠤ" ->  "urad-un emynedy xosiγu" # Урадын Өмнөд Хошуу
   "ᠲᠣᠭᠲᠠᠬᠤ ᠰᠢᠶᠠᠨ" ->  "toγtaxu sijan" # Тогтох шянь
   "ᠰᠥᠨᠡᠳ ᠵᠡᠭᠦᠨ ᠬᠣᠰᠢᠭᠤ" ->  "søned zegyn xosiγu" # Sonid Left Banner
   "ᠰᠥᠨᠡᠳ ᠪᠠᠷᠠᠭᠤᠨ ᠬᠣᠰᠢᠭᠤ" ->  "søned baraγun xosiγu" # Sonid Right Banner
   "ᠣᠩᠨᠢᠭᠤᠳ ᠬᠣᠰᠢᠭᠤ" ->  "ongniγud xosiγu" # Ongniud Banner
   "ᠵᠠᠯᠠᠢᠳ ᠬᠣᠰᠢᠭᠤ" ->  "zalaid xosiγu" # Jalaid Banner
   "ᠬᠠᠩᠭᠢᠨ ᠬᠣᠶᠢᠲᠤ ᠬᠣᠰᠢᠭᠤ" ->  "xanggin xoitu xosiγu" # Hanggin Rear Banner
   "ᠵᠡᠭᠦᠨ ᠤᠵᠤᠮᠤᠴᠢᠨ ᠬᠣᠰᠢᠭᠤ" ->  "zegyn uzumucin xosiγu" # East Ujimqin Banner
   "ᠠᠷᠤ ᠬᠣᠷᠴᠢᠨ ᠬᠣᠰᠢᠭᠤ" ->  "aru xorcin xosiγu" # Ar Horqin Banner
   "ᠠᠪᠠᠭ᠎ᠠ ᠬᠣᠰᠢᠭᠤ" ->  "abaγ-a xosiγu" # Abag Banner
   "ᠪᠤᠷᠢᠶᠠᠳ" ->  "burijad" # Буриад
   "ᠤᠯᠠᠭᠠᠨᠪᠠᠭᠠᠲᠤᠷ" ->  "ulaγanbaγatur" # Улаанбаатар
   "ᠴᠢᠩᠭᠢᠰ ᠬᠠᠭᠠᠨ" ->  "cinggis xaγan" # Чингис Хаан
}

stage main {

  # RULES
  sub {
    from "\u182c"
    to "k"
    after any("\u1821\u1822\u1825\u1826")
  }
  sub {
    from "\u182d"
    to "g"
    after any("\u1821\u1822\u1825\u1826")
  }
  sub "\u1820\u1836\u1822" "ai"
  sub "\u1821\u1836\u1822" "ei"
  sub "\u1823\u1836\u1822" "oi"
  sub "\u1824\u1836\u1822" "ui"


  # CHARACTERS
  parallel {
    sub "ᠠ" "a"
    sub "ᠡ" "e"
    sub "ᠢ" "i"
    sub "ᠣ" "o"
    sub "ᠤ" "u"
    sub "ᠥ" "ø"
    sub "ᠦ" "y"
    sub "ᠨ" "n"
    sub "ᠩ" "ng"
    sub "ᠬ" "x"
    sub "ᠭ" "γ"
    sub "ᠪ" "b"
    sub "ᠫ" "p"
    sub "ᠹ" "f"
    sub "ᠰ" "s"
    sub "ᠱ" "š"
    sub "ᠲ" "t"
    sub "ᠳ" "d"
    sub "ᠯ" "l"
    sub "ᠮ" "m"
    sub "ᠴ" "c"
    sub "ᠵ" "z"
    sub "ᠶ" "j"
    sub "ᠺ" "k"
    sub "ᠷ" "r"
    sub "ᠸ" "v"
    sub "ᠾ" "h"
    sub "᠁" '...'
    sub "᠂" ","
    sub "᠃" '.'
    sub "᠄" ":"
    sub "᠎" "-"
    sub " " "-"
  }

}
}
