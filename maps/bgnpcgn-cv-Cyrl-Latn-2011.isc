system "BGN-PCGN:cv-Cyrl:Latn:2011" {

metadata {
  authority_id bgnpcgn
  id 2011
  language iso-639-2:chv
  source_script Cyrl
  destination_script Latn
  name Romanization of Chuvash (BGN/PCGN 2011 System)
  url https://geonames.nga.mil/gns/html/Romanization/ROMANIZATION%20OF%20CHUVASH.pdf
  creation_date 2011
  confirmation_date 2017-10
  description {    The BGN/PCGN system for Chuvash is designed for use in romanizing names written
    in the Chuvash Cyrillic alphabet. Chuvash is an official language within Chuvashiya, one of
    the republics of the Russian Federation.
  }

  notes {
    note "The character e should be romanized ye initially, after the vowel characters a, e, ё, и, о, у, ы, э, ю, and я, and after й, ъ, and ь. In all other instances, it should be romanized e."
    note "The character ё should be romanized yë initially, after the vowel characters a, e, ё, и, о, у, ы, э, ю, and я, and after й, ъ, and ь. In all other instances, it should be romanized ё. Often the dieresis is not shown in Cyrillic, and in this case, the character should be romanized as ‘ë’/‘yë’, as outlined above, if known to be relevant, or otherwise ‘e’/‘ye’ as described in note 1."
    note "An inventory of letter-diacritic combinations, with their Unicode encoding, in addition to the unmodified letters of the basic Roman script is:\n\nĂ (U+0102) ă (U+0103)\nË (U+00CB) ë (U+00EB)\nĔ (U+0114) ĕ (U+0115)\nŚ (U+015A) ś (U+015B)\nÜ (U+00DC) ü (U+00FC)\nĖ (U+0116) ė (U+0117)"
    note "The Romanization columns show only lowercase forms but, when romanizing, uppercase and lowercase Roman letters as appropriate should be used."
    note "The source table renders the Cyrillic letter ҫ (U+04AA, U+04AB) with the glyphs of Latin ç (U+00C7, U+00E7); this implementation maps from the Cyrillic codepoints."
  }
}

tests {
   "Чӑвашла" ->  "Chăvashla"
   "Шупашкар" ->  "Shupashkar"
   "Ҫӗнӗ Шупашкар" ->  "Śĕnĕ Shupashkar"
   "ҫын" ->  "śyn"
   "ӗмӗр" ->  "ĕmĕr"
   "шыв" ->  "shyv"
   "хӗвел" ->  "khĕvel"
   "ҫул" ->  "śul"
   "сӑмах" ->  "sămakh"
   "ӳсентӑран" ->  "üsentăran"
   "кӳлĕ" ->  "külĕ"
   "иҫҫе" ->  "iśśe"
   "пулес" ->  "pules"
   "Етӗрне" ->  "Yetĕrne"
   "проект" ->  "proyekt"
   "Ӗпхӳ" ->  "Ĕpkhü"
   "йывӑҫ" ->  "yyvăś"
   "Вырӑс" ->  "Vyrăs"
   "музей" ->  "muzey"
   "театр" ->  "teatr"
}

aliases {
  cv_extvowel = any("АаЕеЁёИиОоУуЫыЭэЮюЯяЙйЪъЬь")
}

stage main {

  # RULES
  # note[1]: ye initially, after the vowel characters and after й, ъ, and ь
  sub {
    from "\u0415"
    to "YЕ"
    before cv_extvowel
  }
  sub {
    from "\u0415"
    to "Yе"
    before boundary
  }
  sub {
    from "\u0435"
    to "yе"
    before cv_extvowel
  }
  sub {
    from "\u0435"
    to "yе"
    before boundary
  }

  # note[2]: yë initially, after the vowel characters and after й, ъ, and ь
  sub {
    from "\u0401"
    to "Yë"
    before cv_extvowel
  }
  sub {
    from "\u0401"
    to "Yë"
    before boundary
  }
  sub {
    from "\u0451"
    to "yë"
    before cv_extvowel
  }
  sub {
    from "\u0451"
    to "yë"
    before boundary
  }

  # CHARACTERS
  parallel {
    sub "А" "A"
    sub "а" "a"
    sub "Ӑ" "Ă"
    sub "ӑ" "ă"
    sub "Б" "B"
    sub "б" "b"
    sub "В" "V"
    sub "в" "v"
    sub "Г" "G"
    sub "г" "g"
    sub "Д" "D"
    sub "д" "d"
    sub "Е" "E"
    sub "е" "e"
    sub "Ё" "Ë"
    sub "ё" "ë"
    sub "Ӗ" "Ĕ"
    sub "ӗ" "ĕ"
    sub "Ж" "Zh"
    sub "ж" "zh"
    sub "З" "Z"
    sub "з" "z"
    sub "И" "I"
    sub "и" "i"
    sub "Й" "Y"
    sub "й" "y"
    sub "К" "K"
    sub "к" "k"
    sub "Л" "L"
    sub "л" "l"
    sub "М" "M"
    sub "м" "m"
    sub "Н" "N"
    sub "н" "n"
    sub "О" "O"
    sub "о" "o"
    sub "П" "P"
    sub "п" "p"
    sub "Р" "R"
    sub "р" "r"
    sub "С" "S"
    sub "с" "s"
    sub "Ҫ" "Ś"
    sub "ҫ" "ś"
    sub "Т" "T"
    sub "т" "t"
    sub "У" "U"
    sub "у" "u"
    sub "Ӳ" "Ü"
    sub "ӳ" "ü"
    sub "Ф" "F"
    sub "ф" "f"
    sub "Х" "Kh"
    sub "х" "kh"
    sub "Ц" "Ts"
    sub "ц" "ts"
    sub "Ч" "Ch"
    sub "ч" "ch"
    sub "Ш" "Sh"
    sub "ш" "sh"
    sub "Щ" "Shch"
    sub "щ" "shch"
    sub "Ъ" "\u201D"
    sub "ъ" "\u201D"
    sub "Ы" "Y"
    sub "ы" "y"
    sub "Ь" "\u2019"
    sub "ь" "\u2019"
    sub "Э" "Ė"
    sub "э" "ė"
    sub "Ю" "Yu"
    sub "ю" "yu"
    sub "Я" "Ya"
    sub "я" "ya"
  }
}
}
