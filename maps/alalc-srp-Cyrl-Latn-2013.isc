system "ALA-LC:srp-Cyrl:Latn:2013" {

metadata {
  authority_id alalc
  id 2013
  language iso-639-2:srp
  source_script Cyrl
  destination_script Latn
  name Romanization Table -- Serbian (2013)
  url https://www.loc.gov/catdir/cpso/romanization/serbian.pdf
  creation_date 2013
  description {    Serbian uses the Cyrillic and Roman alphabets. When the Roman alphabet is used it is the same as Croatian.
  }
}

tests {
   "Шупља Стена" ->  "Šuplja Stena"
   "Чукарица" ->  "Čukarica"
   "Црна Трава" ->  "Crna Trava"
   "Херцег Нови" ->  "Herceg Novi"
   "Улцињ" ->  "Ulcinj"
   "Ужице" ->  "Užice"
   "Тресаначка Река" ->  "Tresanačka Reka"
   "Сјеница" ->  "Sjenica"
   "Рожаје" ->  "Rožaje"
   "Пљевља" ->  "Pljevlja"
   "Оџаци" ->  "Odžaci"
   "Никшић" ->  "Nikšić"
   "Медвеђа" ->  "Medveđa"
   "Лозница" ->  "Loznica"
   "Књажевац" ->  "Knjaževac"
   "Зрењанин" ->  "Zrenjanin"
   "Житорађа" ->  "Žitorađa"
   "Ервеник" ->  "Ervenik"
   "Доње Љупче" ->  "Donje Ljupče"
   "Гусиње" ->  "Gusinje"
   "ГУСИЊЕ" ->  "GUSINJE"
   "Врњачка Бања" ->  "Vrnjačka Banja"
   "Бијело Поље" ->  "Bijelo Polje"
   "Алибунар" ->  "Alibunar"
}

aliases {
  srp_multichar = any(["Lj", "Nj", "Dž"])
  srp_latupper = any("A".."Z")
}

stage main {
  # CHARACTERS
  parallel {
    sub "А" "A"
    sub "Б" "B"
    sub "В" "V"
    sub "Г" "G"
    sub "Д" "D"
    sub "Ђ" "Đ"
    sub "Е" "E"
    sub "Ж" "Ž"
    sub "З" "Z"
    sub "И" "I"
    sub "Ј" "J"
    sub "К" "K"
    sub "Л" "L"
    sub "Љ" "Lj"
    sub "М" "M"
    sub "Н" "N"
    sub "Њ" "Nj"
    sub "О" "O"
    sub "П" "P"
    sub "Р" "R"
    sub "С" "S"
    sub "Т" "T"
    sub "Ћ" "Ć"
    sub "У" "U"
    sub "Ф" "F"
    sub "Х" "H"
    sub "Ц" "C"
    sub "Ч" "Č"
    sub "Џ" "Dž"
    sub "Ш" "Š"
    sub "а" "a"
    sub "б" "b"
    sub "в" "v"
    sub "г" "g"
    sub "д" "d"
    sub "ђ" "đ"
    sub "е" "e"
    sub "ж" "ž"
    sub "з" "z"
    sub "и" "i"
    sub "ј" "j"
    sub "к" "k"
    sub "л" "l"
    sub "љ" "lj"
    sub "м" "m"
    sub "н" "n"
    sub "њ" "nj"
    sub "о" "o"
    sub "п" "p"
    sub "р" "r"
    sub "с" "s"
    sub "т" "t"
    sub "ћ" "ć"
    sub "у" "u"
    sub "ф" "f"
    sub "х" "h"
    sub "ц" "c"
    sub "ч" "č"
    sub "џ" "dž"
    sub "ш" "š"
  }

  # POSTRULES
  sub {
    from srp_multichar
    to upcase
    before srp_latupper
  }
  sub {
    from srp_multichar
    to upcase
    after srp_latupper
  }
  compose
}
}
