   "Давст" ->  "Davst"
   "Говьсүмбэр Сум" ->  "Govisümbêr Sum"
   "Говь" ->  "Govi"
   "Буга" ->  "Buga"
   "Бор-Өндөр Сум" ->  "Bor-Öndör Sum"
   "Бор-Өндөр" ->  "Bor-Öndör"
   "Баянхонгор" ->  "Baiankhongor"
   "Баянтал" ->  "Baiantal"
   "Баяндэлгэр Сум" ->  "Baiandêlgêr Sum"
   "Баяндэлгэр" ->  "Baiandêlgêr"
   "Баян-Өндөр Сум" ->  "Baian-Öndör Sum"
   "Баруун-Урт Сум" ->  "Baruun-Urt Sum"
   "Баруун-Урт" ->  "Baruun-Urt"
   "Архуст" ->  "Arkhust"
   "Арвайхээр Сум" ->  "Arvaĭkhêêr Sum"
   "Арвайхээр" ->  "Arvaĭkhêêr"
   "Есөнбулаг Сум" ->  "Esönbulag Sum"
   "Ерөө Сум" ->  "Eröö Sum"
   "Есөнзүйл Сум" ->  "Esönzüĭl Sum"
   "Ноён Сум" ->  "Noën Sum"
   "Родник Балянгийн-Булак" ->  "Rodnik Baliangiĭn-Bulak"
   "Замын-Үүд Сум" ->  "Zamyn-Üüd Sum"
