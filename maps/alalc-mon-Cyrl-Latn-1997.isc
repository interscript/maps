   "Чандмань Сум" ->  "Chandmani Sum"
   "Хяргас Сум" ->  "Khiargas Sum"
   "Еэвэн, ерөөл" ->  "Eêvên, erööl"
   "Ёроол, оёдол" ->  "Ërool, oëdol"
   "Пуужин, апарат" ->  "Puuzhin, aparat"
   "Фото, фонд" ->  "Foto, fond"
   "Щедрин, щорс" ->  "Shchedrin, shchors"
   "Оръё, суръя, гаръя" ->  "Or“ë, sur“ia, gar“ia"
   "Юм, юүдэн" ->  "Ium, iuüdên"
   "Ямар, ядуу, ая" ->  "Iamar, iaduu, aia"
}


