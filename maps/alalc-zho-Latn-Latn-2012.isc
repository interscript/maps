system "ALA-LC:zho-Latn:Latn:2012" {

metadata {
  authority_id alalc
  id 2012
  language iso-639-2:zho
  source_script Latn
  destination_script Latn
  name "Correspondence of Wade-Giles to Pinyin (2012)"
  url https://www.loc.gov/catdir/cpso/romanization/chinese.pdf
  creation_date 2012
  adoption_date
  description {    The Correspondence of Wade-Giles to Pinyin table from
    the ALA-LC Chinese Romanization Table, 2012 version (pages 9-21).
    The document presents the table "as a device to show the usual
    relationship between Wade-Giles and Pinyin romanizations", drawing
    the Wade-Giles syllabic readings from Di ming Han zi yi yin biao
    地名漢字譯音表 (1971) and the ALA-LC romanization tables (1997),
    and the Pinyin equivalents from Xian dai Han yu ci dian 现代汉语词典
    (1983). The list is printed as not exhaustive; every printed row is
    transcribed here in order. Transcribed from the loc.gov document's
    complete text layer. }

  notes {
    note "Scope: this is a cross-romanization correspondence device for
    syllables 'likely to be found in older cataloging records', not a
    general Wade-Giles grammar; the document prints the Pinyin side as
    likewise 'not limited to those contained in this list'. Each row is
    encoded exactly as printed, including identity rows (a a, fa fa)
    and the rows where both systems coincide in spelling."
    note "As printed, the Wade-Giles aspiration mark is the left single
    quotation mark (U+2018, e.g. ch‘a). For convenience of input the
    map also accepts U+2019 and U+0027 as the same aspiration mark;
    these are encoding folds of the same printed glyph, not additional
    transcriptions. The umlaut rows (chü, hsü, lü, nü, yü series) are
    encoded with U+00FC exactly as printed."
    note "Printed quirks preserved without correction: both ssu and szu
    correspond to si; erh corresponds to er; o corresponds to e; the
    unusual Wade-Giles forms no (nuo), so (suo) and yai (yai) appear as
    printed. The companion map alalc-zho-Hani-Latn-2012 encodes the
    character-level romanization rules of the same document."
    note "The table has no tone information: the 2012 rules of
    application do not indicate tone marks (Rules of Application 1)."
  }
}

tests {
  # Document examples of the correspondence device (rows of the table).
   "chih" ->  "zhi"
   "ch‘ih" ->  "chi"
   "ssu" ->  "si"
   "szu" ->  "si"
   "tzu" ->  "zi"
   "tz‘u" ->  "ci"
   "erh" ->  "er"
   "o" ->  "e"
   "kung" ->  "gong"
   "k‘ung" ->  "kong"
   "chung" ->  "zhong"
   "ch‘ung" ->  "chong"
   "ju" ->  "ru"
   "chü" ->  "ju"
   "ch‘ü" ->  "qu"
   "hsü" ->  "xu"
   "lü" ->  "lü"
   "nü" ->  "nü"
   "lüeh" ->  "lüe"
   "nüeh" ->  "nüe"
   "yü" ->  "yu"
   "yüeh" ->  "yue"
   "no" ->  "nuo"
   "so" ->  "suo"
   "yai" ->  "yai"
   "chi" ->  "ji"
   "ch‘i" ->  "qi"
   "hsiao" ->  "xiao"
   "chien" ->  "jian"
   "ch‘ien" ->  "qian"
   "cha" ->  "zha"
   "ch‘a" ->  "cha"
   "ts‘ang" ->  "cang"
   "tsang" ->  "zang"
  # Aspiration-mark input folds (U+2019 and U+0027 stand for the
  # printed U+2018).
   "ch'a" ->  "cha"
   "ch’a" ->  "cha"
   "k'ung" ->  "kong"
   "tz'u" ->  "ci"
}

stage main {
  # Aspiration-mark input folds run as their own pass before the table:
  # the printed form is U+2018; U+2019 and U+0027 stand for the same
  # printed glyph (see notes).
  parallel {
    sub "’" "‘"
    sub "'" "‘"
  }

