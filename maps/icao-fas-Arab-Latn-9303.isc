system "ICAO:fas-Arab:Latn:9303" {

metadata {
  authority_id icao
  id 9303
  language iso-639-2:fas
  source_script Arab
  destination_script Latn
  name ICAO Doc 9303 Machine Readable Travel Documents Part 3 -- Persian Arabic to Latin
  url https://www.icao.int/publications/pages/publication.aspx?docnum=9303
  creation_date 2015
  description {    Part 3 defines specifications that are common to TD1, TD2 and TD3
    size machine readable travel documents (MRTDs) including those
    necessary for global interoperability using visual inspection and
    machine readable (optical character recognition) means.

    Since only Latin-alphabet characters are allowed in the VIZ, if
    mandatory data elements are in a national language that does not use
    the Latin alphabet, a transcription or transliteration shall also be
    provided.

    This document defines the transliteration mappings used to produce
    this transcription or transliteration.
  }

  notes {
    note "Diffed against ICAO Doc 9303 Part 3 Amd 1 (16/09/16), Section 6.C (Transliteration of Arabic Script)."
    note "Divergence corrected against the source: teh marbuta was rendered P, which is the value of peh; the source's row 0629 renders teh marbuta XTA. The other divergences corrected: the vowel-sign rows fathatan, dammatan, kasratan, fatha, damma, kasra and sukun were rendered F, N, K, A, U, I and O, but the source marks all of them (and tatwheel and superscript alef) as Not encoded; they now drop from the output instead of injecting Latin letters."
    note "NOT ENCODED -- teh marbuta word-final variant. Source footnote 1: XTA is used generally except if teh marbuta occurs at the end of the name component, in which case XAH is used. This positional rule needs an after-boundary constraint, which the current Ruby ISC runtime drops (Interscript::Isc::NodeAdapter reads constraint :value while the DocumentBuilder emits :item), so it would silently never fire; once fixed, encode it as sub { from \"ة\" to \"XAH\" after boundary } before the parallel block."
    note "NOT ENCODED -- shadda (U+0651). Source footnote 2: shadda denotes doubling, the Latin character or sequence is repeated (e.g. abbas with shadda becomes EBBAS). Doubling the previous output is not expressible as a parallel substitution, so shadda is left unmapped rather than guessed."
    note "The four further Not encoded rows of the source table (069C, 06A2, 06A7, 06A8) are likewise left unmapped."
  }
}

tests {
   "ة" ->  "XTA"
   "پ" ->  "P"
   "چ" ->  "XC"
   "ژ" ->  "XJ"
   "گ" ->  "XGG"
   "ک" ->  "XKK"
   "ی" ->  "XYA"
   "َ" ->  ""
   "ْ" ->  ""
   "ـ" ->  ""
   "پاکستان" ->  "PAXKKSTAN"
}

# https://www.icao.int/publications/Documents/9303_p3_cons_en.pdf
stage main {

  # CHARACTERS
  parallel {

    sub "'" ""
    sub "ء" "XE"
    sub "آ" "XAA"
    sub "أ" "XAE"
    sub "ؤ" "U"
    sub "إ" "I"
    sub "ئ" "XI"
    sub "ا" "A"
    sub "ب" "B"
    sub "ة" "XTA"
    sub "ت" "T"
    sub "ث" "XTH"
    sub "ج" "J"
    sub "ح" "XH"
    sub "خ" "XKH"
    sub "د" "D"
    sub "ذ" "XDH"
    sub "ر" "R"
    sub "ز" "Z"
    sub "س" "S"
    sub "ش" "XSH"
    sub "ص" "XSS"
    sub "ض" "XDZ"
    sub "ط" "XTT"
    sub "ظ" "XZZ"
    sub "ع" "E"
    sub "غ" "G"
    sub "ـ" ""
    sub "ف" "F"
    sub "ق" "Q"
    sub "ك" "K"
    sub "ل" "L"
    sub "م" "M"
    sub "ن" "N"
    sub "ه" "H"
    sub "و" "W"
    sub "ى" "XAY"
    sub "ي" "Y"
    sub "ً" ""
    sub "ٌ" ""
    sub "ٍ" ""
    sub "َ" ""
    sub "ُ" ""
    sub "ِ" ""
    sub "ْ" ""
    sub "ٰ" ""
    sub "ٱ" "XXA"
    sub "ٹ" "XXT"
    sub "ټ" "XRT"
    sub "پ" "P"
    sub "ځ" "XKE"
    sub "څ" "XXH"
    sub "چ" "XC"
    sub "ڈ" "XXD"
    sub "ډ" "XDR"
    sub "ڑ" "XXR"
    sub "ړ" "XRR"
    sub "ږ" "XRX"
    sub "ژ" "XJ"
    sub "ښ" "XXS"
    sub "ک" "XKK"
    sub "ګ" "XXK"
    sub "ڭ" "XNG"
    sub "گ" "XGG"
    sub "ں" "XNN"
    sub "ڼ" "XXN"
    sub "ھ" "XDO"
    sub "ۀ" "XYH"
    sub "ہ" "XXG"
    sub "ۂ" "XGE"
    sub "ۃ" "XTG"
    sub "ی" "XYA"
    sub "ۍ" "XXY"
    sub "ې" "Y"
    sub "ے" "XYB"
    sub "ۓ" "XBE"
  }

}

}
