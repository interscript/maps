    sub "Н" "N"
    sub "О" "O"
    sub "П" "P"
    sub "Р" "R"
    sub "С" "S"
    sub "Т" "T"
    sub "У" "U"
    sub "Ф" "F"
    sub "Х" "X"
    sub "Ц" "Ts"
    sub "Ч" "Ch"
    sub "Ш" "Sh"
    sub "Э" "E"

    sub "хӀ" "ẖ"
    sub "гъ" "gh"
    sub "къ" "q’"
    sub "кь" "tl’"
    sub "кӀ" "k’"
    sub "лъ" "lh"
    sub "лӀ" "tl"
    sub "тӀ" "t’"
    sub "хъ" "q"
    sub "хь" "kh"
    sub "цӀ" "ts’"
    sub "чӀ" "ch’"
    sub "гь" "h"
    sub "гӀ" "ġ"
    sub "дж" "j"
    sub "дз" "dz"
    sub "щ" "shsh"
    sub "ъ" "’’"
