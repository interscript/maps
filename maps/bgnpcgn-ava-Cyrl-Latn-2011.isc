    sub "ЦӀ" "Ts’"
    sub "ЧӀ" "Ch’"
    sub "Гь" "H"
    sub "ГӀ" "Ġ"
    sub "Дж" "J"
    sub "Дз" "Dz"
    sub "Щ" "Shsh"
    sub "Ъ" "’’"
    sub "Ы" "Y"
    sub "Ь" "’"
    sub "Ю" "Yu"
    sub "Я" "Ya"
    sub "А" "A"
    sub "Б" "B"
    sub "В" "W"
    sub "Г" "G"
    sub "Д" "D"
    sub "Е" "E"
    sub "Ё" "Ë"
    sub "Ж" "Zh"
