system "BGN-PCGN:ava-Cyrl:Latn:2011" {

metadata {
  authority_id bgnpcgn
  id 2011
  language iso-639-2:ava
  source_script Cyrl
  destination_script Latn
  name Romanization of Avar (2011)
  url https://www.gov.uk/government/organisations/permanent-committee-on-geographical-names
  creation_date 2011
  confirmation_date 2017-10
  description {
    The BGN/PCGN system for Avar is designed for use in romanizing names written in the
    Avar Cyrillic alphabet. Avar is a consonant-rich north-eastern Caucasian language,
    spoken principally in Russia's republic of Dagestan. It has been written in a modified
    Cyrillic script since 1938 and, as other Caucasian languages, features glottalised
    consonants; an apostrophe denotes the glottalised form of consonants in this
    romanization table.
  }

  notes {
    note "Е should be romanized ye word-initially, and after a vowel, and e elsewhere."
    note "In order to retain reversibility, where two consonant characters appear together and the resulting romanization is equivalent to a Roman-script digraph occurring in the system (i.e. gh, zh, tl, sh or ts), a medial dot may be employed between the Roman-script consonants (e.g. g·h) in order to distinguish these from the Roman-script digraphs."
    note "Ё, Ф, Ъ, Ы and Ь occur only in loanwords, except as they appear in character combinations addressed elsewhere in the table, and are represented in the same style as in the BGN/PCGN Romanization System for Russian."
    note "The letter ХӀ is romanized h with the combining macron below (h + U+0331); the letter ГӀ is romanized Ġ (U+0120) / ġ (U+0121)."
    note "An inventory of letter-diacritic combinations, with their Unicode encoding, in addition to the unmodified letters of the basic Roman script is:"
    note "All apostrophes appearing in romanization are U+2019"
    note "Ġ (U+0047+0307)  ġ (U+0067+0307)  Ë (U+00CB)  ë (U+00EB)"
    note "The Romanization columns show only lowercase forms but, when romanizing, uppercase and lowercase Roman letters as appropriate should be used."
  }
}

tests {
  # every table row, upper and lower
   "А" ->  "A"
   "а" ->  "a"
   "Б" ->  "B"
   "б" ->  "b"
   "В" ->  "W"
   "в" ->  "w"
   "Г" ->  "G"
   "г" ->  "g"
   "Гъ" ->  "Gh"
   "гъ" ->  "gh"
   "Гь" ->  "H"
   "гь" ->  "h"
   "ГӀ" ->  "Ġ"
   "гӀ" ->  "ġ"
   "Д" ->  "D"
   "д" ->  "d"
   "Е" ->  "Ye"
   "е" ->  "ye"
   "Ё" ->  "Ë"
   "ё" ->  "ë"
   "Ж" ->  "Zh"
   "ж" ->  "zh"
   "З" ->  "Z"
   "з" ->  "z"
   "И" ->  "I"
   "и" ->  "i"
   "Й" ->  "Y"
   "й" ->  "y"
   "К" ->  "K"
   "к" ->  "k"
   "Къ" ->  "Q’"
   "къ" ->  "q’"
   "Кь" ->  "Tl’"
   "кь" ->  "tl’"
   "КӀ" ->  "K’"
   "кӀ" ->  "k’"
   "Л" ->  "L"
   "л" ->  "l"
   "Лъ" ->  "Lh"
   "лъ" ->  "lh"
   "ЛӀ" ->  "Tl"
   "лӀ" ->  "tl"
   "М" ->  "M"
   "м" ->  "m"
   "Н" ->  "N"
   "н" ->  "n"
   "О" ->  "O"
   "о" ->  "o"
   "П" ->  "P"
   "п" ->  "p"
   "Р" ->  "R"
   "р" ->  "r"
   "С" ->  "S"
   "с" ->  "s"
   "Т" ->  "T"
   "т" ->  "t"
   "ТӀ" ->  "T’"
   "тӀ" ->  "t’"
   "У" ->  "U"
   "у" ->  "u"
   "Ф" ->  "F"
   "ф" ->  "f"
   "Х" ->  "X"
   "х" ->  "x"
   "Хъ" ->  "Q"
   "хъ" ->  "q"
   "Хь" ->  "Kh"
   "хь" ->  "kh"
   "ХӀ" ->  "H̱"
   "хӀ" ->  "ẖ"
   "Ц" ->  "Ts"
   "ц" ->  "ts"
   "ЦӀ" ->  "Ts’"
   "цӀ" ->  "ts’"
   "Ч" ->  "Ch"
   "ч" ->  "ch"
   "ЧӀ" ->  "Ch’"
   "чӀ" ->  "ch’"
   "Ш" ->  "Sh"
   "ш" ->  "sh"
   "Щ" ->  "Shsh"
   "щ" ->  "shsh"
   "Ъ" ->  "’’"
   "ъ" ->  "’’"
   "Ы" ->  "Y"
   "ы" ->  "y"
   "Ь" ->  "’"
   "ь" ->  "’"
   "Э" ->  "E"
   "э" ->  "e"
   "Ю" ->  "Yu"
   "ю" ->  "yu"
   "Я" ->  "Ya"
   "я" ->  "ya"
  # note 1: Е word-initially and after a vowel ye, elsewhere e
   "бе" ->  "be"
   "ае" ->  "aye"
   "ъе" ->  "’’e"
}

stage main {

  # RULES
  # note 1: Е word-initially and after a vowel ye, elsewhere e
  sub {
    from boundary + "Е"
    to "Ye"
  }
  sub {
    from boundary + "е"
    to "ye"
  }
  sub {
    from "Е"
    to "Ye"
    before any("АаЕеЁёИиОоУуЫыЭэЮюЯя")
  }
  sub {
    from "е"
    to "ye"
    before any("АаЕеЁёИиОоУуЫыЭэЮюЯя")
  }

  # CHARACTERS
  parallel {
    sub "ХӀ" "H̱"
    sub "Гъ" "Gh"
    sub "Къ" "Q’"
    sub "Кь" "Tl’"
    sub "КӀ" "K’"
    sub "Лъ" "Lh"
    sub "ЛӀ" "Tl"
    sub "ТӀ" "T’"
