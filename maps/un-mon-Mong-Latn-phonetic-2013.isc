   "ᠬᠠᠩᠭᠢᠨ ᠬᠣᠶᠢᠲᠤ ᠬᠣᠰᠢᠭᠤ" ->  "hanggin hôyitû hôsigû" # Hanggin Rear Banner
   "ᠵᠡᠭᠦᠨ ᠤᠵᠤᠮᠤᠴᠢᠨ ᠬᠣᠰᠢᠭᠤ" ->  "jegun ûjûmûqin hôsigû" # East Ujimqin Banner
   "ᠠᠷᠤ ᠬᠣᠷᠴᠢᠨ ᠬᠣᠰᠢᠭᠤ" ->  "arû hôrqin hôsigû" # Ar Horqin Banner
   "ᠠᠪᠠᠭ᠎ᠠ ᠬᠣᠰᠢᠭᠤ" ->  "abag-a hôsigû" # Abag Banner
   "ᠪᠤᠷᠢᠶᠠᠳ" ->  "bûriyad" # Буриад
   "ᠤᠯᠠᠭᠠᠨᠪᠠᠭᠠᠲᠤᠷ" ->  "ûlaganbagatûr" # Улаанбаатар
}

dependency "sasm-mon-Mong-Latn-phonetic-1978" as monglatn

stage main {

  run  map.monglatn.stage.main

}
}
