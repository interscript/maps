    sub "𑚶" ""
    sub "𑚶" "·" when opt10
    sub "‍" ""
    sub "‍" "=" when opt99
    sub "𑛀" "0"
    sub "𑛁" "1"
    sub "𑛂" "2"
    sub "𑛃" "3"
    sub "𑛄" "4"
