  sub "ᆸᄄ" "ptt"
  sub "ᆸᄈ" "ppp"
  sub "ᆸᄊ" "pss"
  sub "ᆸᄍ" "pjj"
  sub "ᆺᄀ" "tg"
  sub "ᆺᄂ" "nn"
  sub "ᆺᄃ" "td"
  sub "ᆺᄅ" "nn"
  sub "ᆺᄆ" "nm"
  sub "ᆺᄇ" "tb"
  sub "ᆺᄉ" "ts"
  sub "ᆺᄋ" "s"
  sub "ᆺᄌ" "tj"
  sub "ᆺᄎ" "tch"
  sub "ᆺᄏ" "tk"
  sub "ᆺᄐ" "tt"
  sub "ᆺᄑ" "tp"
  sub "ᆺᄒ" "th"
  sub "ᆺᄁ" "tkk"
  sub "ᆺᄄ" "ttt"
  sub "ᆺᄈ" "tpp"
  sub "ᆺᄊ" "tss"
  sub "ᆺᄍ" "tjj"
  sub "ᆼᄀ" "ngg"
  sub "ᆼᄂ" "ngn"
  sub "ᆼᄃ" "ngd"
  sub "ᆼᄅ" "ngn"
  sub "ᆼᄆ" "ngm"
  sub "ᆼᄇ" "ngb"
  sub "ᆼᄉ" "ngs"
  sub "ᆼᄋ" "ng"
  sub "ᆼᄌ" "ngj"
  sub "ᆼᄎ" "ngch"
  sub "ᆼᄏ" "ngk"
  sub "ᆼᄐ" "ngt"
  sub "ᆼᄑ" "ngp"
  sub "ᆼᄒ" "ngh"
  sub "ᆼᄁ" "ngkk"
  sub "ᆼᄄ" "ngtt"
  sub "ᆼᄈ" "ngpp"
  sub "ᆼᄊ" "ngss"
  sub "ᆼᄍ" "ngjj"
  }

  sub {
    from "ᄀ"
    to "g"
    before any([alpha, digit, jamo_vowel, "-"])
  }
  sub {
    from "ᄂ"
    to "n"
    before any([alpha, digit, jamo_vowel, "-"])
  }
  sub {
