    to "ss"
    before any([alpha, digit, jamo_vowel])
  }
  sub {
    from "ᄍ"
    to "jj"
    before any([alpha, digit, jamo_vowel])
  }
  parallel {
  sub "ᆰᄀ" "lg"
  sub "ᆰᄂ" "ngn"
  sub "ᆰᄃ" "kd"
  sub "ᆰᄅ" "ngn"
  sub "ᆰᄆ" "ngm"
