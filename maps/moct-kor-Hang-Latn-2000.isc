  sub "ᆸᄆ" "mm"
  sub "ᆸᄇ" "pb"
  sub "ᆸᄉ" "ps"
  sub "ᆸᄋ" "b"
  sub "ᆸᄌ" "pj"
  sub "ᆸᄎ" "pch"
  sub "ᆸᄏ" "pk"
  sub "ᆸᄐ" "pt"
