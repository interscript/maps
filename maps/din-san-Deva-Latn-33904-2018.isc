system "DIN:san-Deva:Latn:33904-2018" {

metadata {
  authority_id din
  id 33904-2018
  language iso-639-2:san
  source_script Deva
  destination_script Latn
  name "DIN 33904:2018-10 Information and documentation -- Romanization Devanagari, Sanskrit"
  url https://www.beuth.de/en/standard/din-33904/293049024
  creation_date 2018
  description {    Sanskrit system.

    This standard specifies the transliteration of all languages of the Devanāgarī characters into Latin letters firmly.
    It is suitable for any application.
  }

  notes {
    note "      Vowels:\n      The Ardhacandra ॅ is often used to denote English vowels:\n      EXAMPLE\n      बॅट     bêṭa       (bat)\n      डॉक्टर  ḍôkṭara (doctor)"
    note "      Consonants:\n\n      Since the Devanāgarī script is a syllabic script, it becomes -a inherent in the consonant.\n      Always written during transliteration, also in the final part\n      EXAMPLE 1\n      पुस्तक   pustaka\n\n      A line under the consonant, the so-called Virāma, means in the Devanāgarī script that that inherent -a not applicable.\n      EXAMPLE 2\n      वाक्   vāk\n\n      The anusvāra is always represented with -ṃ-.\n      EXAMPLE 3\n      संसकरण saṃskaraṇa\n\n      Before k, kh, g, gh, c, ch, j, jh, ṭ, ṭh, ḍ, ḍh, t, th, d, dh, p, ph, b, bh, the anusvāra becomes the class nasal transformed.\n      EXAMPLE 4\n      तंघी   kaṃghī becomes kaṅghī\n      पंजाबी  paṃjābī becomes pañjābī\n      पंडित  paṃḍita becomes paṇḍita\n      संधी   saṃdhī becomes sandhī\n      दिसंबर  disaṃbara becomes disambara\n\n      Anunāsika or Candrabindu signals the nasalization of vowels\n\n      EXAMPLE 5\n      माँ māṁ"
  }
}

tests {
   "पुस्तक" ->  "pustaka"
   "बॅट" ->  "bêṭa"
   "वाक्" ->  "vāk"
   "पंजाबी" ->  "pañjābī"
   "डॉक्टर" ->  "ḍôkṭara"
   "पंडित" ->  "paṇḍita"
   "संधी" ->  "sandhī"
   "दिसंबर" ->  "disambara"
   "संसकरण" ->  "saṃsakaraṇa"
   "माँ" ->  "māṁ"
   "शुभाशुभपरित्यागी भक्तिमान्यः स मे प्रियः" ->  "śubhāśubhaparityāgī bhaktimānyaḥ sa me priyaḥ"
   "सत्य -सत्यमेवेश्वरो लोके सत्ये धर्मः सदाश्रितः" ->  "satya -satyameveśvaro loke satye dharmaḥ sadāśritaḥ"
   "सत्यमूलनि सर्वाणि सत्यान्नास्ति परं पदम्" ->  "satyamūlani sarvāṇi satyānnāsti paraṃ padam"
   "पिता माताग्निरात्मा च गुरुश्च भरतर्षभ" ->  "pitā mātāgnirātmā ca guruśca bharatarṣabha"
   "०१२३४५६७८९" ->  "0123456789"
}

aliases {
  deva_chars_1 = any("\u093E\u093F\u0940\u0941\u0942\u0943\u0944\u0945\u0947\u0948\u0949\u094B\u094C")
}

stage main {

  # RULES
  sub {
    from "\u0902"
    to "ṅ"
    after any("कक़खख़गग़घङ")
  }
  sub {
    from "\u0902"
    to "ñ"
    after any("चछजज़झञ")
  }
  sub {
    from "\u0902"
    to "ṇ"
    after any("टट़ठडड़ढढ़ण")
  }
  sub {
    from "\u0902"
    to "n"
    after any("तथदधन")
  }
  sub {
    from "\u0902"
    to "m"
    after any("पफबभम")
  }

  sub {
    from "\u0902"
    to "ñ"
    after any("कखगघचछजझतथदधपफबभटठडढ")
  }

  sub {
    from "क"
    to "k"
    after deva_chars_1
  }
  sub {
    from "ख"
    to "kh"
    after deva_chars_1
  }
  sub {
    from "ग"
    to "g"
    after deva_chars_1
  }
  sub {
    from "घ"
    to "gh"
    after deva_chars_1
  }
  sub {
    from "ङ"
    to "ṅ"
    after deva_chars_1
  }
  sub {
    from "च"
    to "c"
    after deva_chars_1
  }
  sub {
    from "छ"
    to "ch"
    after deva_chars_1
  }
  sub {
    from "ज"
    to "j"
    after deva_chars_1
  }
  sub {
    from "झ"
    to "jh"
    after deva_chars_1
  }
  sub {
    from "ञ"
    to "ñ"
    after deva_chars_1
  }
  sub {
    from "ट"
    to "ṭ"
    after deva_chars_1
  }
  sub {
    from "ठ"
    to "ṭh"
    after deva_chars_1
  }
  sub {
    from "ड"
    to "ḍ"
    after deva_chars_1
  }
  sub {
    from "ढ"
    to "ḍh"
    after deva_chars_1
  }
  sub {
    from "ण"
    to "ṇ"
    after deva_chars_1
  }
  sub {
    from "त"
    to "t"
    after deva_chars_1
  }
  sub {
    from "थ"
    to "th"
    after deva_chars_1
  }
  sub {
    from "द"
    to "d"
    after deva_chars_1
  }
  sub {
    from "ध"
    to "dh"
    after deva_chars_1
  }
  sub {
    from "न"
    to "n"
    after deva_chars_1
  }
  sub {
    from "प"
    to "p"
    after deva_chars_1
  }
  sub {
    from "फ"
    to "ph"
    after deva_chars_1
  }
  sub {
    from "ब"
    to "b"
    after deva_chars_1
  }
  sub {
    from "भ"
    to "bh"
    after deva_chars_1
  }
  sub {
    from "म"
    to "m"
    after deva_chars_1
  }
  sub {
    from "य"
    to "y"
    after deva_chars_1
  }
  sub {
    from "र"
    to "r"
    after deva_chars_1
  }
  sub {
    from "ल"
    to "l"
    after deva_chars_1
  }
  sub {
    from "ळ"
    to "ḷ"
    after deva_chars_1
  }
  sub {
    from "व"
    to "v"
    after deva_chars_1
  }
  sub {
    from "श"
    to "ś"
    after deva_chars_1
  }
  sub {
    from "ष"
    to "ṣ"
    after deva_chars_1
  }
  sub {
    from "स"
    to "s"
    after deva_chars_1
  }
  sub {
    from "ह"
    to "h"
    after deva_chars_1
  }


  # CHARACTERS
  parallel {

    # I. Vowels and Diphthongs (see Note 1)

    sub "अ" "a"
    sub "आ" "ā"
    sub "इ" "i"
    sub "ई" "ī"
    sub "उ" "u"
    sub "ऊ" "ū"
    sub "ऋ" "ṛ"
    sub "ॠ" "ṝ"
    sub "ऌ" "ḷ"
    sub "ए" "e"
    sub "ऎ" "ĕ"
    sub "ऐ" "ai"
    sub "ओ" "o"
    sub "ऒ" "ŏ"
    sub "औ" "au"


    # II. Consonants (see Note 2)
    # Gutturals
    sub "क" "ka"
    sub "ख" "kha"
    sub "ग" "ga"
    sub "घ" "gha"
    sub "ङ" "ṅa"

    # Palatals
    sub "च" "ca"
    sub "छ" "cha"
    sub "ज" "ja"
    sub "झ" "jha"
    sub "ञ" "ña"

    # Cerebrals
    sub "ट" "ṭa"
    sub "ठ" "ṭha"
    sub "ड" "ḍa"
    sub "ढ" "ḍha"
    sub "ण" "ṇa"

    # Dentals
    sub "त" "ta"
    sub "थ" "tha"
    sub "द" "da"
    sub "ध" "dha"
    sub "न" "na"

    # Labials
    sub "प" "pa"
    sub "फ" "pha"
    sub "ब" "ba"
    sub "भ" "bha"
    sub "म" "ma"

    # Semivowels
    sub "य" "ya"
    sub "र" "ra"
    sub "ल" "la"
    sub "ळ" "ḷa"
    sub "व" "va"

    # Sibilants
    sub "श" "śa"
    sub "ष" "ṣa"
    sub "स" "sa"

    # Aspirate
    sub "ह" "ha"

    # Anusvāra
    sub "ं" "ṃ"

    # Bisarga
    sub "ः" "ḥ"

    # Anunāsika
    sub "ँ" "ṁ"

    # Abagraha
    sub "ऽ" "’"

    # Medials # Needed for connecting constants
    sub "ा" "ā"
    sub "ि" "i"
    sub "ी" "ī"
    sub "ु" "u"
    sub "ू" "ū"
    sub "ृ" "ṛ"
    sub "ॄ" "ṝ"
    sub "ॢ" "ḷ"
    sub "ॣ" "ḹ"
    sub "े" "e"
    sub "ै" "ai"
    sub "ो" "o"
    sub "ौ" "au"
    sub "ॉ" "ô"
    sub "ॅ" "ê"
    sub "‍" ""



    # For consonant Virāma
    # Gutturals
    sub "क्" "k"
    sub "ख्" "kh"
    sub "ग्" "g"
    sub "घ्" "gh"
    sub "ङ्" "ṅ"

    # Palatals
    sub "च्" "c"
    sub "छ्" "ch"
    sub "ज्" "j"
    sub "झ्" "jh"
    sub "ञ्" "ñ"

    # Cerebrals
    sub "ट्" "ṭ"
    sub "ठ्" "ṭh"
    sub "ड्" "ḍ"
    sub "ढ्" "ḍh"
    sub "ण्" "ṇ"

    # Dentals
    sub "त्" "t"
    sub "थ्" "th"
    sub "द्" "d"
    sub "ध्" "dh"
    sub "न्" "n"

    # Labials
    sub "प्" "p"
    sub "फ्" "ph"
    sub "ब्" "b"
    sub "भ्" "bh"
    sub "म्" "m"

    # Semivowels
    sub "य्" "y"
    sub "र्" "r"
    sub "ल्" "l"
    sub "ळ्" "ḷ"
    sub "व्" "v"

    # Sibilants
    sub "श्" "ś"
    sub "ष्" "ṣ"
    sub "स्" "s"

    # Aspirate
    sub "ह्" "h"

    # digits

    sub "०" "0"
    sub "१" "1"
    sub "२" "2"
    sub "३" "3"
    sub "४" "4"
    sub "५" "5"
    sub "६" "6"
    sub "७" "7"
    sub "८" "8"
    sub "९" "9"
  }

  compose
}
}
