system "UN:ukr-Cyrl:Latn:1998" {

metadata {
  authority_id un
  id 1998
  language iso-639-2:ukr
  source_script Cyrl
  destination_script Latn
  name Romanization of Belarusian, Russian And Ukrainian Cyrillic (1998)
  url https://unstats.un.org/unsd/geoinfo/UNGEGN/docs/7th-uncsgn-docs/econf/7th_UNCSGN_econf.91_3_Add1.pdf
  # page 320
  creation_date 1998

  notes {
    note "Ge (ґ) was officially banned in the Soviet Ukraine from 1933 to 1990; https://en.wikipedia.org/wiki/Ukrainian_alphabet#ref_2b"
  }
}

tests {
  # generated manually
   "ОЛЕКСАНДР ЯН" ->  "OLEKSANDR ÂN"
   "ТРАНСЛІТЕРАЦІЇ" ->  "TRANSLÌTERACÌÌ"
   "ПЕРЕВІРКА" ->  "PEREVÌRKA"
   "ВСІ МАТЕРІАЛИ РОЗМІЩЕНІ НА УМОВАХ ЛІЦЕНЗІЇ" ->  "VSÌ MATERÌALI ROZMÌŠČENÌ NA UMOVAH LÌCENZÌÌ"
   "ВВЕДІТЬ ПРІЗВИЩЕ ТА ІМ'Я УКРАЇНСЬКИМИ ЛІТЕРАМИ" ->  "VVEDÌT´ PRÌZVIŠČE TA ÌM'Â UKRAÌNS´KIMI LÌTERAMI"
   "ДОДАТКОВА ІНФОРМАЦІЯ" ->  "DODATKOVA ÌNFORMACÌÂ"
   "ДІЯЛЬНІСТЬ" ->  "DÌÂL´NÌST´"
   "ЮЛІЯ" ->  "ÛLÌÂ"
   "ЗГОРАНИ" ->  "ZGORANI"
   "ЙОРКШИР-ТЕР'ЄР" ->  "JORKŠIR-TER'ÊR"
   "ПАПА ПАЧУКА" ->  "PAPA PAČUKA"
   "ЄНАКІЄВЕ" ->  "ÊNAKÌÊVE"
   "УКРАЇНА" ->  "UKRAÌNA"
   "КИЇВ" ->  "KIÌV"

  # UN card tests
   "Україна" ->  "Ukraı̀na"
   "Київ" ->  "Kiı̀v"
}

dependency "gost-rus-Cyrl-Latn-16876-71-1983" as cyrllatn

stage main {

  run  map.cyrllatn.stage.main

  # CHARACTERS
  parallel {
    sub "\u0401" none
    sub "\u0404" "Ê"
    sub "\u0406" "Ì"
    sub "\u0407" "Ì"
    sub "\u042B" none
    sub "\u042D" none

    sub "\u0451" none
    sub "\u0454" "ê"
    sub "\u0456" "ı̀"
    sub "\u0457" "ı̀"
    sub "\u044B" none
    sub "\u044D" none
  }

  compose
}
}
