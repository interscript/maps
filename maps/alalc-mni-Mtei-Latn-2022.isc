system "ALA-LC:mni-Mtei:Latn:2022" {

metadata {
  authority_id alalc
  id 2022
  language iso-639-2:mni
  source_script Mtei
  destination_script Latn
  name "Modern Manipuri (Meitei script) Romanization Table (2022)"
  url https://www.loc.gov/catdir/cpso/romanization/manipuri.pdf
  creation_date 2022
  adoption_date
  description {    ALA-LC Modern Manipuri (Meitei Mayek) Romanization Table,
    June 2022. Consonants carry the inherent vowel a; the seven final
    letters (katap) close syllables without a vowel; dependent vowel
    signs override; the heavy-tone mark romanizes as a dot below.
    Transcribed from the loc.gov document's complete text layer.
  }

  notes {
    note "The heavy tone symbol (꯬) is a recent innovation; its
    romanization is the combining dot below per the table."
    note "2025 corpus repair: the source (p. 2) romanizes the numerals
    ꯰-꯹ as 0-9; the digit rules were added and the numeral test
    corrected (꯳ = 3, not saṣ). The vowel test was corrected to the
    source's own row ꯁꯦ = se (p. 1, Vowels: Dependent vowel sign with
    ꯁ); the katap test to ꯛ = k (p. 1, Final-consonants); the heavy
    tone test to the source's own example ꯀꯥ꯬ = kā + combining dot
    below (p. 2, Heavy tone: ꯀꯥ꯬ = kạ̄). Recorded gaps, behavior
    unchanged: the punctuation row (꫱ question mark, ꫰ comma, ꯫ full
    stop, p. 2) and the apun iyek/halanta killer ꯭ (p. 2 — its
    inherent-vowel omission applies to the preceding consonant and
    needs context-sensitive handling) are not yet encoded."
  }
}

tests {
   "\uabc1\uabe6" ->  "se"
   "\uabf3" ->  "3"
   "\uabdb" ->  "k"
   "\uabc0\uabe5\uabec" ->  "k\u0101\u0323"
}
