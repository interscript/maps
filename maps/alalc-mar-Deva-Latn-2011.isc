system "ALA-LC:mar-Deva:Latn:2011" {

metadata {
  authority_id alalc
  id 2011
  language iso-639-2:mar
  source_script Deva
  destination_script Latn
  name Romanization Table -- Marathi (2011)
  url https://loc.gov/catdir/cpso/romanization/marathi.pdf
  creation_date 1997
  description {    ALA-LC Romanization table for Marathi
  }

  notes {

    note "Only the vowel forms that appear at the beginning of a syllable are listed; the forms used for\n vowels following a consonant can be found in grammars; no distinction between the two is\n made in transliteration."

    note "      The vowel a is implicit after all consonants and consonant clusters and is supplied in\n      transliteration, with the following exceptions:\n\n      a) when another vowel is indicated by its appropriate sign; and\n      b) when the absence of any vowel is indicated by the subscript sign ( ् ) called halanta or\n         virāma."

    note "      Exception: Anusvāra is transliterated by:\n\n      a) ṅ before gutturals,\n      b) ñ before palatals,\n      c) ṇ before cerebrals,\n      d) n before dentals, and\n      e) m before labials.\n      In other circumstances it is transliterated by a tilde (~) over the vowel."

    note "When doubled, avagraha is transliterated by two apostrophes ( ’’ )."
  }
}

tests {
   "कोरोनाच्या लढाईत पोलीस थकलेत, पण हिंमत हरलेले नाहीत; गृहमंत्र्यांकडून कौतुक" ->  "kaoraonaācayaā laḍhaāīta paolaīsa thakalaeta, paṇa haimmata haralaelae naāhaīta; gaṛihamantarayaāṅkaḍaūna kaautauka"
}

dependency "alalc-mar-Deva-Latn-1997" as devalatn

stage main {

  run  map.devalatn.stage.main

}

}
