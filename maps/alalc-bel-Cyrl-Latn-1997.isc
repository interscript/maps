system "ALA-LC:bel-Cyrl:Latn:1997" {

metadata {
  authority_id alalc
  id 1997
  language iso-639-2:bel
  source_script Cyrl
  destination_script Latn
  name Romanization Table -- Byelorussian (1997)
  url http://catdir.loc.gov/catdir/cpso/romanization/beloruss.pdf
  creation_date 1997

  notes {
    note "Ґ letter found in Old Belarusian and in modern publications in Tarashkevitsa orthography."
    note "Do not confuse with the digraph кг (also romanized as “kh”). Manual review may be needed when transcribing data in vernacular characters in order to distinguish х from кг."
    note "The apostrophe (´) is not transliterated."
    note "Soft sign (prime) is USMARC hexadecimal code A7 ~ U+02B9 Unicode character"
  }
}

tests {
  # https://en.wikipedia.org/wiki/Romanization_of_Belarusian#Examples
  # https://img.tyt.by/n/02/d/belorusskiy_translit.jpg - with issues
   "Беларусь" ->  "Belarusʹ"
   "Магілёў" ->  "Mahili͡oŭ"
   "Лукашэнка" ->  "Lukashėnka"
   "сям´я" ->  "si͡ami͡a"
   "Уручча" ->  "Uruchcha"
   "Барысаўскі тракт" ->  "Barysaŭski trakt"
   "Усход" ->  "Uskhod"
   "Маскоўская" ->  "Maskoŭskai͡a"
   "Парк Чалюскінцаў" ->  "Park Chali͡uskintsaŭ"
   "Акадэмія навук" ->  "Akadėmii͡a navuk"
   "Плошча Якуба Коласа" ->  "Ploshcha I͡Akuba Kolasa"
   "Плошча Перамогі" ->  "Ploshcha Peramohi"
   "Кастрычніцкая" ->  "Kastrychnitskai͡a"
   "Плошча Леніна" ->  "Ploshcha Lenina"
   "Інстытут Культуры" ->  "Instytut Kulʹtury"
}

stage main {

  # CHARACTERS
  parallel {
    # Apostrophes
    sub "\u00B4" ""
    sub "\u02BC" ""
    sub "\u0027" ""

    # Characters
    sub "\u0410" "A"
    sub "\u0411" "B"
    sub "\u0412" "V"
    sub "\u0413" "H"
    sub "\u0490" "G"
    sub "\u0414" "D"
    sub "\u0415" "E"
    sub "\u0401" "I͡O"
    sub "\u0416" "Z͡H"
    sub "\u0417" "Z"
    sub "\u0406" "I"
    sub "\u0419" "Ĭ"
    sub "\u041A" "K"
    sub "\u041B" "L"
    sub "\u041C" "M"
    sub "\u041D" "N"
    sub "\u041E" "O"
    sub "\u041F" "P"
    sub "\u0420" "R"
    sub "\u0421" "S"
    sub "\u0422" "T"
    sub "\u0423" "U"
    sub "\\U040E" "Ŭ"
    sub "\u0424" "F"
    sub "\u0425" "Kh"
    sub "\u0426" "Ts"
    sub "\u0427" "Ch"
    sub "\u0428" "Sh"
    sub "\u042B" "Y"
    sub "\u042C" "ʹ"
    sub "\u042D" "Ė"
    sub "\u042E" "I͡U"
    sub "\u042F" "I͡A"

    sub "\u0430" "a"
    sub "\u0431" "b"
    sub "\u0432" "v"
    sub "\u0433" "h"
    sub "\u0491" "g"
    sub "\u0434" "d"
    sub "\u0435" "e"
    sub "\u0451" "i͡o"
    sub "\u0436" "z͡h"
    sub "\u0437" "z"
    sub "\u0456" "i"
    sub "\u0439" "ĭ"
    sub "\u043A" "k"
    sub "\u043B" "l"
    sub "\u043C" "m"
    sub "\u043D" "n"
    sub "\u043E" "o"
    sub "\u043F" "p"
    sub "\u0440" "r"
    sub "\u0441" "s"
    sub "\u0442" "t"
    sub "\u0443" "u"
    sub "\u045E" "ŭ"
    sub "\u0444" "f"
    sub "\u0445" "kh"
    sub "\u0446" "ts"
    sub "\u0447" "ch"
    sub "\u0448" "sh"
    sub "\u044B" "y"
    sub "\u044C" "ʹ"
    sub "\u044D" "ė"
    sub "\u044E" "i͡u"
    sub "\u044F" "i͡a"
  }

}

}
