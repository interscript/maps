  # Combining smooth (U+0313) / rough (U+0314) breathing marks are
  # re-positioned: psili -> apostrophe before the vowel, dasia -> h
  # before the vowel (Table 3 rows 14-15). Runs after the character
  # stage so the emitted marks are not stripped.
  parallel {
    sub "a̓" "'a"
    sub "e̓" "'e"
    sub "i̓" "'i"
    sub "o̓" "'o"
    sub "y̓" "'y"
    sub "ī̓" "'ī"
    sub "ō̓" "'ō"
    sub "a̔" "ha"
