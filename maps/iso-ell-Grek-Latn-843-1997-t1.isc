# https://en.wikipedia.org/wiki/Romanization_of_Greek
stage main {

  # RULES
  sub {
    from "\u03A5"
    to "U"
    before any("ΑαΕεΟο")
  }
  sub {
    from "\u03C5"
    to "u"
    before any("ΑαΕεΟο")
  }
  sub {
    from "\u03CD"
    to "ú"
    before any("ΑαΕεΟο")
  }
  sub "\u037E" "?"
  sub "\u003B" "?"


  # TABLE 5 - Greek numerical symbols -> decimal numbers (Note 13).
  # Single symbol + upper numeral sign (U+0374); lower numeral sign
  # (U+0375, thousands) + letter. Runs before the character stage.
  parallel {
    sub "Αʹ" "1"
    sub "αʹ" "1"
    sub "Βʹ" "2"
    sub "βʹ" "2"
    sub "Γʹ" "3"
    sub "γʹ" "3"
    sub "Δʹ" "4"
    sub "δʹ" "4"
    sub "Εʹ" "5"
    sub "εʹ" "5"
    sub "Ϛʹ" "6"
    sub "ϛʹ" "6"
    sub "Ζʹ" "7"
    sub "ζʹ" "7"
    sub "Ηʹ" "8"
    sub "ηʹ" "8"
    sub "Θʹ" "9"
    sub "θʹ" "9"
    sub "Ιʹ" "10"
    sub "ιʹ" "10"
    sub "Κʹ" "20"
    sub "κʹ" "20"
    sub "Λʹ" "30"
    sub "λʹ" "30"
    sub "Μʹ" "40"
    sub "μʹ" "40"
    sub "Νʹ" "50"
    sub "νʹ" "50"
    sub "Ξʹ" "60"
    sub "ξʹ" "60"
    sub "Οʹ" "70"
    sub "οʹ" "70"
    sub "Πʹ" "80"
    sub "πʹ" "80"
    sub "Ϙʹ" "90"
    sub "ϙʹ" "90"
    sub "Ϟʹ" "90"
    sub "ϟʹ" "90"
    sub "Ρʹ" "100"
    sub "ρʹ" "100"
    sub "Σʹ" "200"
    sub "σʹ" "200"
    sub "Τʹ" "300"
    sub "τʹ" "300"
    sub "Υʹ" "400"
    sub "υʹ" "400"
    sub "Φʹ" "500"
    sub "φʹ" "500"
    sub "Χʹ" "600"
    sub "χʹ" "600"
    sub "Ψʹ" "700"
    sub "ψʹ" "700"
    sub "Ωʹ" "800"
    sub "ωʹ" "800"
    sub "Ϡʹ" "900"
    sub "ϡʹ" "900"
    sub "͵Α" "1000"
    sub "͵α" "1000"
    sub "͵Β" "2000"
    sub "͵β" "2000"
    sub "͵Γ" "3000"
    sub "͵γ" "3000"
    sub "͵Δ" "4000"
    sub "͵δ" "4000"
    sub "͵Ε" "5000"
    sub "͵ε" "5000"
    sub "͵Ϛ" "6000"
    sub "͵ϛ" "6000"
    sub "͵Ζ" "7000"
    sub "͵ζ" "7000"
    sub "͵Η" "8000"
    sub "͵η" "8000"
    sub "͵Θ" "9000"
    sub "͵θ" "9000"
  }

  # CHARACTERS
  parallel {
    sub "'" ""
    sub "Ά" "Á"
    sub "Α" "A"
    sub "Β" "V"
    sub "Γ" "G"
    sub "Δ" "D"
    sub "Ε" "E"
    sub "Ζ" "Z"
    sub "Η" "Ī"
    sub "Θ" "Th"
    sub "Ι" "I"
    sub "Κ" "K"
    sub "Λ" "L"
