    sub "i̔" "hi"
    sub "o̔" "ho"
    sub "y̔" "hy"
    sub "ī̔" "hī"
    sub "ō̔" "hō"
    sub "A̓" "'A"
    sub "E̓" "'E"
    sub "I̓" "'I"
    sub "O̓" "'O"
    sub "Y̓" "'Y"
    sub "ī̓" "'Ī"
    sub "ō̓" "'Ō"
    sub "A̔" "Ha"
    sub "E̔" "He"
