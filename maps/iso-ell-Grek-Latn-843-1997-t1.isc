    sub "O̔" "Ho"
    sub "Y̔" "Hy"
    sub "ī̔" "Hī"
    sub "ō̔" "Hō"
    sub "a̓" "'a"
    sub "e̓" "'e"
    sub "i̓" "'i"
    sub "o̓" "'o"
    sub "y̓" "'y"
    sub "ī̓" "'ī"
    sub "ō̓" "'ō"
    sub "A̓" "'A"
    sub "E̓" "'E"
    sub "I̓" "'I"
    sub "O̓" "'O"
    sub "Y̓" "'Y"
    sub "Ī̓" "'Ī"
    sub "Ō̓" "'Ō"
  }

  sub {
    from any(["Th", "Ch", "Ps", "Ha", "He", "Hi", "Ho", "Hy", "Rh", "Hī", "Hō"])
    to upcase
    before any("A".."Z")
  }
  sub {
    from any(["Th", "Ch", "Ps", "Ha", "He", "Hi", "Ho", "Hy", "Rh", "Hī", "Hō"])
    to upcase
    after any("A".."Z")
  }
}
