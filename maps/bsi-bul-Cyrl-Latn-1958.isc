system "BSI:bul-Cyrl:Latn:1958" {

metadata {
  authority_id bsi
  id 1958
  language iso-639-2:bul
  source_script Cyrl
  destination_script Latn
  name "BS 2979:1958 Transliteration of Cyrillic and Greek characters - Table A, Bulgarian column (the British system)"
  url https://www.bsigroup.com
  creation_date 1958
  confirmation_date 2000-05
  description {    BS 2979:1958, Table A, Bulgarian column: the "British" system for (modern) Cyrillic.
    Table A is a five-column family table (East Slavonic: Russian, Ukrainian,
    Byelorussian; South Slavonic: Bulgarian, Serbian and Macedonian).
  }

  notes {
    note "NOTE 1 of Section 1: for extreme simplicity, when avoidance of ambiguity in back transliteration is not a paramount consideration, all accents, diacritics, etc., may be omitted in the English rendering; the document's own examples apply this (the document's own examples apply it). This map applies the table as printed, with the diacritics."
    note "NOTE 2 of Section 1: Cyrillic characters for which the transliteration is given in parentheses, though no longer in official use, are sometimes found in the literature of the relevant language; this map renders them as given in the parentheses."
    note "Rows 45 to 47 of Table A (the little yus, fita, izhitsa) are not rendered: their parenthesized cells are not legible beyond doubt in the scan and this map does not guess them. Table B (back transliteration) is out of scope; Table C is ISO/R9 and is cited against the existing iso corpus maps."
    note "Row 38/40 choices: this map renders the hard sign with the right double quotation mark (U+201D) and the soft sign with the right single quotation mark (U+2019), the first option of each cell. In the Bulgarian column the hard sign is a vowel and this map renders it with the breve (u-breve), per row 38."
  }
}

tests {
   "София" ->  "Sofiya"
   "Съюз" ->  "Sŭyuz"
   "Български" ->  "Bŭlgarski"
   "Щ" ->  "Sht"
   "щ" ->  "sht"
   "Ъ" ->  "Ŭ"
   "ъ" ->  "ŭ"
   "Ѣ" ->  "Ě"
   "ѣ" ->  "ě"
   "а" ->  "a"
   "б" ->  "b"
   "в" ->  "v"
   "г" ->  "g"
   "д" ->  "d"
   "е" ->  "e"
   "ж" ->  "zh"
   "з" ->  "z"
   "и" ->  "i"
   "й" ->  "ĭ"
   "к" ->  "k"
   "л" ->  "l"
   "м" ->  "m"
   "н" ->  "n"
   "о" ->  "o"
   "п" ->  "p"
   "р" ->  "r"
   "с" ->  "s"
   "т" ->  "t"
   "у" ->  "u"
   "ф" ->  "f"
   "х" ->  "kh"
   "ц" ->  "ts"
   "ч" ->  "ch"
   "ш" ->  "sh"

}

stage main {

  # CHARACTERS
  parallel {
    sub "Тс" "T-s"
    sub "тс" "t-s"
    sub "А" "A"
    sub "Б" "B"
    sub "В" "V"
    sub "Г" "G"
    sub "Д" "D"
    sub "Е" "E"
    sub "Ж" "Zh"
    sub "З" "Z"
    sub "И" "I"
    sub "Й" "Ĭ"
    sub "К" "K"
    sub "Л" "L"
    sub "М" "M"
    sub "Н" "N"
    sub "О" "O"
    sub "П" "P"
    sub "Р" "R"
    sub "С" "S"
    sub "Т" "T"
    sub "У" "U"
    sub "Ф" "F"
    sub "Х" "Kh"
    sub "Ц" "Ts"
    sub "Ч" "Ch"
    sub "Ш" "Sh"
    sub "Щ" "Sht"
    sub "Ъ" "Ŭ"
    sub "Ь" "’"
    sub "Ѣ" "Ě"
    sub "Ю" "Yu"
    sub "Я" "Ya"

    sub "а" "a"
    sub "б" "b"
    sub "в" "v"
    sub "г" "g"
    sub "д" "d"
    sub "е" "e"
    sub "ж" "zh"
    sub "з" "z"
    sub "и" "i"
    sub "й" "ĭ"
    sub "к" "k"
    sub "л" "l"
    sub "м" "m"
    sub "н" "n"
    sub "о" "o"
    sub "п" "p"
    sub "р" "r"
    sub "с" "s"
    sub "т" "t"
    sub "у" "u"
    sub "ф" "f"
    sub "х" "kh"
    sub "ц" "ts"
    sub "ч" "ch"
    sub "ш" "sh"
    sub "щ" "sht"
    sub "ъ" "ŭ"
    sub "ь" "’"
    sub "ѣ" "ě"
    sub "ю" "yu"
    sub "я" "ya"
  }

}

}
