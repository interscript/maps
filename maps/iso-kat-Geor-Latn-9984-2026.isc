}

stage main {
  # Section 4.2 digraph disambiguation: adjoining source pairs whose
  # romanization would form a digraph are separated by the middle dot
  # U+00B7. Encoded as the document's pair rows; they run before the
  # parallel stage.
  sub "გჰ" "g·h"
  sub "ზჰ" "z·h"
  sub "სჰ" "s·h"
  sub "ქჰ" "k·h"
  sub "თს" "t·s"
  sub "დზ" "d·z"

  # Table 4 - transliteration of Georgian characters (rows 1-33)
  # Table 5 - transliteration of other characters (rows 1-14)
  parallel {
    sub "ა" "a"
    sub "ბ" "b"
    sub "გ" "g"
    sub "დ" "d"
    sub "ე" "e"
    sub "ვ" "v"
    sub "ზ" "z"
    sub "თ" "t"
    sub "ი" "i"
    sub "კ" "k'"
    sub "ლ" "l"
    sub "მ" "m"
    sub "ნ" "n"
    sub "ო" "o"
    sub "პ" "p'"
    sub "ჟ" "zh"
    sub "რ" "r"
    sub "ს" "s"
    sub "ტ" "t'"
