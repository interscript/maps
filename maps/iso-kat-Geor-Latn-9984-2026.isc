    sub "ძ" "dz"
    sub "წ" "ts'"
    sub "ჭ" "ch'"
    sub "ხ" "kh"
    sub "ჯ" "j"
    sub "ჰ" "h"

    sub "ჱ" "ē"
    sub "ჲ" "y"
    sub "ჳ" "w"
