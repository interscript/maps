   "ᠰᠢᠨ᠎ᠡ ᠬᠣᠲᠠ ᠲᠣᠭᠣᠷᠢᠭ" ->  "sin-e hota togorig" # Xincheng District
   "ᠬᠠᠶᠢᠷᠤᠪ ᠤᠨ ᠲᠣᠬᠣᠢ ᠲᠣᠭᠣᠷᠢᠭ" ->  "hayirub-un tohoi togorig" # Haibowan (Hairibin Tohoi) District
   "ᠰᠦᠩ ᠱᠠᠨ ᠲᠣᠭᠣᠷᠢᠭ" ->  "sung xan togorig" # Songshan District
   "ᠬᠦᠩ ᠱᠠᠨ ᠲᠣᠭᠣᠷᠢᠭ" ->  "hung xan togorig" # Hongshan District
   "ᠠᠷᠤᠨ ᠬᠣᠰᠢᠭᠤ" ->  "arun hosigu" # Арун хошуу
   "ᠶᠤᠸᠠᠨ ᠪᠣᠣ ᠱᠠᠨ ᠲᠣᠭᠣᠷᠢᠭ" ->  "yuwan boo xan togorig" # Юаньбаошань тойрог
   "ᠰᠢᠯᠤᠭᠤᠨ ᠬᠥᠪᠡᠭᠡᠲᠦ ᠴᠠᠭᠠᠨ ᠬᠣᠰᠢᠭᠤ" ->  "silugun hobegetu qagan hosigu" # Шулуун Хөвөөт Цагаан хошуу
   "ᠰᠢᠯᠤᠭᠤᠨ ᠬᠥᠬᠡ ᠬᠣᠰᠢᠭᠤ" ->  "silugun hohe hosigu" # Шулуун хөх хошуу
   "ᠤᠷᠠᠳ ᠤᠨ ᠳᠤᠮᠳᠠᠳᠤ ᠬᠣᠰᠢᠭᠤ" ->  "urad-un dumdadu hosigu" # Урадын Дундад Хошуу
   "ᠤᠷᠠᠳ ᠤᠨ ᠡᠮᠦᠨᠡᠳᠦ ᠬᠣᠰᠢᠭᠤ" ->  "urad-un emunedu hosigu" # Урадын Өмнөд Хошуу
   "ᠲᠣᠭᠲᠠᠬᠤ ᠰᠢᠶᠠᠨ" ->  "togtahu siyan" # Тогтох шянь
   "ᠲᠠᠶᠢᠫᠤᠰᠧ ᠬᠣᠰᠢᠭᠤ" ->  "tayipuse hosigu" # Тайвас хошуу
   "ᠰᠥᠨᠡᠳ ᠵᠡᠭᠦᠨ ᠬᠣᠰᠢᠭᠤ" ->  "soned jegun hosigu" # Sonid Left Banner
   "ᠰᠥᠨᠡᠳ ᠪᠠᠷᠠᠭᠤᠨ ᠬᠣᠰᠢᠭᠤ" ->  "soned baragun hosigu" # Sonid Right Banner
   "ᠣᠩᠨᠢᠭᠤᠳ ᠬᠣᠰᠢᠭᠤ" ->  "ongnigud hosigu" # Ongniud Banner
   "ᠵᠠᠯᠠᠢᠳ ᠬᠣᠰᠢᠭᠤ" ->  "jalaid hosigu" # Jalaid Banner
   "ᠬᠠᠩᠭᠢᠨ ᠬᠣᠶᠢᠲᠤ ᠬᠣᠰᠢᠭᠤ" ->  "hanggin hoyitu hosigu" # Hanggin Rear Banner
   "ᠵᠡᠭᠦᠨ ᠤᠵᠤᠮᠤᠴᠢᠨ ᠬᠣᠰᠢᠭᠤ" ->  "jegun ujumuqin hosigu" # East Ujimqin Banner
   "ᠠᠷᠤ ᠬᠣᠷᠴᠢᠨ ᠬᠣᠰᠢᠭᠤ" ->  "aru horqin hosigu" # Ar Horqin Banner
   "ᠠᠪᠠᠭ᠎ᠠ ᠬᠣᠰᠢᠭᠤ" ->  "abag-a hosigu" # Abag Banner
   "ᠪᠤᠷᠢᠶᠠᠳ" ->  "buriyad" # Буриад
   "ᠤᠯᠠᠭᠠᠨᠪᠠᠭᠠᠲᠤᠷ" ->  "ulaganbagatur" # Улаанбаатар
}

stage main {

  # CHARACTERS
  parallel {
    sub "ᠠ" "a"
    sub "ᠪ" "b"
    sub "ᠼ" "c"
    # sub "ᠲ", "d" # \u1832 - Duplicate rule
    sub "ᠳ" "d"
    sub "ᠡ" "e"
    sub "ᠹ" "f"
    sub "ᠭ" "g"
    # sub "ᠺ", "g" # \u183a - Duplicate rule
    sub "ᠬ" "h"
    sub "ᠾ" "h"
    sub "ᠢ" "i"
    sub "ᠵ" "j"
    sub "ᠺ" "k"
    sub "ᠯ" "l"
    sub "ᠮ" "m"
    sub "ᠨ" "n"
    sub "ᠥ" "o"
    sub "ᠫ" "p"
    sub "ᠴ" "q"
    sub "ᠷ" "r"
    sub "ᠰ" "s"
    sub "ᠲ" "t"
    sub "ᠦ" "u"
    sub "ᠸ" "w"
    sub "ᠱ" "x"
    sub "ᠶ" "y"
    sub "ᠽ" "z"
    sub "ᠣ" "o"
    # - "o"     # General use
    # - "ô"     # For place names
    sub "ᠤ" "u"
    # - "u"     # General use
    # - "û"     # For place names
    sub "ᠧ" "e"
    sub "ᠩ" "ng"
    sub "᠎" "-"
    sub " " "-"
  }

}
}
