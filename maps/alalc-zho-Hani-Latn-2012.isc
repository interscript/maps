   "如" ->  "ru"
   "然" ->  "ran"
   "史" ->  "shi"
   "司" ->  "si"
   "孫" ->  "sun"
   "太" ->  "tai"
   "桐" ->  "tong"
   "乌" ->  "wu"
   "委" ->  "wei"
   "乡" ->  "xiang"
   "学" ->  "xue"
   "一" ->  "yi"
   "亞" ->  "ya"
   "元" ->  "yuan"
   "中" ->  "zhong"
   "子" ->  "zi"
  # Traditional forms attested alongside simplified ones.
   "吳" ->  "wu"
   "務" ->  "wu"
   "學" ->  "xue"
   "劉" ->  "liu"
   "寧" ->  "ning"
   "師" ->  "shi"
   "菴" ->  "an"
   "顗" ->  "yi"
   "釋" ->  "shi"
}

stage main {
  # Separation of Syllables: separate the romanization of each Chinese
  # character with a space.
  separate

  parallel {
    # Punctuation 2: brackets used in the manner of quotation marks
    # romanize as quotation marks.
    sub "「" "\""
    sub "」" "\""
    sub "『" "\""
    sub "』" "\""
    sub "《" "\""
    sub "》" "\""

    # Characters attested in the document's examples
    sub "一" "yi"
    sub "与" "yu"
    sub "丑" "chou"
    sub "丘" "qiu"
    sub "东" "dong"
    sub "中" "zhong"
    sub "主" "zhu"
    sub "义" "yi"
    sub "乌" "wu"
