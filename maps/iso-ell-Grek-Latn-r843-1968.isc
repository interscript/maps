system "ISO:ell-Grek:Latn:r843-1968" {

metadata {
  authority_id iso
  id r843-1968
  language iso-639-2:ell
  source_script Grek
  destination_script Latn
  name "ISO/R 843:1968 International system for the transliteration of Greek characters into Latin characters"
  url
  # Source document: interscript-private-references/iso/ISO-R-843-1968.pdf (held copy, complete: table + special signs + retransliteration).
  creation_date 1968
  description {    ISO Recommendation R 843, October 1968: the international system for
    the transliteration of Greek characters into Latin characters. Superseded
    by ISO 843:1997 (encoded separately). Bibliographic letter-by-letter
    system with no diphthong vocalizer: eta -> e-macron, ypsilon -> u,
    chi -> h, phi -> f, omega -> o-macron, beta -> b.
  }

  notes {
    note "Table of transliteration, 24 rows; the final sigma is listed in the table as s (final)."
    note "Footnote to rows 8 and 23: the exceptional combinations tau-chi and tau-sigma are separated in transliteration by a dot - rendered here as the full stop, since the document prints a mid dot which this map assigns to the ano teleia -> colon rule; letter-by-letter tau-sigma would give t.s."
    note "Clause 1(a): the smooth breathing sign is omitted."
    note "Clause 1(b): the rough breathing sign is represented by an apostrophe which precedes the vowel; in vowel digraphs such as -ou- the apostrophe precedes the first vowel ('ou, not o'u); when it occurs over rho the rough breathing sign is omitted in transliteration."
    note "Clause 1(c): a diaeresis in the Greek text is reproduced; the stress accents (acute, grave, circumflex) are reproduced as combining marks. The document examples print some words without reproduced accents (Attike, Koumetika) while others carry them (Agamemnon, Eureia); this map always reproduces them."
    note "Clause 1(d): the iota subscript, even when postliteral in capitalized Greek texts (iota adscript), is always rendered by a postliteral j."
    note "Clause 1(e): the ano teleia (single point high) is rendered by a colon; the erotimatiko (interrogation mark) by the question mark."
    note "Clause 2 (retransliteration into Greek) is a reverse-direction provision and is not encoded in this forward map."
    note "Document examples used as tests: Agamemnon, Eureia, Kuros (circumflex), Myrtoion pelagos (iota subscript -> j), MYRTOION PELAGOS caps (adscript I -> postliteral J), ano teleia -> colon, erotimatiko -> ?. The held copy has a watermark over the clause 1(b) example line and over the uppercase Myrtoon line; those readings are flagged in docs/coverage and are not pinned as tests. The printed lowercase Myrtoion shows u/y glyphs ambiguous at scan resolution; row 20 (Y, y -> U, u) governs."
    note "Greek numerical signs have no provision in this Recommendation and pass through unconverted."
  }
}

tests {
   "Ἀγαμέμνων" ->  "Agamémnōn"
   "Εὔρεια" ->  "Eúreia"
   "Κοῦρος" ->  "Koûros"
   "Μυρτῴον πέλαγος" ->  "Murtṓjon pélagos"
   "ΜΥΡΤῼΟΝ ΠΕΛΑΓΟΣ" ->  "MURTŌJON PELAGOS"
   "Γιὰ τὶ ὄχι;" ->  "Già tì óhi?"
   "Ἀθήνα·" ->  "Athḗna:"
   "ΑΘΗΝΑ" ->  "ATHĒNA"
   "ΥΔΡΑ" ->  "UDRA"
   "Ῥόδος" ->  "Ródos"
   "ὁ Φοῖβος" ->  "'o Foîbos"
   "οὐρανός" ->  "ouranós"
   "Ἡμέρα" ->  "'Ēméra"
   "τχ" ->  "t.h"
   "τσ" ->  "p.s"
   "ΤΣ" ->  "P.S"
   "ἁ" ->  "'a"
   "ἀ" ->  "a"
   "ῳ" ->  "ōj"
   "ᾶ" ->  "â"
   "ῥ" ->  "r"
}

stage main {

  # Footnote to rows 8 and 23: exceptional combinations separated by a dot.
  parallel {
    sub "τχ" "t.h"
    sub "Τχ" "T.h"
    sub "τΧ" "t.H"
    sub "ΤΧ" "T.H"
    sub "τσ" "p.s"
    sub "Τσ" "P.s"
    sub "τΣ" "p.S"
    sub "ΤΣ" "P.S"
  }

  # CHARACTERS (table of transliteration, clause 1 special signs)
  parallel {
    # clause 1(e): ano teleia -> colon, erotimatiko -> question mark
    sub "·" ":"
    sub "·" ":"
    sub ";" "?"
    sub ";" "?"

    sub "Ά" "Á"
    sub "Α" "A"
    sub "Β" "B"
    sub "Γ" "G"
    sub "Δ" "D"
    sub "Ε" "E"
    sub "Ζ" "Z"
    sub "Η" "Ē"
    sub "Θ" "Th"
    sub "Ι" "I"
    sub "Κ" "K"
    sub "Λ" "L"
    sub "Μ" "M"
    sub "Ν" "N"
    sub "Ξ" "X"
    sub "Ο" "O"
    sub "Π" "P"
    sub "Ρ" "R"
    sub "Σ" "S"
    sub "Τ" "T"
    sub "Υ" "U"
    sub "Φ" "F"
    sub "Χ" "H"
    sub "Ψ" "Ps"
    sub "Ω" "Ō"
    sub "Έ" "É"
    sub "Ή" "Ḗ"
    sub "Ί" "Í"
    sub "Ό" "Ó"
    sub "Ύ" "Ú"
    sub "Ώ" "Ṓ"
    sub "Ϊ" "Ï"
    sub "Ϋ" "Ü"

    sub "ά" "á"
    sub "α" "a"
    sub "β" "b"
    sub "γ" "g"
    sub "δ" "d"
    sub "ε" "e"
    sub "ζ" "z"
    sub "η" "ē"
    sub "θ" "th"
    sub "ι" "i"
    sub "κ" "k"
    sub "λ" "l"
    sub "μ" "m"
    sub "ν" "n"
    sub "ξ" "x"
    sub "ο" "o"
    sub "π" "p"
    sub "ρ" "r"
    sub "ς" "s"
    sub "σ" "s"
    sub "τ" "t"
    sub "υ" "u"
    sub "φ" "f"
    sub "χ" "h"
    sub "ψ" "ps"
    sub "ω" "ō"
    sub "έ" "é"
    sub "ή" "ḗ"
    sub "ί" "í"
    sub "ό" "ó"
    sub "ύ" "ú"
    sub "ώ" "ṓ"
    sub "ϊ" "ï"
    sub "ϋ" "ü"
    sub "ΐ" "ḯ"
    sub "ΰ" "ǘ"

    # polytonic varia (clause 1(c): grave reproduced)
    sub "ὰ" "à"
    sub "ὲ" "è"
    sub "ὴ" "ḕ"
    sub "ὶ" "ì"
    sub "ὸ" "ò"
    sub "ὺ" "ù"
    sub "ὼ" "ṑ"
    sub "Ὰ" "À"
    sub "Ὲ" "È"
    sub "Ὴ" "Ḕ"
    sub "Ὶ" "Ì"
    sub "Ὸ" "Ò"
    sub "Ὺ" "Ù"
    sub "Ὼ" "Ṑ"

    # polytonic oxia (clause 1(c): acute reproduced)
    sub "ά" "á"
    sub "έ" "é"
    sub "ή" "ḗ"
    sub "ί" "í"
    sub "ό" "ó"
    sub "ύ" "ú"
    sub "ώ" "ṓ"
    sub "Ά" "Á"
    sub "Έ" "É"
    sub "Ή" "Ḗ"
    sub "Ί" "Í"
    sub "Ό" "Ó"
    sub "Ύ" "Ú"
    sub "Ώ" "Ṓ"

    # perispomeni (clause 1(c): circumflex reproduced)
    sub "ᾶ" "â"
    sub "ῆ" "ē̂"
    sub "ῖ" "î"
    sub "ῦ" "û"
    sub "ῶ" "ô"

    # dialytika combinations (clause 1(c): diaeresis reproduced)
    sub "ῒ" "ï̀"
    sub "ΐ" "ḯ"
    sub "ῗ" "ï̂"
    sub "ῢ" "ǜ"
    sub "ΰ" "ǘ"
    sub "ῧ" "ü̂"

    # clause 1(d): iota subscript -> postliteral j
    sub "ᾳ" "aj"
    sub "ᾲ" "àj"
    sub "ᾴ" "áj"
    sub "ᾷ" "âj"
    sub "ᾼ" "Aj"
    sub "ῃ" "ēj"
    sub "ῂ" "ḕj"
    sub "ῄ" "ḗj"
    sub "ῇ" "ē̂j"
    sub "ῌ" "Ēj"
    sub "ῳ" "ōj"
    sub "ῲ" "ṑj"
    sub "ῴ" "ṓj"
    sub "ῷ" "ō̂j"
    sub "ῼ" "Ōj"

    # breathing + ypogegrammeni (smooth omitted, rough -> preceding apostrophe)
    sub "ᾀ" "aj"
    sub "ᾁ" "'aj"
    sub "ᾂ" "àj"
    sub "ᾃ" "'àj"
    sub "ᾄ" "áj"
    sub "ᾅ" "'áj"
    sub "ᾆ" "âj"
    sub "ᾇ" "'âj"
    sub "ᾈ" "Aj"
    sub "ᾉ" "'Aj"
    sub "ᾊ" "Àj"
    sub "ᾋ" "'Àj"
    sub "ᾌ" "Áj"
    sub "ᾍ" "'Áj"
    sub "ᾎ" "Âj"
    sub "ᾏ" "'Âj"
    sub "ᾐ" "ēj"
    sub "ᾑ" "'ēj"
    sub "ᾒ" "ḕj"
    sub "ᾓ" "'ḕj"
    sub "ᾔ" "ḗj"
    sub "ᾕ" "'ḗj"
    sub "ᾖ" "ē̂j"
    sub "ᾗ" "'ē̂j"
    sub "ᾘ" "Ēj"
    sub "ᾙ" "'Ēj"
    sub "ᾚ" "Ḕj"
    sub "ᾛ" "'Ḕj"
    sub "ᾜ" "Ḗj"
    sub "ᾝ" "'Ḗj"
    sub "ᾞ" "Ē̂j"
    sub "ᾟ" "'Ē̂j"
    sub "ᾠ" "ōj"
    sub "ᾡ" "'ōj"
    sub "ᾢ" "ṑj"
    sub "ᾣ" "'ṑj"
    sub "ᾤ" "ṓj"
    sub "ᾥ" "'ṓj"
    sub "ᾦ" "ō̂j"
    sub "ᾧ" "'ō̂j"
    sub "ᾨ" "Ōj"
    sub "ᾩ" "'Ōj"
    sub "ᾪ" "Ṑj"
    sub "ᾫ" "'Ṑj"
    sub "ᾬ" "Ṓj"
    sub "ᾭ" "'Ṓj"
    sub "ᾮ" "Ō̂j"
    sub "ᾯ" "'Ō̂j"

    # breathing block (clause 1(a) smooth omitted, 1(b) rough -> preceding apostrophe)
    sub "ἀ" "a"
    sub "ἁ" "'a"
    sub "ἂ" "à"
    sub "ἃ" "'à"
    sub "ἄ" "á"
    sub "ἅ" "'á"
    sub "ἆ" "â"
    sub "ἇ" "'â"
    sub "Ἀ" "A"
    sub "Ἁ" "'A"
    sub "Ἂ" "À"
    sub "Ἃ" "'À"
    sub "Ἄ" "Á"
    sub "Ἅ" "'Á"
    sub "Ἆ" "Â"
    sub "Ἇ" "'Â"
    sub "ἐ" "e"
    sub "ἑ" "'e"
    sub "ἒ" "è"
    sub "ἓ" "'è"
    sub "ἔ" "é"
    sub "ἕ" "'é"
    sub "Ἐ" "E"
    sub "Ἑ" "'E"
    sub "Ἒ" "È"
    sub "Ἓ" "'È"
    sub "Ἔ" "É"
    sub "Ἕ" "'É"
    sub "ἠ" "ē"
    sub "ἡ" "'ē"
    sub "ἢ" "ḕ"
    sub "ἣ" "'ḕ"
    sub "ἤ" "ḗ"
    sub "ἥ" "'ḗ"
    sub "ἦ" "ē̂"
    sub "ἧ" "'ē̂"
    sub "Ἠ" "Ē"
    sub "Ἡ" "'Ē"
    sub "Ἢ" "Ḕ"
    sub "Ἣ" "'Ḕ"
    sub "Ἤ" "Ḗ"
    sub "Ἥ" "'Ḗ"
    sub "Ἦ" "Ē̂"
    sub "Ἧ" "'Ē̂"
    sub "ἰ" "i"
    sub "ἱ" "'i"
    sub "ἲ" "ì"
    sub "ἳ" "'ì"
    sub "ἴ" "í"
    sub "ἵ" "'í"
    sub "ἶ" "î"
    sub "ἷ" "'î"
    sub "Ἰ" "I"
    sub "Ἱ" "'I"
    sub "Ἲ" "Ì"
    sub "Ἳ" "'Ì"
    sub "Ἴ" "Í"
    sub "Ἵ" "'Í"
    sub "Ἶ" "Î"
    sub "Ἷ" "'Î"
    sub "ὀ" "o"
    sub "ὁ" "'o"
    sub "ὂ" "ò"
    sub "ὃ" "'ò"
    sub "ὄ" "ó"
    sub "ὅ" "'ó"
    sub "Ὀ" "O"
    sub "Ὁ" "'O"
    sub "Ὂ" "Ò"
    sub "Ὃ" "'Ò"
    sub "Ὄ" "Ó"
    sub "Ὅ" "'Ó"
    sub "ὐ" "u"
    sub "ὑ" "'u"
    sub "ὒ" "ù"
    sub "ὓ" "'ù"
    sub "ὔ" "ú"
    sub "ὕ" "'ú"
    sub "ὖ" "û"
    sub "ὗ" "'û"
    sub "Ὑ" "'U"
    sub "Ὓ" "'Ù"
    sub "Ὕ" "'Ú"
    sub "Ὗ" "'Û"
    sub "ὠ" "ō"
    sub "ὡ" "'ō"
    sub "ὢ" "ṑ"
    sub "ὣ" "'ṑ"
    sub "ὤ" "ṓ"
    sub "ὥ" "'ṓ"
    sub "ὦ" "ô"
    sub "ὧ" "'ô"
    sub "Ὠ" "Ō"
    sub "Ὡ" "'Ō"
    sub "Ὢ" "Ṑ"
    sub "Ὣ" "'Ṑ"
    sub "Ὤ" "Ṓ"
    sub "Ὥ" "'Ṓ"
    sub "Ὦ" "Ō̂"
    sub "Ὧ" "'Ō̂"
    sub "ῤ" "r"
    sub "ῥ" "r"
    sub "Ῥ" "R"

    # combining marks (clause 1(a)/(c)/(d))
    sub "̓" ""
    sub "̓" ""
    sub "͂" "̂"
    sub "ͅ" "j"
    sub "̈́" "̈́"
  }

  # clause 1(b): the rough breathing apostrophe precedes the vowel;
  # over rho it is omitted.
  parallel {
    sub "a̔" "'a"
    sub "e̔" "'e"
    sub "ē̔" "'ē"
    sub "i̔" "'i"
    sub "o̔" "'o"
    sub "u̔" "'u"
    sub "ō̔" "'ō"
    sub "A̔" "'A"
    sub "E̔" "'E"
    sub "Ē̔" "'Ē"
    sub "I̔" "'I"
    sub "O̔" "'O"
    sub "U̔" "'U"
    sub "Ō̔" "'Ō"
    sub "r̔" "r"
    sub "R̔" "R"
  }

  # all-caps text: digraph residues join the capitals
  sub {
    from any(["Th", "Ps", "j"])
    to upcase
    before any("A".."Z")
  }
  sub {
    from any(["Th", "Ps", "j"])
    to upcase
    after any("A".."Z")
  }
}

}
