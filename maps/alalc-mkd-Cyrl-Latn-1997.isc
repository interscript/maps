system "ALA-LC:mkd-Cyrl:Latn:1997" {

metadata {
  authority_id alalc
  id 1997
  language iso-639-2:mkd
  source_script Cyrl
  destination_script Latn
  name Romanization Table -- Serbian and Macedonian (1997)
  url http://catdir.loc.gov/catdir/cpso/romanization/serbian.pdf
  creation_date 1997
  description ALA-LC Romanization table for Serbian and Macedonian.

  notes {
    note "Special characters in romanization\n Đ - D with crossbar (upper case). USMARC hexadecimal code A3.\n đ - d with crossbar (upper case). USMARC hexadecimal code B3."

    note "Character modifiers in romanization\n ´ - acute. USMARC hexadecimal code E2.\n ˇ - hachek. USMARC hexadecimal code E9."
  }
}

tests {
   "Општина Ердут" ->  "Opština Erdut"
   "Општина Двор" ->  "Opština Dvor"
   "ЛУЃЕ луѓе" ->  "LUǴE luǵe"
   "ЅВЕЗДА ѕвезда Ѕвезда" ->  "DZVEZDA dzvezda Dzvezda"
   "ЌАРУВАЊЕ ќарување" ->  "ḰARUVANJE ḱaruvanje"
}

dependency "posix"

stage main {


  # CHARACTERS
  parallel {
    sub "А" "A"
    sub "Б" "B"
    sub "В" "V"
    sub "Г" "G"
    sub "Ѓ" "Ǵ"
    sub "Д" "D"
    sub "Ђ" "Đ"
    sub "Е" "E"
    sub "Ж" "Ž"
    sub "З" "Z"
    sub "Ѕ" "Dz"
    sub "И" "I"
    sub "Ј" "J"
    sub "К" "K"
    sub "Ќ" "Ḱ"
    sub "Л" "L"
    sub "Љ" "Lj"
    sub "М" "M"
    sub "Н" "N"
    sub "Њ" "Nj"
    sub "О" "O"
    sub "П" "P"
    sub "Р" "R"
    sub "С" "S"
    sub "Т" "T"
    sub "Ћ" "Ć"
    sub "У" "U"
    sub "Ф" "F"
    sub "Х" "H"
    sub "Ц" "C"
    sub "Ч" "Č"
    sub "Џ" "Dž"
    sub "Ш" "Š"
    sub "а" "a"
    sub "б" "b"
    sub "в" "v"
    sub "г" "g"
    sub "ѓ" "ǵ"
    sub "д" "d"
    sub "ђ" "đ"
    sub "е" "e"
    sub "ж" "ž"
    sub "з" "z"
    sub "ѕ" "dz"
    sub "и" "i"
    sub "ј" "j"
    sub "к" "k"
    sub "ќ" "ḱ"
    sub "л" "l"
    sub "љ" "lj"
    sub "м" "m"
    sub "н" "n"
    sub "њ" "nj"
    sub "о" "o"
    sub "п" "p"
    sub "р" "r"
    sub "с" "s"
    sub "т" "t"
    sub "ћ" "ć"
    sub "у" "u"
    sub "ф" "f"
    sub "х" "h"
    sub "ц" "c"
    sub "ч" "č"
    sub "џ" "dž"
    sub "ш" "š"
  }

  # POSTRULES
  # rewritten by hand to work properly
  # DZ
  sub {
    from capture(maybe(upper)) + "Dz" + capture(upper)
    to ref(1) + "DZ" + ref(2)
  }
  sub {
    from capture(upper) + "Dz" + capture(maybe(upper))
    to ref(1) + "DZ" + ref(2)
  }

  #LJ
  sub {
    from capture(upper) + "Lj" + capture(maybe(upper))
    to ref(1) + "LJ" + ref(2)
  }
  sub {
    from capture(maybe(upper)) + "Lj" + capture(upper)
    to ref(1) + "LJ" + ref(2)
  }

  #NJ
  sub {
    from capture(upper) + "Nj" + capture(maybe(upper))
    to ref(1) + "NJ" + ref(2)
  }
  sub {
    from capture(maybe(upper)) + "Nj" + capture(upper)
    to ref(1) + "NJ" + ref(2)
  }

  #DŽ
  sub {
    from capture(upper) + "Dž" + capture(maybe(upper))
    to ref(1) + "DŽ" + ref(2)
  }
  sub {
    from capture(maybe(upper)) + "Dž" + capture(upper)
    to ref(1) + "DŽ" + ref(2)
  }

  compose
}

}
