system "VAR:jpn-Hrkt:Latn:komaba-2009" {

metadata {
  authority_id var
  id komaba-2009
  language iso-639-2:jpn
  source_script Hrkt
  destination_script Latn
  name "Recommended System for Romanizing Japanese (UT-Komaba, 2009)"
  url http://park.itc.u-tokyo.ac.jp/eigo/romaji.html
  creation_date 2009
  description {    The Hepburn-based romanization recommended by the Department of
    English Language / Komaba Organization for Educational Development,
    The University of Tokyo, Komaba ("Recommended System for Romanizing
    Japanese", 2009.04 v1).
  }

  notes {
    note "Syllabic n is always n, never m before b/p/m (tonbo, shinpai, sanma); before a vowel or y in the same word it takes a following apostrophe (hon%s i, hon%s yaku), which distinguishes honyu (honyu) from honyu (hon%s yu)." % (APOS, APOS, APOS)
    note "Long consonants (small tsu) double the following consonant letter; before ch-syllables the small tsu is written as a single t (atchaku, not attchaku); before sh it doubles as s (asshuku); before ts it doubles as t (yottsu)."
    note "Long vowels are indicated with a macron (okāsan, kīkī, kūkai, kēki, tōri, kōzō); the ei row of kana (kei, sei, mei...) is spelled out as ei even though pronounced with the vowel sequence of a long e (keizai, seifu, mein)."
    note "Vowel-length limitation (same as the corpus hepburn-1886 note): morpheme-boundary vowel sequences that the document requires to be repeated rather than macronized (baai, Kiihanto, Katsuura, Ise Eki, kouta) cannot be detected from kana alone; this map collapses same-vowel kana pairs to the macron by default and the repeated spellings require lexical pre-segmentation. The lengthening bar is transcribed by a macron on the preceding vowel."
    note "The document prints the fa row as fa with an acute-accented a (fa); the acute is a typesetting artifact of the held copy and this map uses fa."
    note "Word division (particles wa/e/o, spacing after -te/-de forms), honorific hyphenation and capitalization in the document operate on morphological knowledge and are not encodable at the kana-character level; the worked constitution example of the document is therefore not pinned as a test."
  }
}

tests {
   "おかあさん" ->  "okāsan"
   "キーキー" ->  "kīkī"
   "くうかい" ->  "kūkai"
   "ケーキ" ->  "kēki"
   "とおり" ->  "tōri"
   "けいざい" ->  "keizai"
   "せいふ" ->  "seifu"
   "めいん" ->  "mein"
   "こうぞう" ->  "kōzō"
   "ばあい" ->  "baai"
   "かった" ->  "katta"
   "いっぽう" ->  "ippō"
   "ぶった" ->  "butta"
   "あっしゅく" ->  "asshuku"
   "あっちゃく" ->  "atchaku"
   "よっつ" ->  "yottsu"
   "しんかんせん" ->  "shinkansen"
   "ほんい" ->  "hon’i"
   "ほんやく" ->  "hon’yaku"
   "とんぼ" ->  "tonbo"
   "しんぱい" ->  "shinpai"
   "さんま" ->  "sanma"
   "とうきょう" ->  "tōkyō"
   "にゃっほー" ->  "nyahhō"
   "ヴァイオリン" ->  "vaiorin"
   "ウィキ" ->  "wiki"
   "チェック" ->  "chekku"
   "ジェ" ->  "je"
   "ヂェ" ->  "je"
   "スィ" ->  "si"
   "イェ" ->  "ye"
   "ティ" ->  "ti"
   "ディ" ->  "di"
   "トゥ" ->  "tu"
   "ドゥ" ->  "du"
   "ファフィフェフォ" ->  "fafifefo"
   "ヴュ" ->  "vyu"
}

stage main {

  # Syllabic n: apostrophe before a vowel or y (same word).
  sub {
    from capture(any("んン"))
    to ref( 1 ) + "’"
    after any("あいうえおやゆよアイウエオヤユヨヴ")
  }

  # CHARACTERS
  parallel {
    sub "あ" "a"
    sub "い" "i"
    sub "う" "u"
    sub "え" "e"
    sub "お" "o"
    sub "おう" "ō"
    sub "か" "ka"
    sub "き" "ki"
    sub "く" "ku"
    sub "け" "ke"
    sub "こ" "ko"
    sub "きゃ" "kya"
    sub "きゅ" "kyu"
    sub "きょ" "kyo"
    sub "きょう" "kyō"
    sub "こう" "kō"
    sub "が" "ga"
    sub "ぎ" "gi"
    sub "ぐ" "gu"
    sub "げ" "ge"
    sub "ご" "go"
    sub "ぎゃ" "gya"
    sub "ぎゅ" "gyu"
    sub "ぎょ" "gyo"
    sub "ぎょう" "gyō"
    sub "ごう" "gō"
    sub "さ" "sa"
    sub "し" "shi"
    sub "す" "su"
    sub "せ" "se"
    sub "そ" "so"
    sub "しゃ" "sha"
    sub "しゅ" "shu"
    sub "しょ" "sho"
    sub "しょう" "shō"
    sub "そう" "sō"
    sub "ざ" "za"
    sub "じ" "ji"
    sub "ず" "zu"
    sub "ぜ" "ze"
    sub "ぞ" "zo"
    sub "じゃ" "ja"
    sub "じゅ" "ju"
    sub "じょ" "jo"
    sub "じょう" "jō"
    sub "ぞう" "zō"
    sub "た" "ta"
    sub "ち" "chi"
    sub "つ" "tsu"
    sub "て" "te"
    sub "と" "to"
    sub "ちゃ" "cha"
    sub "ちゅ" "chu"
    sub "ちょ" "cho"
    sub "ちょう" "chō"
    sub "とう" "tō"
    sub "だ" "da"
    sub "ぢ" "ji"
    sub "づ" "zu"
    sub "で" "de"
    sub "ど" "do"
    sub "ぢゃ" "ja"
    sub "ぢゅ" "ju"
    sub "ぢょ" "jo"
    sub "どう" "dō"
    sub "な" "na"
    sub "に" "ni"
    sub "ぬ" "nu"
    sub "ね" "ne"
    sub "の" "no"
    sub "にゃ" "nya"
    sub "にゅ" "nyu"
    sub "にょ" "nyo"
    sub "にょう" "nyō"
    sub "のう" "nō"
    sub "は" "ha"
    sub "ひ" "hi"
    sub "ふ" "fu"
    sub "へ" "he"
    sub "ほ" "ho"
    sub "ひゃ" "hya"
    sub "ひゅ" "hyu"
    sub "ひょ" "hyo"
    sub "ひょう" "hyō"
    sub "ほう" "hō"
    sub "ば" "ba"
    sub "び" "bi"
    sub "ぶ" "bu"
    sub "べ" "be"
    sub "ぼ" "bo"
    sub "びゃ" "bya"
    sub "びゅ" "byu"
    sub "びょ" "byo"
    sub "びょう" "byō"
    sub "ぼう" "bō"
    sub "ぱ" "pa"
    sub "ぴ" "pi"
    sub "ぷ" "pu"
    sub "ぺ" "pe"
    sub "ぽ" "po"
    sub "ぴゃ" "pya"
    sub "ぴゅ" "pyu"
    sub "ぴょ" "pyo"
    sub "ぴょう" "pyō"
    sub "ぽう" "pō"
    sub "ま" "ma"
    sub "み" "mi"
    sub "む" "mu"
    sub "め" "me"
    sub "も" "mo"
    sub "みゃ" "mya"
    sub "みゅ" "myu"
    sub "みょ" "myo"
    sub "みょう" "myō"
    sub "もう" "mō"
    sub "や" "ya"
    sub "ゆ" "yu"
    sub "よ" "yo"
    sub "よう" "yō"
    sub "ら" "ra"
    sub "り" "ri"
    sub "る" "ru"
    sub "れ" "re"
    sub "ろ" "ro"
    sub "りゃ" "rya"
    sub "りゅ" "ryu"
    sub "りょ" "ryo"
    sub "りょう" "ryō"
    sub "ろう" "rō"
    sub "わ" "wa"
    sub "を" "o"
    sub "ん" "n"

    # Foreign-sound extensions (document table, katakana forms)
    sub "イェ" "ye"
    sub "ウィ" "wi"
    sub "ウェ" "we"
    sub "ウォ" "wo"
    sub "ヴァ" "va"
    sub "ヴィ" "vi"
    sub "ヴ" "vu"
    sub "ヴェ" "ve"
    sub "ヴォ" "vo"
    sub "ヴュ" "vyu"
    sub "スィ" "si"
    sub "ジェ" "je"
    sub "ヂェ" "je"
    sub "チェ" "che"
    sub "ティ" "ti"
    sub "ディ" "di"
    sub "トゥ" "tu"
    sub "ドゥ" "du"
    sub "ファ" "fa"
    sub "フィ" "fi"
    sub "フェ" "fe"
    sub "フォ" "fo"

    # Katakana
    sub "ア" "a"
    sub "イ" "i"
    sub "ウ" "u"
    sub "エ" "e"
    sub "オ" "o"
    sub "オウ" "ō"
    sub "カ" "ka"
    sub "キ" "ki"
    sub "ク" "ku"
    sub "ケ" "ke"
    sub "コ" "ko"
    sub "キャ" "kya"
    sub "キュ" "kyu"
    sub "キョ" "kyo"
    sub "キョウ" "kyō"
    sub "コウ" "kō"
    sub "ガ" "ga"
    sub "ギ" "gi"
    sub "グ" "gu"
    sub "ゲ" "ge"
    sub "ゴ" "go"
    sub "ギャ" "gya"
    sub "ギュ" "gyu"
    sub "ギョ" "gyo"
    sub "ギョウ" "gyō"
    sub "ゴウ" "gō"
    sub "サ" "sa"
    sub "シ" "shi"
    sub "ス" "su"
    sub "セ" "se"
    sub "ソ" "so"
    sub "シャ" "sha"
    sub "シュ" "shu"
    sub "ショ" "sho"
    sub "ショウ" "shō"
    sub "ソウ" "sō"
    sub "ザ" "za"
    sub "ジ" "ji"
    sub "ズ" "zu"
    sub "ゼ" "ze"
    sub "ゾ" "zo"
    sub "ジャ" "ja"
    sub "ジュ" "ju"
    sub "ジョ" "jo"
    sub "ジョウ" "jō"
    sub "ゾウ" "zō"
    sub "タ" "ta"
    sub "チ" "chi"
    sub "ツ" "tsu"
    sub "テ" "te"
    sub "ト" "to"
    sub "チャ" "cha"
    sub "チュ" "chu"
    sub "チョ" "cho"
    sub "チョウ" "chō"
    sub "トウ" "tō"
    sub "ダ" "da"
    sub "ヂ" "ji"
    sub "ヅ" "zu"
    sub "デ" "de"
    sub "ド" "do"
    sub "ヂャ" "ja"
    sub "ヂュ" "ju"
    sub "ヂョ" "jo"
    sub "ドウ" "dō"
    sub "ナ" "na"
    sub "ニ" "ni"
    sub "ヌ" "nu"
    sub "ネ" "ne"
    sub "ノ" "no"
    sub "ニャ" "nya"
    sub "ニュ" "nyu"
    sub "ニョ" "nyo"
    sub "ニョウ" "nyō"
    sub "ノウ" "nō"
    sub "ハ" "ha"
    sub "ヒ" "hi"
    sub "フ" "fu"
    sub "ヘ" "he"
    sub "ホ" "ho"
    sub "ヒャ" "hya"
    sub "ヒュ" "hyu"
    sub "ヒョ" "hyo"
    sub "ヒョウ" "hyō"
    sub "ホウ" "hō"
    sub "バ" "ba"
    sub "ビ" "bi"
    sub "ブ" "bu"
    sub "ベ" "be"
    sub "ボ" "bo"
    sub "ビャ" "bya"
    sub "ビュ" "byu"
    sub "ビョ" "byo"
    sub "ビョウ" "byō"
    sub "ボウ" "bō"
    sub "パ" "pa"
    sub "ピ" "pi"
    sub "プ" "pu"
    sub "ペ" "pe"
    sub "ポ" "po"
    sub "ピャ" "pya"
    sub "ピュ" "pyu"
    sub "ピョ" "pyo"
    sub "ピョウ" "pyō"
    sub "ポウ" "pō"
    sub "マ" "ma"
    sub "ミ" "mi"
    sub "ム" "mu"
    sub "メ" "me"
    sub "モ" "mo"
    sub "ミャ" "mya"
    sub "ミュ" "myu"
    sub "ミョ" "myo"
    sub "ミョウ" "myō"
    sub "モウ" "mō"
    sub "ヤ" "ya"
    sub "ユ" "yu"
    sub "ヨ" "yo"
    sub "ヨウ" "yō"
    sub "ラ" "ra"
    sub "リ" "ri"
    sub "ル" "ru"
    sub "レ" "re"
    sub "ロ" "ro"
    sub "リャ" "rya"
    sub "リュ" "ryu"
    sub "リョ" "ryo"
    sub "リョウ" "ryō"
    sub "ロウ" "rō"
    sub "ワ" "wa"
    sub "ヲ" "o"
    sub "ン" "n"
  }

  # Long consonants (clause: long consonants). The small tsu doubles the
  # following consonant letter; before ch the doubled letter is t
  # (atchaku); before sh it doubles as s; before ts it doubles as t.
  sub {
    from any("っッ") + "ch"
    to "tch"
  }
  sub {
    from any("っッ") + capture(any("BbCcDdFfGgHhJjKkLlMmNnPpQqRrSsTtVvWwXxYyZz"))
    to ref( 1 ) + ref( 1 )
  }
  sub {
    from any("っッ")
    to ""
  }

  # Long vowels: macron on doubled kana and on the lengthening bar.
  # The document's repeat clause (baai, not bāi): a doubled kana vowel
  # followed by another vowel letter is left as a sequence.
  sub {
    from "a" + any("ーa")
    to "ā"
    not_after any("あいうえおAIUEOaiueoー")
  }
  sub {
    from "i" + any("ーi")
    to "ī"
    not_after any("あいうえおAIUEOaiueoー")
  }
  sub {
    from "u" + any("ーu")
    to "ū"
    not_after any("あいうえおAIUEOaiueoー")
  }
  sub {
    from "e" + any("ーe")
    to "ē"
    not_after any("あいうえおAIUEOaiueoー")
  }
  sub {
    from "o" + any("ーo")
    to "ō"
    not_after any("あいうえおAIUEOaiueoー")
  }

}
}
