system "BGN-PCGN:che-Cyrl:Latn:2008" {

metadata {
  authority_id bgnpcgn
  id 2008
  language iso-639-2:che
  source_script Cyrl
  destination_script Latn
  name Table of Correspondences for Chechen (Cyrillic-Roman) (2008 Agreement)
  url https://assets.publishing.service.gov.uk/government/uploads/system/uploads/attachment_data/file/835782/TABLE_OF_CORRESPONDENCES_FOR_CHECHEN.pdf
  creation_date 2008
  confirmation_date 2019-07
  description {    Chechen is an official language within Chechnya, one of the republics of the Russian Federation.
    It will normally be encountered in Cyrillic script, in which case it should be romanized by means of
    the Cyrillic-Roman table of correspondences given below.
  }

  notes {
    note "The letter ə is used to represent short a; a is used for long a."
    note "Ye is used word- and syllable-initially. This Cyrillic letter may be encountered as the ligature ie in Chechen-Roman sources."
    note "This character occurs only in loan words."
    note "q in the combination ккх (qq) and q̇in the combination ккъ (q̇q̇)"
    note "ŋ when preceding vowel is nasalized."
    note "This Cyrillic letter may be encountered as the ligature ꭣ [U+AB63] or the diphthong oa in Chechen Roman sources."
    note "Unless in the combinations гӀ, кӀ, пӀ, тӀ, хӀ, цӀ and чӀ."
    note "      An inventory of letter-diacritic combinations, with their Unicode encoding, in addition to the\n      unmodified letters of the basic Roman script is:\n\n      All apostrophes appearing in romanization are U+2019\n\n          Ə (U+018F)       ə (U+0259)\n          Ä (U+00C4)       ä (U+00E4)\n          Ġ (U+0047+0307)  ġ (U+0067+0307)\n          Z̵ (U+005A+0335)  z̵ (U+007A+0335)\n          Q̇ (U+0051+0307)  q̇ (U+0071+0307)\n          Ŋ (U+014A)       ŋ (U+014B)\n          Ö (U+00D6)       ö (U+00F6)\n          Ü (U+00DC)       ü (U+00FC)\n          Ẋ (U+0058+0307)  ẋ (U+0078+0307)\n          Ċ (U+0043+0307)  ċ (U0063+0307)\n          Ç (U+00C7)       ç (U+00E7)\n          Ç̇ (U+00C7+0307)  ç̇ (U+00E7+0307)\n          Ş (U+015E)       ş (U+015F)"

    note "The Roman-script columns show only lowercase forms but, when applying the table, uppercase and lowercase Roman letters as appropriate should be used"
  }
}

tests {
   "кӏант" ->  "khant"
   "зуда" ->  "zuda"
   "пхьагал" ->  "pẋagal"
   "наж" ->  "naz̵"
   "мангал" ->  "mangal"
   "Ӏаж" ->  "Jaz̵"
   "Нохчийн Википеди" ->  "Noxçiyn Vikipedi"
   "сагӏадаккхар" ->  "saġadaqqar"
   "йеза" ->  "yeza"
   "еара" ->  "yeara"
   "елха" ->  "yelxa"
}

stage main {

  # RULES
  # note[2]
  sub {
    from boundary + "\u0415"
    to "Ye"
    not_before boundary + "\u2019"
  }
  sub {
    from boundary + "\u0435"
    to "ye"
    not_before boundary + "\u2019"
  }
  # note[4]
  sub "\u043A\u043A\u0445" "qq"
  sub "\u043A\u043A\u042A" "q̇q̇"
  sub "\u041A\u041A\u0445" "QQ"
  sub "\u041A\u041A\u042A" "Q̇Q̇"


  # CHARACTERS
  parallel {
    sub {
    from "\u0410"
    to any(["A", "Ə"])
  }
    sub "\u0410\u044C" "Ä"
    sub "\u0411" "B"
    sub "\u0412" "V"
    sub "\u0413" "G"
    sub "\u0413\u04C0" "Ġ"
    sub "\u0414" "D"
    sub "\u0415" "E"
    sub "\u0401" "Yo"
    sub "\u0416" "Z̵"
    sub "\u0417" "Z"
    sub "\u0418" "I"
    sub "\u042B" "Y"
    sub "\u041A" "K"
    sub "\u041A\u0445" "Q"
    sub "\u041A\u044A" "Q̇"
    sub "\u041A\u04C0" "Kh"
    sub "\u041B" "L"
    sub "\u041C" "M"
    sub {
    from "\u041D"
    to any(["N", "Ŋ"])
  }
    sub "\u041E" "O"
    sub "\u041E\u044C" "Ö"
    sub "\u041F" "P"
    sub "\u041F\u04C0" "Ph"
    sub "\u0420" "R"
    sub "\u0421" "S"
    sub "\u0422" "T"
    sub "\u0422\u04C0" "Th"
    sub "\u0423" "U"
    sub "\u0423\u044C" "Ü"
    sub "\u0424" "F"
    sub "\u0425" "X"
    sub "\u0425\u044C" "Ẋ"
    sub "\u0425\u04C0" "H"
    sub "\u04B8" "C"
    sub "\u04B8\u04C0" "Ċ"
    sub "\u0427" "Ç"
    sub "\u0427\u04C0" "Ç̇"
    sub "\u0428" "Ş"
    sub "\u0429" "ŞÇ"
    sub "\u042A" "’"
    sub "\u042B" "Y"
    sub "\u042C" ""
    sub "\u042D" "E"
    sub "\u042E" "Yu"
    sub "\u042E\u044C" "Yü"
    sub "\u042F" "Ya"
    sub "\u042F\u044C" "Yä"
    sub "\u04C0" "J"

    sub {
    from "\u0430"
    to any(["a", "ə"])
  }
    sub "\u0430\u044C" "ä"
    sub "\u0431" "b"
    sub "\u0432" "v"
    sub "\u0433" "g"
    sub "\u0433\u04CF" "ġ"
    sub "\u0434" "d"
    sub "\u0435" "e"
    sub "\u0451" "yo"
    sub "\u0436" "z̵"
    sub "\u0437" "z"
    sub "\u0438" "i"
    sub "\u0439" "y"
    sub "\u043A" "k"
    sub "\u043A\u0445" "q"
    sub "\u043A\u044A" "q̇"
    sub "\u043A\u04CF" "kh"
    sub "\u043B" "l"
    sub "\u043C" "m"
    sub {
    from "\u043D"
    to any(["n", "ŋ"])
  }
    sub "\u043E" "o"
    sub "\u043E\u044C" "ö"
    sub "\u043F" "p"
    sub "\u0440" "r"
    sub "\u0441" "s"
    sub "\u0442" "t"
    sub "\u0442\u04CF" "th"
    sub "\u0443" "u"
    sub "\u0443\u044C" "ü"
    sub "\u0444" "f"
    sub "\u0445" "x"
    sub "\u0445\u044C" "ẋ"
    sub "\u0445\u04CF" "h"
    sub "\u04B9" "c"
    sub "\u04B9\u04CF" "с̇"
    sub "\u0447" "ç"
    sub "\u0447\u04CF" "cç̇"
    sub "\u0448" "ş"
    sub "\u0449" "şç"
    sub "\u044A" "’"
    sub "\u044B" "y"
    sub "\u044C" ""
    sub "\u044D" "e"
    sub "\u044E" "yu"
    sub "\u044E" "yü"
    sub "\u044F" "ya"
    sub "\u044F" "yä"
    sub "\u04CF" "j"
  }
  compose
}

}
