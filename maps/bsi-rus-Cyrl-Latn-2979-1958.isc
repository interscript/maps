    sub "Я" "Ya"
    sub "Ѣ" "Ê"
    sub "Ѳ" "Ḟ"
    sub "Ѵ" "Ŷ"
    sub "Ъ" "”"
    sub "Ь" "’"
    sub "А" "A"
    sub "Б" "B"
    sub "В" "V"
    sub "Г" "G"
    sub "Д" "D"
