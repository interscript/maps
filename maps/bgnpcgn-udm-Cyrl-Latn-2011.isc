system "BGN-PCGN:udm-Cyrl:Latn:2011" {

metadata {
  authority_id bgnpcgn
  id 2011
  language iso-639-2:udm
  source_script Cyrl
  destination_script Latn
  name Romanization of Udmurt (2011)
  url https://www.gov.uk/government/organisations/permanent-committee-on-geographical-names
  creation_date 2011
  confirmation_date 2017-11
  description {
    The BGN/PCGN system for Udmurt is designed for use in romanizing names written in the
    Udmurt Cyrillic alphabet. Udmurt (sometimes known as Votyak) is a member of the Permian
    branch of the Finno-Ugric languages and is an official language alongside Russian in the
    Russian Federation's republic of Udmurtiya; it has existed in written form since the late
    18th century, and first appeared in its present Cyrillic orthography in 1905.
  }

  notes {
    note "Е should be romanized ye word-initially, after a vowel, after Й, Ъ, Ь, and after the palatalizing consonants Д, З, Л, Н, С and Т. It should be romanized e elsewhere."
    note "In order to retain reversibility, where two consonant characters appear together and the resulting romanization is equivalent to a Roman-script digraph occurring in the system (i.e. gh, zh, tl, sh or ts), a medial dot may be employed between the Roman-script consonants in order to distinguish these from the Roman-script digraphs."
    note "The character ё is always romanized yo, independently of position."
    note "An inventory of letter-diacritic combinations, with their Unicode encoding, in addition to the unmodified letters of the basic Roman script is:"
    note "All apostrophes appearing in romanization are U+2019"
    note "Ï (U+00CF)  ï (U+00EF)  Ö (U+00D6)  ö (U+00F6)"
    note "The Romanization columns show only lowercase forms but, when romanizing, uppercase and lowercase Roman letters as appropriate should be used."
  }
}

tests {
  # every table row, upper and lower
   "А" ->  "A"
   "а" ->  "a"
   "Б" ->  "B"
   "б" ->  "b"
   "В" ->  "V"
   "в" ->  "v"
   "Г" ->  "G"
   "г" ->  "g"
   "Д" ->  "D"
   "д" ->  "d"
   "Е" ->  "Ye"
   "е" ->  "ye"
   "Ё" ->  "Yo"
   "ё" ->  "yo"
   "Ж" ->  "Zh"
   "ж" ->  "zh"
   "Ӝ" ->  "Dzh"
   "ӝ" ->  "dzh"
   "З" ->  "Z"
   "з" ->  "z"
   "Ӟ" ->  "J"
   "ӟ" ->  "j"
   "И" ->  "I"
   "и" ->  "i"
   "Ӥ" ->  "Ï"
   "ӥ" ->  "ï"
   "Й" ->  "Y"
   "й" ->  "y"
   "К" ->  "K"
   "к" ->  "k"
   "Л" ->  "L"
   "л" ->  "l"
   "М" ->  "M"
   "м" ->  "m"
   "Н" ->  "N"
   "н" ->  "n"
   "О" ->  "O"
   "о" ->  "o"
   "Ӧ" ->  "Ö"
   "ӧ" ->  "ö"
   "П" ->  "P"
   "п" ->  "p"
   "Р" ->  "R"
   "р" ->  "r"
   "С" ->  "S"
   "с" ->  "s"
   "Т" ->  "T"
   "т" ->  "t"
   "У" ->  "U"
   "у" ->  "u"
   "Ф" ->  "F"
   "ф" ->  "f"
   "Х" ->  "Kh"
   "х" ->  "kh"
   "Ц" ->  "Ts"
   "ц" ->  "ts"
   "Ч" ->  "Ch"
   "ч" ->  "ch"
   "Ӵ" ->  "Tsh"
   "ӵ" ->  "tsh"
   "Ш" ->  "Sh"
   "ш" ->  "sh"
   "Щ" ->  "Shch"
   "щ" ->  "shch"
   "Ъ" ->  "”"
   "ъ" ->  "”"
   "Ы" ->  "Y"
   "ы" ->  "y"
   "Ь" ->  "’"
   "ь" ->  "’"
   "Э" ->  "E"
   "э" ->  "e"
   "Ю" ->  "Yu"
   "ю" ->  "yu"
   "Я" ->  "Ya"
   "я" ->  "ya"
  # note 1: ye after vowels, й ъ ь, and д з л н с т; e elsewhere
   "бе" ->  "be"
   "де" ->  "dye"
   "йе" ->  "yye"
   "ъе" ->  "”ye"
   "ӧе" ->  "öye"
   "ое" ->  "oye"
}

stage main {

  # RULES
  # note 1: Е word-initially, after a vowel, after й ъ ь, and after д з л н с т
  sub {
    from boundary + "Е"
    to "Ye"
  }
  sub {
    from boundary + "е"
    to "ye"
  }
  sub {
    from "Е"
    to "Ye"
    before any("АаЕеЁёИиОоУуЫыЭэЮюЯяӦӧЙйЪъЬьДдЗзЛлНнСсТт")
  }
  sub {
    from "е"
    to "ye"
    before any("АаЕеЁёИиОоУуЫыЭэЮюЯяӦӧЙйЪъЬьДдЗзЛлНнСсТт")
  }

  # CHARACTERS
  parallel {
    sub "Ӝ" "Dzh"
    sub "Ӵ" "Tsh"
    sub "Ӟ" "J"
    sub "Ӧ" "Ö"
    sub "Ӥ" "Ï"
    sub "Щ" "Shch"
    sub "Ъ" "”"
    sub "Ы" "Y"
    sub "Ь" "’"
    sub "Ю" "Yu"
    sub "Я" "Ya"
    sub "А" "A"
    sub "Б" "B"
    sub "В" "V"
    sub "Г" "G"
    sub "Д" "D"
    sub "Е" "E"
    sub "Ё" "Yo"
    sub "Ж" "Zh"
    sub "З" "Z"
    sub "И" "I"
    sub "Й" "Y"
    sub "К" "K"
    sub "Л" "L"
    sub "М" "M"
    sub "Н" "N"
    sub "О" "O"
    sub "П" "P"
    sub "Р" "R"
    sub "С" "S"
    sub "Т" "T"
    sub "У" "U"
    sub "Ф" "F"
    sub "Х" "Kh"
    sub "Ц" "Ts"
    sub "Ч" "Ch"
    sub "Ш" "Sh"
    sub "Э" "E"

    sub "ӝ" "dzh"
    sub "ӵ" "tsh"
    sub "ӟ" "j"
    sub "ӧ" "ö"
    sub "ӥ" "ï"
    sub "щ" "shch"
    sub "ъ" "”"
    sub "ы" "y"
    sub "ь" "’"
    sub "ю" "yu"
    sub "я" "ya"
    sub "а" "a"
    sub "б" "b"
    sub "в" "v"
    sub "г" "g"
    sub "д" "d"
    sub "е" "e"
    sub "ё" "yo"
    sub "ж" "zh"
    sub "з" "z"
    sub "и" "i"
    sub "й" "y"
    sub "к" "k"
    sub "л" "l"
    sub "м" "m"
    sub "н" "n"
    sub "о" "o"
    sub "п" "p"
    sub "р" "r"
    sub "с" "s"
    sub "т" "t"
    sub "у" "u"
    sub "ф" "f"
    sub "х" "kh"
    sub "ц" "ts"
    sub "ч" "ch"
    sub "ш" "sh"
    sub "э" "e"
  }

}

}
