system "BGN-PCGN:udm-Cyrl:Latn:2011" {

metadata {
  authority_id bgnpcgn
  id 2011
  language iso-639-2:udm
  source_script Cyrl
  destination_script Latn
  name Romanization of Udmurt (BGN/PCGN 2011 System)
  url https://geonames.nga.mil/gns/html/Romanization/ROMANIZATION%20OF%20UDMURT.pdf
  creation_date 2011
  confirmation_date 2017-11
  description {    The BGN/PCGN system for Udmurt is designed for use in romanizing names written
    in the Udmurt Cyrillic alphabet. Udmurt (sometimes known as Votyak) is a member of the
    Permian branch of the Finno-Ugric languages and is an official language alongside Russian
    in the Russian Federation’s republic of Udmurtiya; it has existed in written form since
    the late 18th Century, and first appeared in its present Cyrillic orthography in 1905.
    The language has approximately 510,000 mother-tongue speakers, of whom 380,000
    (roughly three-quarters) live within Udmurtiya. These 380,000 constitute approximately
    one-quarter of the total population of Udmurtiya.
  }

  notes {
    note "Е should be romanized ‘ye’ word-initially, after a vowel, after Й, Ъ, Ь, and after the palatalizing consonants: Д, З, Л, Н, С and Т. It should be romanized ‘e’ elsewhere."
    note "In order to retain reversibility, where two consonant characters appear together and the resulting romanization is equivalent to a Roman-script digraph occurring in the system (i.e. gh, zh, tl, sh or ts), a medial dot may be employed between the Roman-script consonants in order to distinguish these from the Roman-script digraphs."
    note "An inventory of letter-diacritic combinations, with their Unicode encoding, in addition to the unmodified letters of the basic Roman script is:\n\nAll apostrophes appearing in romanization are U+2019\n\nÏ (U+00CF) ï (U+00EF)\nÖ (U+00D6) ö (U+00F6)"
    note "The Romanization column shows only lowercase forms but, when romanizing, uppercase and lowercase Roman letters as appropriate should be used."
  }
}

tests {
   "Удмуртия" ->  "Udmurtiya"
   "Ижевск" ->  "Izhevsk"
   "кенеш" ->  "kenyesh"
   "Ӟечбур" ->  "Jechbur"
   "Европа" ->  "Yevropa"
   "ӟеч" ->  "jech"
   "бадӟым" ->  "badjym"
   "ӵиж" ->  "tshizh"
   "ӝож" ->  "dzhozh"
   "дӥсь" ->  "dïs’"
   "кӧс" ->  "kös"
   "шунды" ->  "shundy"
   "нянь" ->  "nyan’"
   "ву" ->  "vu"
   "ки" ->  "ki"
   "одӥг" ->  "odïg"
   "кык" ->  "kyk"
   "куинь" ->  "kuin’"
   "ньыл" ->  "n’yl"
   "тон" ->  "ton"
   "мон" ->  "mon"
   "туж" ->  "tuzh"
   "объект" ->  "ob”yekt"
   "кое" ->  "koye"
   "тодон" ->  "todon"
   "театр" ->  "tyeatr"
}

aliases {
  udm_yetrigger = any("АаЕеЁёИиОоУуЫыЭэЮюЯяӦӧӤӥЙйЪъЬьДдЗзЛлНнСсТт")
}

stage main {

  # RULES
  # note[1]: ‘ye’ word-initially, after a vowel, after Й, Ъ, Ь, and after
  # the palatalizing consonants Д, З, Л, Н, С, Т; ‘e’ elsewhere
  sub {
    from "Е"
    to "YЕ"
    before udm_yetrigger
  }
  sub {
    from "Е"
    to "Yе"
    before boundary
  }
  sub {
    from "е"
    to "yе"
    before udm_yetrigger
  }
  sub {
    from "е"
    to "yе"
    before boundary
  }

  # CHARACTERS
  parallel {
    sub "А" "A"
    sub "а" "a"
    sub "Б" "B"
    sub "б" "b"
    sub "В" "V"
    sub "в" "v"
    sub "Г" "G"
    sub "г" "g"
    sub "Д" "D"
    sub "д" "d"
    sub "Е" "E"
    sub "е" "e"
    sub "Ё" "Yo"
    sub "ё" "yo"
    sub "Ж" "Zh"
    sub "ж" "zh"
    sub "Ӝ" "Dzh"
    sub "ӝ" "dzh"
    sub "З" "Z"
    sub "з" "z"
    sub "Ӟ" "J"
    sub "ӟ" "j"
    sub "И" "I"
    sub "и" "i"
    sub "Ӥ" "Ï"
    sub "ӥ" "ï"
    sub "Й" "Y"
    sub "й" "y"
    sub "К" "K"
    sub "к" "k"
    sub "Л" "L"
    sub "л" "l"
    sub "М" "M"
    sub "м" "m"
    sub "Н" "N"
    sub "н" "n"
    sub "О" "O"
    sub "о" "o"
    sub "Ӧ" "Ö"
    sub "ӧ" "ö"
    sub "П" "P"
    sub "п" "p"
    sub "Р" "R"
    sub "р" "r"
    sub "С" "S"
    sub "с" "s"
    sub "Т" "T"
    sub "т" "t"
    sub "У" "U"
    sub "у" "u"
    sub "Ф" "F"
    sub "ф" "f"
    sub "Х" "Kh"
    sub "х" "kh"
    sub "Ц" "Ts"
    sub "ц" "ts"
    sub "Ч" "Ch"
    sub "ч" "ch"
    sub "Ӵ" "Tsh"
    sub "ӵ" "tsh"
    sub "Ш" "Sh"
    sub "ш" "sh"
    sub "Щ" "Shch"
    sub "щ" "shch"
    sub "Ъ" "”"
    sub "ъ" "”"
    sub "Ы" "Y"
    sub "ы" "y"
    sub "Ь" "’"
    sub "ь" "’"
    sub "Э" "E"
    sub "э" "e"
    sub "Ю" "Yu"
    sub "ю" "yu"
    sub "Я" "Ya"
    sub "я" "ya"
  }
}
}
