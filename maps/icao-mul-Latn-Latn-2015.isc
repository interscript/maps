   "Þ" ->  "TH"
   "þ" ->  "th"
   "ß" ->  "ss"
   "Đ" ->  "D"
   "đ" ->  "d"
   "Ł" ->  "L"
   "ł" ->  "l"
   "Œ" ->  "OE"
   "œ" ->  "oe"
   "Ĳ" ->  "IJ"
   "ĳ" ->  "ij"
   "Š" ->  "S"
   "š" ->  "s"
   "Ž" ->  "Z"
   "ž" ->  "z"
}

