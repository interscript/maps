system "ICAO:mul-Latn:Latn:2015" {

metadata {
  authority_id icao
  id 9303
  language iso-639-2:mul
  source_script Latn
  destination_script Latn
  name "ICAO Doc 9303 Machine Readable Travel Documents Part 3 -- Transliteration of Multinational Latin-based Characters"
  url https://www.icao.int/publications/pages/publication.aspx?docnum=9303
  creation_date 2015
  description {    Part 3 defines specifications that are common to TD1, TD2 and TD3 size machine
    readable travel documents (MRTDs) including those necessary for global
    interoperability using visual inspection and machine readable (optical character
    recognition) means. Section A of the document's transliteration scheme renders
    the multinational Latin-based characters; this map carries that folding for
    Latin-script input. The document's per-language Cyrillic tables are separate
    maps.
  }

  notes {
    note "The source table gives some letters alternative renderings (a with diaeresis ae or a, a with ring aa or a, n with tilde n or nxx, o with diaeresis oe or o, u with diaeresis ue or u-variants); this map applies the primary expanded renderings (ae, aa, n, oe, ue) and documents the alternatives."
    note "The letter thorn renders th and the sharp s renders ss; the dotless i renders i; the ligatures ae and oe render as their two-letter expansions and ij as ij."
    note "Where a letter's uppercase and lowercase rows differ in the source (the sharp s appears in both), both renderings follow the source's letter values."
  }
}

tests {
   "À" ->  "A"
   "à" ->  "a"
   "Ä" ->  "AE"
   "ä" ->  "ae"
   "Å" ->  "AA"
   "å" ->  "aa"
   "Æ" ->  "AE"
