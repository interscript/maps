    sub "ใญ" "yai"
    sub "ใฎ" "dai"
    sub "ใฏ" "tai"
    sub "ใฑ" "thai"
    sub "ใฒ" "thai"
    sub "ใด" "dai"
    sub "ใต" "tai"
    sub "ใฐ" "thai"
    sub "ใถ" "thai"
    sub "ใท" "thai"
    sub "ใธ" "thai"
    sub "ใณ" "nai"
    sub "ใน" "nai"
    sub "ใบ" "bai"
    sub "ใป" "pai"
    sub "ใผ" "phai"
    sub "ใพ" "phai"
    sub "ใภ" "phai"
    sub "ใฝ" "fai"
    sub "ใฟ" "fai"
    sub "ใม" "mai"
