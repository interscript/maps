system "ALA-LC:sin-Sinh:Latn:1997" {

metadata {
  authority_id alalc
  id 1997
  language iso-639-2:sin
  source_script Sinh
  destination_script Latn
  name Romanization Table -- Sinhalese (1997)
  url http://catdir.loc.gov/catdir/cpso/romanization/sinhales.pdf
  creation_date 1997
  description {    ALA-LC Romanization table for Sinhalese
  }

  notes {

    note "Only the vowel forms that appear at the beginning of a syllable are listed; the forms used for\n vowels following a consonant can be found in grammars; no distinction between the two is\n made in transliteration."

    note "      The vowel a is implicit after all consonants and consonant clusters and is supplied in\n      transliteration, with the following exceptions:\n\n      a) when another vowel is indicated by its appropriate sign; and\n      b) when the absence of any vowel is indicated by the sign ් called virāma."

    note "      Exceptions: Anusvāra is transliterated by:\n\n      a) ṅ before gutturals,\n      b) ñ before palatals,\n      c) ṇ before cerebrals,\n      d) n before dentals, and\n      e) m before labials."

    note "      Exceptions:\n      a) when saññaka represents a nasal, it is romanized according to the rule for anusvāra.\n      b) when saññaka is combined with an aspirated consonant, the combination is romanized as a non-aspirated, followed by an aspirated consonant."
  }
}

tests {
   "ශී‍්‍ර ලංකාවේ කී‍්‍රඩාව ඉතිහාසයේ ඉහළම තැනකට ගේන්න කටයුතු කරනවා" ->  "śīra laṃkāvē kīraḍāva itihāsayē ihaḷama tănakaṭa gēnanna kaṭayutu karanavā"
   "කොච්චිකඬේ මෝයකට අසල නෑමට ගිය තරුණයෝ ෩ක් මරුට - මිතුරාගේ උපන් දිනය සැමරීමට ඇවිත්" ->  "kocañcikaṇḍē mōyakaṭa asala nâmaṭa giya taruṇayō 3k maruṭa - miturāgē upan dinaya sămarīmaṭa ăvit"
   "ලෝක ළමා දිනයදා සිසුන් පිරිසක් කසිප්පු බීලා" ->  "lōka ḷamā dinayadā sisun pirisak kasippu bīlā"
   "කෝටි 16ක හෙරොයින් සමග දන්කොටුවේදී 7ක් දැලේ" ->  "kōṭi 16ka heroyin samaga danaṅkoṭuvēdī 7k dălē"
   "මිනුවන්ගොඩ පීසීආර් දෙදහසක් සිදුකරයි" ->  "minuvanaṅgoḍa pīsīār dedahasak sidukarayi"
   "පාස්කු ප‍්‍රහාරය වගේම පාස්කු ප්‍රෝඩාව ගැනත් සොයන්න කොමිසමක් පත්කළ යුතුයි - විපක්‍ෂ නායක සජිත් පේ‍්‍රමදාස" ->  "pāsaṅku parahāraya vagēma pāsaṅku prōḍāva gănat soyananna komisamak pataṅkaḷa yutuyi - vipakṣa nāyaka sajit pēramadāsa"
   "ට‍්‍රම්ප්ගේ සෞඛ්‍යය තීරණාත්මකයි - ට්විටර් හරහා ජනතාව අමතයි" ->  "ṭarampaṅgē saukhyaya tīraṇātmakayi - ṭviṭar harahā janatāva amatayi"
   "පාස්කු දා ප‍්‍රහාරය පිළිබඳ පරීක්‍ෂණවලින් කිසිවකුට අසාධාරණයක් වීමට ඉඩ දෙන්නේ නෑ - අගමැති" ->  "pāsaṅku dā parahāraya piḷibanda parīkṣaṇavalin kisivakuṭa asādhāraṇayak vīmaṭa iḍa denannē nâ - agamăti"
   "දිල්ලි කැපිටල්ස් සහ කෝලිගේ බැංගලෝර් තෙවැනි ජය ලබයි" ->  "dilli kăpiṭals saha kōligē băṃgalōr tevăni jaya labayi"
   "ශ‍්‍රී ලාංකික සම්භවයක් සහිත ප‍්‍රංශයේ පවුලක 5 ක් ඝාතනය කරලා" ->  "śarī lāṃkika sambhavayak sahita paraṃśayē pavulaka 5 k ghātanaya karalā"
   "පැතිකුදය ඉක්මනින් සුව කරන ප‍්‍රතිකාර" ->  "pătikudaya ikmanin suva karana paratikāra"
}

aliases {
  sinh_chars_1 = any("\u0dcf\u0dd0\u0dd1\u0dd2\u0dd3\u0dd4\u0dd6\u0dd8\u0df2\u0ddf\u0df3\u0dd9\u0dda\u0ddb\u0ddc\u0ddd\u0dde\u0dca")
}

stage main {

  # RULES
  # note[3]
    sub {
    from "\u0DCA"
    to "ṅ"
    after any("කඛගඝඞ")
  }
    sub {
    from "\u0DCA"
    to "ñ"
    after any("චඡජඣඤ")
  }
    sub {
    from "\u0DCA"
    to "ṇ"
    after any("ටඨඩඪණ")
  }
    sub {
    from "\u0DCA"
    to "n"
    after any("තථදධන")
  }

  # note[2(a,b)]
    sub {
    from "ක"
    to "k"
    after sinh_chars_1
  }
    sub {
    from "ඛ"
    to "kh"
    after sinh_chars_1
  }
    sub {
    from "ග"
    to "g"
    after sinh_chars_1
