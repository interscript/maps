    sub {
    from "ට"
    to "ṭ"
    after sinh_chars_1
  }
    sub {
    from "ඨ"
    to "ṭh"
    after sinh_chars_1
  }
    sub {
    from "ඩ"
    to "ḍ"
    after sinh_chars_1
  }
    sub {
    from "ඪ"
    to "ḍh"
    after sinh_chars_1
  }
    sub {
    from "ණ"
    to "ṇ"
    after sinh_chars_1
  }
    sub {
    from "ත"
    to "t"
    after sinh_chars_1
  }
    sub {
    from "ථ"
    to "th"
    after sinh_chars_1
  }
    sub {
    from "ද"
    to "d"
    after sinh_chars_1
  }
    sub {
    from "ධ"
    to "dh"
    after sinh_chars_1
  }
    sub {
    from "න"
    to "n"
    after sinh_chars_1
  }
    sub {
    from "ප"
    to "p"
    after sinh_chars_1
  }
    sub {
    from "ඵ"
    to "ph"
    after sinh_chars_1
  }
    sub {
    from "බ"
    to "b"
    after sinh_chars_1
  }
    sub {
    from "භ"
    to "bh"
    after sinh_chars_1
  }
    sub {
    from "ම"
    to "m"
    after sinh_chars_1
  }
    sub {
    from "ය"
    to "y"
    after sinh_chars_1
  }
    sub {
    from "ර"
    to "r"
    after sinh_chars_1
  }
    sub {
    from "ල"
    to "l"
    after sinh_chars_1
  }
    sub {
    from "ළ"
    to "ḷ"
    after sinh_chars_1
  }
    sub {
    from "ව"
    to "v"
    after sinh_chars_1
  }
    sub {
    from "ශ"
    to "ś"
    after sinh_chars_1
  }
    sub {
    from "ෂ"
    to "ṣ"
    after sinh_chars_1
  }
    sub {
    from "ස"
    to "s"
    after sinh_chars_1
  }
    sub {
    from "හ"
    to "h"
    after sinh_chars_1
  }
    sub {
    from "ඟ"
    to "ṅg"
    after sinh_chars_1
  }
    sub {
    from "ඦ"
    to "ñj"
    after sinh_chars_1
  }
    sub {
    from "ඬ"
    to "ṇḍ"
    after sinh_chars_1
  }
    sub {
    from "ඳ"
    to "nd"
    after sinh_chars_1
  }
    sub {
    from "ඹ"
    to "ṃb"
    after sinh_chars_1
  }



  # CHARACTERS
  parallel {

    #Vowels and Diphthongs (see Note 1)

    sub "අ" "a"
    sub "ආ" "ā"
    sub "ඇ" "ă"
    sub "ඈ" "â"
    sub "ඉ" "i"
    sub "ඊ" "ī"
    sub "උ" "u"
    sub "ඌ" "ū"
    sub "ඍ" "ṛ"
    sub "ඎ" "ṝ"
    sub "ඏ" "ḷ"
    sub "ඐ" "ḹ"
    sub "එ" "e"
    sub "ඒ" "ē"
    sub "ඓ" "ai"
    sub "ඔ" "o"
    sub "ඕ" "ō"
    sub "ඖ" "au"

    sub "ා" "ā"
    sub "ැ" "ă"
    sub "ෑ" "â"
    sub "ි" "i"
    sub "ී" "ī"
    sub "ු" "u"
    sub "ූ" "ū"
    sub "ෘ" "ṛ"
    sub "ෲ" "ṝ"
    sub "ෟ" "ḷ"
    sub "ෳ" "ḹ"
    sub "ෙ" "e"
    sub "ේ" "ē"
    sub "ෛ" "ai"
    sub "ො" "o"
    sub "ෝ" "ō"
    sub "ෞ" "au"


    # II. Consonants (see Note 2)
    # Gutturals
    sub "ක" "ka"
    sub "ඛ" "kha"
    sub "ග" "ga"
    sub "ඝ" "gha"
    sub "ඞ" "ṅa"


    # Palatals
    sub "ච" "ca"
    sub "ඡ" "cha"
    sub "ජ" "ja"
    sub "ඣ" "jha"
    sub "ඤ" "ña"


    # Cerebrals
    sub "ට" "ṭa"
    sub "ඨ" "ṭha"
    sub "ඩ" "ḍa"
    sub "ඪ" "ḍha"
    sub "ණ" "ṇa"


    # Dentals
    sub "ත" "ta"
    sub "ථ" "tha"
    sub "ද" "da"
    sub "ධ" "dha"
    sub "න" "na"


    # Labials
    sub "ප" "pa"
    sub "ඵ" "pha"
    sub "බ" "ba"
    sub "භ" "bha"
    sub "ම" "ma"


    # Semivowels
    sub "ය" "ya"
    sub "ර" "ra"
    sub "ල" "la"
    sub "ළ" "ḷa"
    sub "ව" "va"

    # Sibilants
    sub "ශ" "śa"
    sub "ෂ" "ṣa"
    sub "ස" "sa"

    # Aspirate
    sub "හ" "ha"


    # Visarga
    sub "ඃ" "ḥ"

    # Anusvāra (see Note 3)
    sub "ං" "ṃ"


    # numbers
    sub "\u0DE6" "0"
    sub "\u0DE7" "1"
    sub "\u0DE8" "2"
    sub "\u0DE9" "3"
    sub "\u0DEA" "4"
    sub "\u0DEB" "5"
    sub "\u0DEC" "6"
    sub "\u0DED" "7"
    sub "\u0DEE" "8"
    sub "\u0DEF" "9"


    sub "‍" ""
    sub "‌" ""
    sub "්" ""

    # Rule no 4
    sub "ඟ" "ṅga"
    sub "ඦ" "ñja"
    sub "ඬ" "ṇḍa"
    sub "ඳ" "nda"
    sub "ඹ" "ṃba"
  }

  compose
}

}
