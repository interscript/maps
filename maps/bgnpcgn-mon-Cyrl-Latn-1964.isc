system "BGN-PCGN:mon-Cyrl:Latn:1964" {

metadata {
  authority_id bgnpcgn
  id 1964
  language iso-639-2:mon
  source_script Cyrl
  destination_script Latn
  name Romanization of Mongolian (1964)
  url https://github.com/interscript/interscript/files/5180767/BGN_Romanization_Guide_1964_mongolian_1964.pdf
  creation_date 1964
  confirmation_date 1964
  description {    This system was originated by the PCGN in 1957 and adopted as a
    BGN/PCGN System in 1964. It is intended for use in the romanization of
    geographic names in the "Mongolian People's Republic" but not to romanize
    Mongolian names in adjacent parts of China and the U.S.S.R.
  }

  notes {
    note "    - b occurs initially and after л, м, and б.\n    - v occurs medially in Mongolian words and initially in foreign words.\n    - y occurs only as the second element of diphthongs.\n    - k, p, f, and shch occurs foreign words only.\n    - \"\\u2019\" occurs only in Russion words.\n    - ï occurs only in suffixes to words containing back vowels (a, o, and u).\n    - In monosyllables yu or yü depending on pronunciation; in polysyllables yu when followed by a, o, or u, but yü when followed by i, e, ö, or ü."
  }
}

tests {
   "Эрдэнэт Сум" ->  "Erdenet Sum"
   "Эрдэнэт" ->  "Erdenet"
   "Эрдэнэ" ->  "Erdene"
   "Шивээговь Сум" ->  "Shiveegovĭ Sum"
   "Шивээговь" ->  "Shiveegovĭ"
   "Шарынгол Сум" ->  "Sharïngol Sum"
   "Шарынгол" ->  "Sharïngol"
   "Цагааннуур" ->  "Tsagaannuur"
   "Хонгор Сум" ->  "Hongor Sum"
   "Хонгор" ->  "Hongor"
   "Хайлаастай" ->  "Haylaastay"
   "Түнэл Сум" ->  "Tünel Sum"
   "Түнэл" ->  "Tünel"
   "Сүхбаатар" ->  "Sühbaatar"
   "Сүмбэр Сум" ->  "Sümber Sum"
   "Сүмбэр" ->  "Sümber"
   "Сайншанд Сум" ->  "Saynshand Sum"
   "Сайншанд" ->  "Saynshand"
   "Орхон Сум" ->  "Orhon Sum"
   "Орхон" ->  "Orhon"
   "Нарст" ->  "Narst"
   "Мөрөн Сум" ->  "Mörön Sum"
   "Мөрөн" ->  "Mörön"
   "Зүүнхөвөө" ->  "Dzüünhövöö"
   "Жаргалант Сум" ->  "Jargalant Sum"
   "Жаргалант" ->  "Jargalant"
   "Дархан Сум" ->  "Darhan Sum"
   "Даланзадгад Сум" ->  "Dalandzadgad Sum"
   "Даланзадгад" ->  "Dalandzadgad"
   "Давст Сум" ->  "Davst Sum"
   "Давст" ->  "Davst"
   "Говьсүмбэр Сум" ->  "Govĭsümber Sum"
   "Говь" ->  "Govĭ"
   "Буга" ->  "Buga"
   "Бор-Өндөр Сум" ->  "Bor-Öndör Sum"
   "Бор-Өндөр" ->  "Bor-Öndör"
   "Баянхонгор" ->  "Bayanhongor"
   "Баянтал" ->  "Bayantal"
   "Баяндэлгэр Сум" ->  "Bayandelger Sum"
   "Баяндэлгэр" ->  "Bayandelger"
   "Баян-Өндөр Сум" ->  "Bayan-Öndör Sum"
   "Баруун-Урт Сум" ->  "Baruun-Urt Sum"
   "Баруун-Урт" ->  "Baruun-Urt"
   "Архуст" ->  "Arhust"
   "Арвайхээр Сум" ->  "Arvayheer Sum"
   "Арвайхээр" ->  "Arvayheer"
   "Есөнбулаг Сум" ->  "Yösönbulag Sum"
   "Ерөө Сум" ->  "Yöröö Sum"
   "Есөнзүйл Сум" ->  "Yösöndzüyl Sum"
   "Ноён Сум" ->  "Noyon Sum"
   "Родник Балянгийн-Булак" ->  "Rodnik Balyangiyn-Bulak"
   "Замын-Үүд Сум" ->  "Dzamïn-Üüd Sum"
   "Адаацаг Сум" ->  "Adaatsag Sum"
   "Чандмань Сум" ->  "Chandmanĭ Sum"
   "Хяргас Сум" ->  "Hyargas Sum"

  # Note: UN card expects "uls" to start with an uppercase letter, but that would break other tests
   "Монгол улс" ->  "Mongol uls"
   "Улаанбаатар" ->  "Ulaanbaatar"
}

stage main {

  # RULES
  sub {
    from "\u042e"
    to "Yu"
    after any("АаОоУу")
  }
  sub {
    from "\u044e"
    to "yu"
    after any("АаОоУу")
  }
  sub {
    from "\u042e"
    to "Yü"
    after any("ИиЭэӨөҮү")
  }
  sub {
    from "\u044e"
    to "yü"
    after any("ИиЭэӨөҮү")
  }


  # CHARACTERS
  parallel {
    sub "А" "A"
    sub "Б" "B"
    sub "В" "V"
    sub "Г" "G"
    sub "Д" "D"
    sub "Е" "Yö"
    sub "Ё" "Yo"
    sub "Ж" "J"
    sub "З" "Dz"
    sub "И" "I"
    sub "Й" "Y"
    sub "К" "K"
    sub "Л" "L"
    sub "М" "M"
    sub "Н" "N"
    sub "О" "O"
    sub "Ө" "Ö"
    sub "П" "P"
    sub "Р" "R"
    sub "С" "S"
    sub "Т" "T"
    sub "У" "U"
    sub "Ү" "Ü"
    sub "Ф" "F"
    sub "Х" "H"
    sub "Ц" "Ts"
    sub "Ч" "Ch"
    sub "Ш" "Sh"
    sub "Щ" "Shch"
    sub "Ъ" "’"
    sub "Ы" "Ï"
    sub "Ь" "Ĭ"
    sub "Э" "E"
    sub "Ю" "Yu"
    sub "Я" "Ya"
    sub "а" "a"
    sub "б" "b"
    sub "в" "v"
    sub "г" "g"
    sub "д" "d"
    sub "е" "yö"
    sub "ё" "yo"
    sub "ж" "j"
    sub "з" "dz"
    sub "и" "i"
    sub "й" "y"
    sub "к" "k"
    sub "л" "l"
    sub "м" "m"
    sub "н" "n"
    sub "о" "o"
    sub "ө" "ö"
    sub "п" "p"
    sub "р" "r"
    sub "с" "s"
    sub "т" "t"
    sub "у" "u"
    sub "ү" "ü"
    sub "ф" "f"
    sub "х" "h"
    sub "ц" "ts"
    sub "ч" "ch"
    sub "ш" "sh"
    sub "щ" "shch"
    sub "ъ" "’"
    sub "ы" "ï"
    sub "ь" "ĭ"
    sub "э" "e"
    sub "ю" "yu"
    sub "я" "ya"
  }

}
}
