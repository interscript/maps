system "UN:srp-Cyrl:Latn:1997" {

metadata {
  authority_id un
  id 1997
  language iso-639-2:srp
  source_script Cyrl
  destination_script Latn
  name Romanization of Serbian (1977)
  url http://www.eki.ee/wgrs/rom1_sr.htm
  creation_date 1997
  description {    The United Nations recommended system was approved in 1977 (III/11), based on the Roman equivalent of the Serbo-Croatian Cyrillic alphabet that had long been employed in official gazetteers and maps of Yugoslavia. The table was published as an annex to the resolution1. The term relating to the language (Serbian instead of Serbo-Croatian) was modified in 2002 (resolution VIII/14).
    The system is used in Serbia, Montenegro, and Bosnia and Herzegovina. It is also used in international cartographic products.
    Serbian uses the Cyrillic script that is alphabetic. The romanization table is unambiguous and can be applied automatically. The system is reversible.
  }

  notes {
    note "Diffed against the UN Romanization of Serbian for Geographical Names (1977)\n table as published in the WGRS Report on the Current Status of UN Romanization\n Systems for Geographical Names, version 4.0 (March 2016)\n (eki.ee/wgrs/rom1_sr.htm; also unstats wgrr4serbian): all 30 rows verified\n against the system's stage rules; no gaps, no divergences."

    note "The system was approved in 1977 (res. III/11); the name previously read\n 'Serbo-Crotian (1972)' — the language term was changed from Serbo-Croatian to\n Serbian by res. VIII/14 (2002). The id/filename year 1997 predates this diff\n and is retained."

    note "The base rows are encoded through dependency alalc-srp-Cyrl-Latn-2013, whose\n parallel table is row-for-row identical to the UN 1977 Serbian table."
  }
}

tests {
   "Шупља Стена" ->  "Šuplja Stena"
   "Чукарица" ->  "Čukarica"
   "Црна Трава" ->  "Crna Trava"
   "Херцег Нови" ->  "Herceg Novi"
   "Улцињ" ->  "Ulcinj"
   "Ужице" ->  "Užice"
   "Тресаначка Река" ->  "Tresanačka Reka"
   "Сјеница" ->  "Sjenica"
   "Рожаје" ->  "Rožaje"
   "Пљевља" ->  "Pljevlja"
   "Оџаци" ->  "Odžaci"
   "Никшић" ->  "Nikšić"
   "Медвеђа" ->  "Medveđa"
   "Лозница" ->  "Loznica"
   "Књажевац" ->  "Knjaževac"
   "Зрењанин" ->  "Zrenjanin"
   "Житорађа" ->  "Žitorađa"
   "Ервеник" ->  "Ervenik"
   "Доње Љупче" ->  "Donje Ljupče"
   "Гусиње" ->  "Gusinje"
   "ГУСИЊЕ" ->  "GUSINJE"
   "Врњачка Бања" ->  "Vrnjačka Banja"
   "Бијело Поље" ->  "Bijelo Polje"
   "Алибунар" ->  "Alibunar"

  # UN card tests
   "Србија" ->  "Srbija"
   "Београд" ->  "Beograd"
}

dependency "alalc-srp-Cyrl-Latn-2013" as srpalatn

stage main {
  run  map.srpalatn.stage.main
}
}
