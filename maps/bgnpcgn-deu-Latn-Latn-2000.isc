system "BGN-PCGN:deu-Latn:Latn:2000" {

metadata {
  authority_id bgnpcgn
  id 2000
  language iso-639-2:deu
  source_script Latn
  destination_script Latn
  name Roman-Script Spelling Convention of German (2000 Agreement)
  url https://assets.publishing.service.gov.uk/government/uploads/system/uploads/attachment_data/file/693794/ROMAN-SCRIPT_SPELLING_CONVENTIONS.pdf
  creation_date 2000

  notes {
    note "      The special letter β, known as eszett, [Unicode: 03B2] is a standard letter of the German alphabet and occurs\n      only in word-medial and word-final positions. It is a lowercase letter only, and when a word and/or a name is\n      written entirely in uppercase letters, it is always rendered as SS. As a result of the orthographic reform of\n      German, implemented in August 1998, the β is now rendered ss if it follows a short vowel, but it is still used\n      if it follows a long vowel or a diphthong. In those instances where β cannot be reproduced, the digraph ss\n      may be substituted for it. For alphabetization and sorting purposes, β should be treated as ss."
    note "      In those instances when the vowel letters ä [Unicode: 00E4], ö [Unicode: 00F6], and ü [Unicode: 00FC]\n      cannot be reproduced, the alternate spellings ae, oe, and ue may be substituted."
  }
}

tests {
   "Dein weiβes Fleisch erregt mich so" ->  "Dein weisses Fleisch erregt mich so"
   "GROβSTÄDTE" ->  "GROSSSTAEDTE"
   "Göttingen" ->  "Goettingen"
   "Gütersloh" ->  "Guetersloh"
   "Mährisch-Ostrau" ->  "Maehrisch-Ostrau"
}

dependency "posix"

stage main {

  # RULES
  sub {
    from "β" + capture(upper)
    to "SS" + ref(1)
    before any(upper)
  }
  sub {
    from "Ä" + capture(upper)
    to "AE" + ref(1)
    before any(upper)
  }
  sub {
    from "Ö" + capture(upper)
    to "OE" + ref(1)
    before any(upper)
  }
  sub {
    from "Ü" + capture(upper)
    to "UE" + ref(1)
    before any(upper)
  }

  # CHARACTERS
  parallel {
    sub "Ä" "Ae"
    sub "Ö" "Oe"
    sub "Ü" "Ue"

    sub "ä" "ae"
    sub "ö" "oe"
    sub "ü" "ue"

    sub "β" "ss"
  }

}

}
