  "۹" -> "9"
}

stage main {
  # 4.4.4 the Allah word: one strict row over hex 0627 0644 0644 0651 0670 0647
  sub "اللّٰه" "Allāh"
  # Table 5 row 1: ezafe, he plus hamze above (hex 0647+0654)
  sub "هٔ" "hʼ"
  # Table 1 note d: the clarity variant, yeh plus superscript alef
  # (hex 06CC+0670), is transliterated y-acute (hex 00FD) in the strict system
  sub "یٰ" "ý"

  # Table 1 consonants (rows 1-32)
  parallel {
    sub "ا" "ā"
    sub "ب" "b"
    sub "پ" "p"
    sub "ت" "t"
    sub "ث" "s̱"
    sub "ج" "j"
    sub "چ" "č"
    sub "ح" "ḥ"
    sub "خ" "x"
    sub "د" "d"
    sub "ذ" "ẕ"
    sub "ر" "r"
    sub "ز" "z"
    sub "ژ" "ž"
    sub "س" "s"
    sub "ش" "š"
    sub "ص" "ṣ"
    sub "ض" "z̤"
    sub "ط" "ṭ"
    sub "ظ" "ẓ"
    sub "ع" "ʻ"
    sub "غ" "ġ"
    sub "ف" "f"
    sub "ق" "q"
    sub "ک" "k"
    sub "گ" "g"
    sub "ل" "l"
    sub "م" "m"
    sub "ن" "n"
    sub "و" "v"
    sub "ه" "h"
    sub "ی" "y"

    # Table 2 vowels for the fully reversible system (rows 1-4)
    sub "آ" "â"
    sub "َ" "a"
    sub "ُ" "o"
    sub "ِ" "e"

    # Table 3 conventional signs: tashdid and the three tanvin marks
    sub "ّ" "ʺ"
    sub "ً" "ã"
    sub "ٍ" "ẽ"
    sub "ٌ" "õ"

    # 4.4.3 ta marbuta per ISO 233 (Arabic)
    sub "ة" "ẗ"

    # Table 4 hamze forms (rows 1-4)
    sub "ء" "ʼ"
    sub "أ" "āʼ"
    sub "ؤ" "vʼ"
    sub "ئ" "yʼ"

    # Table 6 punctuation marks (rows 1-3)
    sub "،" ","
    sub "؛" ";"
    sub "؟" "?"

    # Table 7 Persian numerals (rows 1-10)
    sub "۰" "0"
    sub "۱" "1"
    sub "۲" "2"
    sub "۳" "3"
    sub "۴" "4"
    sub "۵" "5"
    sub "۶" "6"
    sub "۷" "7"
    sub "۸" "8"
    sub "۹" "9"
  }

}

