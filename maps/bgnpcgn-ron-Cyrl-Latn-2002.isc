    to "Ce"
    after any("а")
  }
  sub {
    from "\u0447"
    to "ce"
    after any("Аа")
  }

  # note[3]
  sub {
    from "\u042C"
    to "I"
    after boundary
  }
  sub {
    from "\u044C"
    to "i"
    after boundary
  }


  # CHARACTERS
