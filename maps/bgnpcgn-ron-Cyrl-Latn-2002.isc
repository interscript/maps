    to "gh"
    after any("ЕеИиЙйЮю")
  }
  sub {
    from "\u041A"
    to "Ch"
    after any("ЕеИиЙйЮю")
  }
  sub {
    from "\u043A"
    to "ch"
    after any("ЕеИиЙйЮю")
  }
  sub {
