system "ALA-LC:mya-Mymr:Latn:2011" {

metadata {
  authority_id alalc
  id 2011
  language iso-639-2:mya
  source_script Mymr
  destination_script Latn
  name "Burmese Romanization Table (2011)"
  url https://www.loc.gov/catdir/cpso/romanization/burmese.pdf
  creation_date 2011
  adoption_date
  description {    ALA-LC Burmese Romanization Table, 2011 version. Consonants carry
    the Indic values with the inherent vowel a (Devanagari-style); the
    asa/virama closes the syllable with an ʻ; medials y r v h romanize
    between the consonant and its vowel in the order y-or-r, then v,
    then h; anusvara ṃ; the dot-below and visarga tone marks romanize
    ʹ and ʺ. Modified conjunct ligatures are visual only — Unicode
    text spells the sequences, so no special rows are needed.
    Transcribed from the loc.gov document's text layer.
  }

  notes {
    note "Word division: a space after each syllable is applied by the
    caller per the table's word-division section. Abbreviation signs
    e* r* n* l* included."
    note "Wa letter and wa hswe both romanize v: the consonant table
    gives ဝ = va and the medial table gives ွ = v (the 1997 table's w
    is superseded). Bare medial syllables take the inherent a per
    Note 2, as in the medial table's own examples (myha, krva, lvha,
    mrvhaṅʻʺ); rows are enumerated for the ten medial orders y/r - v -
    h. Embedded-test inputs are the table's own examples: krva is the
    medial table's example, lvhā its lvha with the aa sign, and
    upusʻ the word-division example ဥပုသ် (the earlier test
    spellings ကြဝာ, လွီဗှာ and ဥပုစ် were transcription slips)."
  }
}

tests {
   "\u1019\u103d" ->  "mva"
   "\u1000\u103c\u103d" ->  "krva"
   "\u101c\u103d\u103e\u102c" ->  "lvhā"
   "\u1015\u102d\u102f\u1037" ->  "puiʹ"
   "\u1015\u102d\u102f\u1038" ->  "puiʺ"
   "\u1025\u1015\u102f\u101e\u103a" ->  "upusʻ"
}

stage main {

  parallel {
  # BARE MEDIAL SYLLABLES (Medials, page 2: "Medials are written in
  # the order y or r - v - h; for example: myha, krva, lvha,
  # mrvhaṅʻʺ"): a medial with no vowel sign takes the inherent a
  # (Note 2). Rows sit beside the signed medial series above.
