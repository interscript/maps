system "ISO:heb-Hebr:Latn:259-1984" {

metadata {
  authority_id iso
  id 259-1984
  language iso-639-2:heb
  source_script Hebr
  destination_script Latn
  name "ISO 259:1984 Documentation -- Transliteration of Hebrew characters into Latin characters"
  url https://www.iso.org/standard/4161.html
  creation_date 1984
  description {    Establishes the system for the transliteration of Hebrew characters into Latin
    characters, following the principles of stringent conversion (full rendering of the
    consonants and their diacritics). First edition 1984-10-01, prepared by ISO/TC 46;
    cancels and replaces ISO/R 259:1962. This map encodes Table 1, the consonant table
    (43 rows), together with the notes to the table (geresh and gershayim abbreviation
    handling). The vocalized Table 2 of the standard is not part of this consonantal
    encoding.
  }

  notes {
    note "Clause 0.3.3: one constant character per letter; final forms take their letter's row and Table 1 has no final-form rows. Table 2 (vowel signs, rows 44-59) is the vocalized extension and is out of scope of this consonantal map: Hebrew vowel signs (U+05B0-U+05BB), the teamim (U+0591-U+05AF), meteg (U+05BD), rafe (U+05BF), upper dot (U+05C4), lower dot (U+05C5), qamats qatan (U+05C7) and residual dagesh (U+05BC), shin dot (U+05C1) and sin dot (U+05C2) marks are deleted from the input, giving the consonantal skeleton."
    note "Dagesh lene, mappiq and shuruq render as the Annex A dot above (Annex code 4/7) on rows 3, 5, 7, 9, 11, 13, 16, 18, 20, 22, 24, 26, 28, 31, 33, 35, 39, 41 and 43; on rows 16 and 33 the dot above stacks over the dot below of the base output. Row 38 is a typographic variant of row 37 (one Unicode sequence U+05E9 U+05C1, raised caron) and maps identically to row 37."
    note "Notes to the table: geresh U+05F3 renders as U+02B9 (notes 1.1 and 2.1, the abbreviation geresh); gershayim U+05F4 renders as U+02BA (note 2.2; the Hebrew placement between the last two letters of the abbreviation is preserved by pass-through); the period passes through unchanged (note 2.3). Letters carrying geresh for foreign phonemes (note 1.1) render as their Table 1 letter plus U+02B9: gimel-geresh, zayin-geresh and tsadi-geresh, per note 1.2 (table letter + original mark); the printed glyph of the tsadi-geresh value is ambiguous in the source scan, note 1.2's rule text supports U+1E63 + U+02B9. The print's unpointed example readings Gʹin / Zʹan treat yod and alef as vowel bearers, which belongs to the vocalization this consonantal map does not encode; this map renders the Table 1 rows strictly (g + U+02B9 + y + n; z + U+02B9 + alef + n)."
    note "Unpointed shin U+05E9 renders as shin with sin dot (row 37, U+0161). Alphabetic Presentation Forms equal to their decompositions (U+FB2A-U+FB2D and the point-bearing letter forms U+FB30-U+FB3C, U+FB3E, U+FB40, U+FB41, U+FB43, U+FB44, U+FB46-U+FB4E) are accepted as input and render by their Table 1 rows; the rafe forms U+FB4C, U+FB4D and U+FB4E render as the bare letter (Table 1 has no rafe row). Composed letter+vowel forms and the alef-lamed ligature U+FB4F are out of scope and pass through."
    note "Mark-order normalization moves dagesh and the shin/sin dots next to their base letter (canonical combining order places the vowel signs first). Letter-first legacy stacks and canonical NFC stacks are fully handled; a fully non-canonical stack (vowel, shin dot, dagesh) may leave the dagesh unrendered. Maqaf U+05BE, paseq U+05C0, sof pasuq U+05C3, nun hafukha U+05C6 and the Hebrew ligatures U+05F0-U+05F2 are outside the standard's tables and pass through unchanged."
    note "Encoded from the E- and F-edition prints of ISO 259:1984; the Table 1 cell readings were adjudicated against the Annex A diacritical-sign code positions (informative annex)."
  }
}

tests {
  # Table 1, consonant rows (the standard's row numbering)
   "א" ->  "ʾ̲"
   "ב" ->  "b"
   "בּ" ->  "ḃ"
   "ג" ->  "g"
   "גּ" ->  "ḡ"
   "ד" ->  "d"
   "דּ" ->  "ḋ"
   "ה" ->  "h"
   "הּ" ->  "ḣ"
   "ו" ->  "w"
   "וּ" ->  "ẇ"
   "ז" ->  "z"
   "זּ" ->  "ż"
   "ח" ->  "ḥ"
   "ט" ->  "ṭ"
   "טּ" ->  "ṭ̇"
   "י" ->  "y"
   "יּ" ->  "ẏ"
   "כ" ->  "k"
   "כּ" ->  "k̇"
   "ל" ->  "l"
   "לּ" ->  "l̇"
   "מ" ->  "m"
   "מּ" ->  "ṁ"
   "נ" ->  "n"
   "נּ" ->  "ṅ"
   "ס" ->  "s"
   "סּ" ->  "ṡ"
   "ע" ->  "ʿ̲"
   "פ" ->  "p"
   "פּ" ->  "ṗ"
   "צ" ->  "ṣ"
   "צּ" ->  "ṩ"
   "ק" ->  "q"
   "קּ" ->  "q̇"
   "ר" ->  "r"
   "שׁ" ->  "š"
  # row 38, the raised-caron typographic variant, is the same sequence as row 37
   "שּׁ" ->  "ṧ"
   "שּׁ" ->  "ṧ"
   "ש" ->  "š"
   "שׂ" ->  "ś"
   "שּׂ" ->  "ṥ"
   "שּׂ" ->  "ṥ"
   "ת" ->  "t"
   "תּ" ->  "ṫ"
  # final forms, clause 0.3.3 (the letter's constant character)
   "ך" ->  "k"
   "ם" ->  "m"
   "ן" ->  "n"
   "ף" ->  "p"
   "ץ" ->  "ṣ"
  # mark-order normalization: canonical NFC stacks and legacy letter-first stacks
   "בַּ" ->  "ḃ"
   "בַּ" ->  "ḃ"
   "שָׁ" ->  "š"
   "שָּׁ" ->  "ṧ"
  # vocalized input renders the consonantal skeleton
   "בַיִת" ->  "byt"
   "תּוֹרָה" ->  "ṫwrh"
  # Alphabetic Presentation Forms, decomposition equivalents of the rows
   "שׁ" ->  "š"
   "שּׁ" ->  "ṧ"
   "שּׂ" ->  "ṥ"
   "בּ" ->  "ḃ"
   "הּ" ->  "ḣ"
   "וּ" ->  "ẇ"
   "וֹ" ->  "w"
   "בֿ" ->  "b"
  # notes to the table: the standard's own examples
  # the print shows sentence-initial capitals (Gʹin, Zʹan); this consonantal
  # map renders the Table 1 rows strictly, so unpointed mater letters keep
  # their consonant outputs (yod row 17 -> y, alef row 1 -> ʾ + low line);
  # the print's vowel readings come from the unencoded vocalization
   "ג׳ין" ->  "gʹyn"
   "ז׳אן" ->  "zʹʾ̲n"
   "פרופ׳" ->  "prwpʹ"
   "ק״מ" ->  "qʺm"
   "ד." ->  "d."
}

stage main {

  # MARK-ORDER NORMALIZATION
  # The canonical combining order places the vowel signs (ccc 10-20) before
  # the dagesh (ccc 21) and the shin/sin dots (ccc 24-25). Move the dots back
  # next to the letter so the letter+dot sequences of Table 1 match.
  sub {
    from "ְּ"
    to "ְּ"
  }
  sub {
    from "ְׁ"
    to "ְׁ"
  }
  sub {
    from "ְׂ"
    to "ְׂ"
  }
  sub {
    from "ֱּ"
    to "ֱּ"
  }
  sub {
    from "ֱׁ"
    to "ֱׁ"
  }
  sub {
    from "ֱׂ"
    to "ֱׂ"
  }
  sub {
    from "ֲּ"
    to "ֲּ"
  }
  sub {
    from "ֲׁ"
    to "ֲׁ"
  }
  sub {
    from "ֲׂ"
    to "ֲׂ"
  }
  sub {
    from "ֳּ"
    to "ֳּ"
  }
  sub {
    from "ֳׁ"
    to "ֳׁ"
  }
  sub {
    from "ֳׂ"
    to "ֳׂ"
  }
  sub {
    from "ִּ"
    to "ִּ"
  }
  sub {
    from "ִׁ"
    to "ִׁ"
  }
  sub {
    from "ִׂ"
    to "ִׂ"
  }
  sub {
    from "ֵּ"
    to "ֵּ"
  }
  sub {
    from "ֵׁ"
    to "ֵׁ"
  }
  sub {
    from "ֵׂ"
    to "ֵׂ"
  }
  sub {
    from "ֶּ"
    to "ֶּ"
  }
  sub {
    from "ֶׁ"
    to "ֶׁ"
  }
  sub {
    from "ֶׂ"
    to "ֶׂ"
  }
  sub {
    from "ַּ"
    to "ַּ"
  }
  sub {
    from "ַׁ"
    to "ַׁ"
  }
  sub {
    from "ַׂ"
    to "ַׂ"
  }
  sub {
    from "ָּ"
    to "ָּ"
  }
  sub {
    from "ָׁ"
    to "ָׁ"
  }
  sub {
    from "ָׂ"
    to "ָׂ"
  }
  sub {
    from "ֹּ"
    to "ֹּ"
  }
  sub {
    from "ֹׁ"
    to "ֹׁ"
  }
  sub {
    from "ֹׂ"
    to "ֹׂ"
  }
  sub {
    from "ֺּ"
    to "ֺּ"
  }
  sub {
    from "ֺׁ"
    to "ֺׁ"
  }
  sub {
    from "ֺׂ"
    to "ֺׂ"
  }
  sub {
    from "ֻּ"
    to "ֻּ"
  }
  sub {
    from "ֻׁ"
    to "ֻׁ"
  }
  sub {
    from "ֻׂ"
    to "ֻׂ"
  }
  sub {
    from "ּׁ"
    to "ּׁ"
  }
  sub {
    from "ּׂ"
    to "ּׂ"
  }

  # CHARACTERS
  parallel {
    # Table 1, rows 1-43 (the standard's row numbering; dagesh, mappiq and
    # shuruq rows render the Annex A dot above, code 4/7)
    sub "א" "ʾ̲"
    sub "בּ" "ḃ"
    sub "ב" "b"
    sub "גּ" "ḡ"
    sub "ג" "g"
    sub "דּ" "ḋ"
    sub "ד" "d"
    sub "הּ" "ḣ"
    sub "ה" "h"
    sub "וּ" "ẇ"
    sub "ו" "w"
    sub "זּ" "ż"
    sub "ז" "z"
    sub "ח" "ḥ"
    sub "טּ" "ṭ̇"
    sub "ט" "ṭ"
    sub "יּ" "ẏ"
    sub "י" "y"
    sub "כּ" "k̇"
    sub "כ" "k"
    sub "לּ" "l̇"
    sub "ל" "l"
    sub "מּ" "ṁ"
    sub "מ" "m"
    sub "נּ" "ṅ"
    sub "נ" "n"
    sub "סּ" "ṡ"
    sub "ס" "s"
    sub "ע" "ʿ̲"
    sub "פּ" "ṗ"
    sub "פ" "p"
    sub "צּ" "ṩ"
    sub "צ" "ṣ"
    sub "קּ" "q̇"
    sub "ק" "q"
    sub "ר" "r"
    # rows 37-41: shin and sin (row 38 is the raised-caron typographic
    # variant of row 37 and shares its sequence and output)
    sub "שּׁ" "ṧ"
    sub "שּׁ" "ṧ"
    sub "שׁ" "š"
    sub "שּׂ" "ṥ"
    sub "שּׂ" "ṥ"
    sub "שׂ" "ś"
    # unpointed shin reads as shin with sin dot (row 37)
    sub "ש" "š"
    sub "תּ" "ṫ"
    sub "ת" "t"
    # clause 0.3.3: final forms take their letter's rows
    sub "ךּ" "k̇"
    sub "ך" "k"
    sub "ם" "m"
    sub "ן" "n"
    sub "ףּ" "ṗ"
    sub "ף" "p"
    sub "ץ" "ṣ"
    # Alphabetic Presentation Forms, decomposition equivalents of the rows
    # (the rafe forms render as the bare letter: no Table 1 rafe row)
    sub "שׁ" "š"
    sub "שׂ" "ś"
    sub "שּׁ" "ṧ"
    sub "שּׂ" "ṥ"
    sub "אּ" "ʾ̲"
    sub "בּ" "ḃ"
    sub "גּ" "ḡ"
    sub "דּ" "ḋ"
    sub "הּ" "ḣ"
    sub "וּ" "ẇ"
    sub "זּ" "ż"
    sub "טּ" "ṭ̇"
    sub "יּ" "ẏ"
    sub "ךּ" "k̇"
    sub "כּ" "k̇"
    sub "לּ" "l̇"
    sub "מּ" "ṁ"
    sub "נּ" "ṅ"
    sub "סּ" "ṡ"
    sub "ףּ" "ṗ"
    sub "פּ" "ṗ"
    sub "צּ" "ṩ"
    sub "קּ" "q̇"
    sub "רּ" "r"
    sub "שּ" "š"
    sub "תּ" "ṫ"
    sub "וֹ" "w"
    sub "בֿ" "b"
    sub "כֿ" "k"
    sub "פֿ" "p"
    # notes to the table: geresh and gershayim (notes 1.1, 2.1, 2.2)
    sub "׳" "ʹ"
    sub "״" "ʺ"
    # vocalization and apparatus outside Table 1: the consonantal skeleton
    sub "ְ" ""
    sub "ֱ" ""
    sub "ֲ" ""
    sub "ֳ" ""
    sub "ִ" ""
    sub "ֵ" ""
    sub "ֶ" ""
    sub "ַ" ""
    sub "ָ" ""
    sub "ֹ" ""
    sub "ֺ" ""
    sub "ֻ" ""
    # residual dagesh (letters without a dagesh row: alef, het, resh)
    sub "ּ" ""
    sub "ֽ" ""
    sub "ֿ" ""
    sub "ׁ" ""
    sub "ׂ" ""
    sub "ׄ" ""
    sub "ׅ" ""
    sub "ׇ" ""
    # teamim (cantillation marks)
    sub "֑" ""
    sub "֒" ""
    sub "֓" ""
    sub "֔" ""
    sub "֕" ""
    sub "֖" ""
    sub "֗" ""
    sub "֘" ""
    sub "֙" ""
    sub "֚" ""
    sub "֛" ""
    sub "֜" ""
    sub "֝" ""
    sub "֞" ""
    sub "֟" ""
    sub "֠" ""
    sub "֡" ""
    sub "֢" ""
    sub "֣" ""
    sub "֤" ""
    sub "֥" ""
    sub "֦" ""
    sub "֧" ""
    sub "֨" ""
    sub "֩" ""
    sub "֪" ""
    sub "֫" ""
    sub "֬" ""
    sub "֭" ""
    sub "֮" ""
    sub "֯" ""
  }

}

}
