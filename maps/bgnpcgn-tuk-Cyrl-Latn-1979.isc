    sub "\u0448" "sh"
    sub "\u0449" "shch"
    sub {
    from "\u044A"
    to "\""
  }
    sub "\u044B" "y"
    sub "\u044C" "'"
    sub "\u044D" "e"
    sub "\u04D9" "ä"
    sub "\u044E" "yu"
    sub "\u044F" "ya"
  }
}}
