system "BGN-PCGN:isl-Latn:Latn:1964" {

metadata {
  authority_id bgnpcgn
  id 1964
  language iso-639-2:isl
  source_script Latn
  destination_script Latn
  name Transliteration of Icelandic (1947)
  url https://github.com/interscript/interscript/files/5180785/BGN_Romanization_Guide_1964_icelandic_1947.pdf
  creation_date 1964
  description {    The BGN and the PCGn in 1947 jointly agreed to the transliteration of two letters of the Icelandic alphabet which,
    although used in writing Old English, have disappeared from the modern English alphabet.

    The transliterated letters are the edh (Ð ð) and the thorn (Þ þ), pronounced as th in "thus" and th in "think," respectively.

    It was felt that it was better to transliterate these letters into familiar symbols than preserve such unfamiliar letters in the nomenclature.
  }

  notes {
    note "More about \"edh\" letter - https://en.wikipedia.org/wiki/Eth"
    note "More about \"thorn\" letter - https://en.wikipedia.org/wiki/Thorn_(letter)"
  }
}

tests {
   "Fyrirgefðu" ->  "Fyrirgefdhu"
   "þu ert velkominn" ->  "thu ert velkominn"
   "GOÐAN DAGINN" ->  "GODHAN DAGINN"
   "Þakka" ->  "Thakka"
}

stage main {

  # CHARACTERS
  parallel {
    sub "Ð" "Dh"
    sub "ð" "dh"
    sub "Þ" "Th"
    sub "þ" "th"
  }

  sub {
    from any(["Th", "Dh"])
    to upcase
    before any("A".."Z")
  }
  sub {
    from any(["Th", "Dh"])
    to upcase
    after any("A".."Z")
  }
}
}
