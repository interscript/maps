dependency "ua-ukr-Cyrl-Latn-1996" as cyrllatn


stage main {
  # RULES
  sub "\u0027" ""
  sub "\u2019" ""

  # CHARACTERS
  parallel {
    sub "Ґ" "G"
    sub "ґ" "g"
    sub "Щ" "Shch"
    sub "щ" "shch"
    sub "ь" ""
    sub "Ь" ""
    sub "'" ""
    sub "’" ""
  }

  run  map.cyrllatn.stage.main
}
}
