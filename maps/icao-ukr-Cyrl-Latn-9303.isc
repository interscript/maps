system "ICAO:ukr-Cyrl:Latn:9303" {

metadata {
  authority_id icao
  id 9303
  language iso-639-2:ukr
  source_script Cyrl
  destination_script Latn
  name ICAO Doc 9303 Machine Readable Travel Documents Part 3 -- Ukrainian Cyrillic to Latin
  url https://www.icao.int/publications/pages/publication.aspx?docnum=9303
  creation_date 2015
  description {    Part 3 defines specifications that are common to TD1, TD2 and TD3
    size machine readable travel documents (MRTDs) including those
    necessary for global interoperability using visual inspection and
    machine readable (optical character recognition) means.

    Since only Latin-alphabet characters are allowed in the VIZ, if
    mandatory data elements are in a national language that does not use
    the Latin alphabet, a transcription or transliteration shall also be
    provided.

    This document defines the transliteration mappings used to produce
    this transcription or transliteration.
  }

  notes {
    note "Diffed against ICAO Doc 9303 Part 3 Amd 1 (16/09/16), Section 6.B: the rows for Ќ, Ъ, Ѵ and Ғ were missing and were added with their source values. U+2019 right single quotation mark is now dropped alongside the ASCII apostrophe per Section 4.6 (apostrophes shall be omitted in the MRZ). The system name previously misspelled Ukrainian as Ukranian."
    note "Divergences corrected against the same source: Г was rendered G (and г g), but the source's row 0413 gives H for Ukrainian; И already rendered Y per row 0418. The lowercase rows for у, ю, ў and ѫ were emptied or truncated (to nothing and to i); the source gives У to U, Ю to IU, Ў to U and Ѫ to U regardless of case."
    note "NOT ENCODED -- word-initial renderings. The source requires special renderings when the Ukrainian character is the first character of the name: Є renders YE, Ї renders YI, Й renders Y, Ю renders YU and Я renders YA. These positional rules are not expressible as plain parallel substitutions, and the current Ruby ISC runtime drops before/not_before constraints (Interscript::Isc::NodeAdapter reads constraint :value while the DocumentBuilder emits :item), so they would silently never fire. Once the runtime materializes constraints, encode them as sub rules placed before the parallel block, for both cases: sub { from \"Є\" to \"YE\" before boundary not_before boundary + \"’\" } and likewise for Ї/YI, Й/Y, Ю/YU, Я/YA (mirroring origin/icao-9303)."
    note "The map carries a row for Ѓ (U+0403) to G, which has no row in the Amd 1 Section 6.B table (the table has Ғ, U+0492, to G); kept as a practical extension."
    note "Soft sign Ь has no row in the Amd 1 Section 6.B table and is left unmapped."
    note "The Amd 1 table prints row 04BA Һ (Cyrillic shha) as C; the map follows the source as printed, though C rather than H may be a source-side erratum."
  }
}

tests {
   "Г" ->  "H"
   "г" ->  "h"
   "И" ->  "Y"
   "и" ->  "y"
   "Й" ->  "I"
   "й" ->  "i"
   "Ї" ->  "I"
   "ї" ->  "i"
   "Є" ->  "IE"
   "є" ->  "ie"
   "Ґ" ->  "G"
   "ґ" ->  "g"
   "І" ->  "I"
   "і" ->  "i"
   "у" ->  "u"
   "ю" ->  "iu"
   "Ъ" ->  "IE"
   "ъ" ->  "ie"
   "Ѵ" ->  "Y"
   "ѷ" ->  "y"
   "Ғ" ->  "G"
   "ғ" ->  "g"
   "Ќ" ->  "K"
   "ќ" ->  "k"
   "Григоренко" ->  "Hryhorenko"
   "Тарас Шевченко" ->  "Taras SHevchenko"
   "’Ярослав" ->  "IAroslav"
}

# https://www.icao.int/publications/Documents/9303_p3_cons_en.pdf
stage main {

  # CHARACTERS
  parallel {
    sub "'" ""
    sub "’" ""
    sub "А" "A"
    sub "Б" "B"
    sub "Д" "D"
    sub "Ё" "E"
    sub "Е" "E"
    sub "Э" "E"
    sub "Ф" "F"
    sub "Г" "H"
    sub "И" "Y"
    sub "Й" "I"
    sub "К" "K"
    sub "Ќ" "K"
    sub "Л" "L"
    sub "М" "M"
    sub "Н" "N"
    sub "О" "O"
    sub "П" "P"
    sub "Р" "R"
    sub "С" "S"
    sub "Т" "T"
    sub "У" "U"
    sub "В" "V"
    sub "Ы" "Y"
    sub "З" "Z"
    sub "Ч" "CH"
    sub "Я" "IA"
    sub "Ю" "IU"
    sub "Х" "KH"
    sub "Ш" "SH"
    sub "Щ" "SHCH"
    sub "Ъ" "IE"
    sub "Ц" "TS"
    sub "Ж" "ZH"
    sub "Ґ" "G"
    sub "Ғ" "G"
    sub "Ў" "U"
    sub "Ѫ" "U"
    sub "Ѵ" "Y"
    sub "Ђ" "D"
    sub "Ѕ" "DZ"
    sub "Ј" "J"
    sub "Љ" "LJ"
    sub "Њ" "NJ"
    sub "Һ" "C"
    sub "Џ" "DZ"
    sub "Є" "IE"
    sub "Ї" "I"
    sub "Ѓ" "G"
    sub "І" "I"

    sub "а" "a"
    sub "б" "b"
    sub "д" "d"
    sub "ё" "e"
    sub "е" "e"
    sub "э" "e"
    sub "ф" "f"
    sub "г" "h"
    sub "и" "y"
    sub "й" "i"
    sub "к" "k"
    sub "ќ" "k"
    sub "л" "l"
    sub "м" "m"
    sub "н" "n"
    sub "о" "o"
    sub "п" "p"
    sub "р" "r"
    sub "с" "s"
    sub "т" "t"
    sub "у" "u"
    sub "в" "v"
    sub "ы" "y"
    sub "з" "z"
    sub "ч" "ch"
