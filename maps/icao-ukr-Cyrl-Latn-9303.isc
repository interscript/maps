    sub "ю" "iu"
    sub "х" "kh"
    sub "ш" "sh"
    sub "щ" "shch"
    sub "ъ" "ie"
    sub "ц" "ts"
    sub "ж" "zh"
    sub "ґ" "g"
    sub "ғ" "g"
    sub "ў" "u"
    sub "ѫ" "u"
    sub "ѷ" "y"
    sub "ђ" "d"
    sub "ѕ" "dz"
    sub "ј" "j"
    sub "љ" "lj"
    sub "њ" "nj"
    sub "һ" "c"
    sub "џ" "dz"
    sub "є" "ie"
    sub "ї" "i"
    sub "і" "i"
    sub "ѓ" "g"
  }

}

}
