system "BGN-PCGN:kat-Geor:Latn:1981" {

metadata {
  authority_id bgnpcgn
  id 1981
  language iso-639-2:kat
  source_script Geor
  destination_script Latn
  name Romanization of Georgian (1981)
  url https://transliteration.eki.ee/pdf/Georgian.pdf
  creation_date 1981
  confirmation_date 1981
  description {    BGN/PCGN system of 1981.
  }

  notes {
  }
}

tests {
   "ჰებუდი" ->  "hebudi"
   "ჯვრის წყალსაცავი" ->  "jvris tsqalsats’avi"
   "ჯვავიაკვარა" ->  "jvaviak’vara"
   "ჯობრია" ->  "jobria"
   "ძულუხირა" ->  "dzulukhira"
   "ლეკუხონა" ->  "lek’ukhona"
   "აბაშა" ->  "abasha"
   "ააცი" ->  "aats’i"
