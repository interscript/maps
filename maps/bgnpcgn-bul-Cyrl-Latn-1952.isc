system "BGN-PCGN:bul-Cyrl:Latn:1952" {

metadata {
  authority_id bgnpcgn
  id 1952
  language iso-639-2:bul
  source_script Cyrl
  destination_script Latn
  name Romanization of Bulgarian (1952)
  url https://libraries.ucsd.edu/bib/fed/USBGN_romanization.pdf
  creation_date 1945
  confirmation_date 1952
  description {    This system was adopted by the BGN in 1949 and by the PCGN in 1952. It
    reflects the much simplified Bulgarian orthography as officially revised in
    February 1945. The Bulgarian alphabet contains all of the characters present
    in the Russian alphabet with the exception of ё, ы, and э. Notes 1, 2, and 3
    are applicable to sources predating the orthographic reform of 1945.
  }

  notes {
    note "In modern Bulgarian orthography, the character ъ, does not occur in\n word-final position. It should be omitted in romanization when found in\n word-final position on older sources"
    note "The obsolete character ѫ, which was replaced by ъ in 1945, should be romanized ŭ"
    note "The obsolete character ѣ, replaced in 1945 by е or я according to local\n pronunciation, should be romanized as e or ya, accordingly, if the\n pronunciation is known; otherwise, as ye"
    note "The character sequence тс may be romanized t·s in order to differentiate\n that romanization from the regularly occurring digraph ts, which represents\n the character ц"
  }
}

tests {
   "София" ->  "Sofiya"
   "София-Град" ->  "Sofiya-Grad"
   "България" ->  "Bŭlgariya"
}

stage main {
  # RULES
  # note[1]
  sub {
    from "\u042a"
    to ""
    after boundary
  }
  sub {
    from "\u044a"
    to ""
    after boundary
  }
  # note[4]
  parallel {
    sub "ТС" "T·S"
    sub "Тс" "T·s"
    sub "тс" "t·s"
  }

  # CHARACTERS
  parallel {
    sub "\u0410" "A"
    sub "\u0411" "B"
    sub "\u0412" "V"
    sub "\u0413" "G"
    sub "\u0414" "D"
    sub "\u0415" "E"
    sub "\u0416" "Zh"
    sub {
    from "\u0416"
    to "ZH"
    after any("АБВГДЕЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЬЮЯ")
  }
    sub {
    from "\u0416"
    to "ZH"
    before any("АБВГДЕЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЬЮЯ")
  }
    sub "\u0417" "Z"
    sub "\u0418" "I"
    sub "\u0419" "Y"
    sub "\u041a" "K"
    sub "\u041b" "L"
    sub "\u041c" "M"
    sub "\u041d" "N"
    sub "\u041e" "O"
    sub "\u041f" "P"
    sub "\u0420" "R"
    sub "\u0421" "S"
    sub "\u0422" "T"
    sub "\u0423" "U"
    sub "\u0424" "F"
    sub "\u0425" "Kh"
    sub {
    from "\u0425"
    to "KH"
    after any("АБВГДЕЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЬЮЯ")
  }
    sub {
    from "\u0425"
    to "KH"
    before any("АБВГДЕЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЬЮЯ")
  }

    sub "\u0426" "Ts"
    sub {
    from "\u0426"
    to "TS"
    after any("АБВГДЕЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЬЮЯ")
  }
    sub {
    from "\u0426"
    to "TS"
    before any("АБВГДЕЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЬЮЯ")
  }

    sub "\u0427" "Ch"
    sub {
    from "\u0427"
    to "CH"
    after any("АБВГДЕЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЬЮЯ")
  }
    sub {
    from "\u0427"
    to "CH"
    before any("АБВГДЕЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЬЮЯ")
  }

    sub "\u0428" "Sh"
    sub {
    from "\u0428"
    to "SH"
    after any("АБВГДЕЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЬЮЯ")
  }
    sub {
    from "\u0428"
    to "SH"
    before any("АБВГДЕЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЬЮЯ")
  }

    sub "\u0429" "Sht"
    sub {
    from "\u0429"
    to "SHT"
    after any("АБВГДЕЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЬЮЯ")
  }
    sub {
    from "\u0429"
    to "SHT"
    before any("АБВГДЕЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЬЮЯ")
  }

    sub "\u042a" "Ŭ"
    sub "\u042c" "\\'"
    sub "\u042e" "Yu"
    sub {
    from "\u042e"
    to "YU"
    after any("АБВГДЕЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЬЮЯ")
  }
    sub {
    from "\u042e"
    to "YU"
    before any("АБВГДЕЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЬЮЯ")
  }

    sub "\u042f" "Ya"
    sub {
    from "\u042f"
    to "YA"
    after any("АБВГДЕЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЬЮЯ")
  }
    sub {
    from "\u042f"
    to "YA"
    before any("АБВГДЕЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЬЮЯ")
  }

    sub "\u0430" "a"
    sub "\u0431" "b"
    sub "\u0432" "v"
    sub "\u0433" "g"
    sub "\u0434" "d"
    sub "\u0435" "e"
    sub "\u0436" "zh"
    sub "\u0437" "z"
    sub "\u0438" "i"
    sub "\u0439" "y"
    sub "\u043a" "k"
    sub "\u043b" "l"
    sub "\u043c" "m"
    sub "\u043d" "n"
    sub "\u043e" "o"
    sub "\u043f" "p"
    sub "\u0440" "r"
    sub "\u0441" "s"
    sub "\u0442" "t"
    sub "\u0443" "u"
    sub "\u0444" "f"
    sub "\u0445" "kh"
    sub "\u0446" "ts"
    sub "\u0447" "ch"
    sub "\u0448" "sh"
    sub "\u0449" "sht"
    sub "\u044a" "ŭ"
    sub "\u044c" "\\'"
    sub "\u044e" "yu"
    sub "\u044f" "ya"

    # note 2
    sub "\u046A" "Ŭ"
    sub "\u046B" "ŭ"

    # note[3]
    sub "\u0462" "Ye"
    sub "\u0463" "ye"
  }
}
}
