    to "ᆺ" + ref( 1 )
  }

  # HANGUL JONGSEONG PHIEUPH
  sub {
    from "ᇁ" + kor_maybedash + "ᄋ"
    to "ᆸ" + ref( 1 ) + "ᄑ"
  }
  sub {
    from "ᇁ" + kor_maybedash
    to "ᆸ" + ref( 1 )
  }

  # HANGUL JONGSEONG HIEUH
  sub {
    from "ᇂ" + kor_maybedash + "ᄀ"
    to ref( 1 ) + "ᄏ"
  }
  sub {
    from "ᇂ" + kor_maybedash + "ᄃ"
    to ref( 1 ) + "ᄐ"
  }
  sub {
    from "ᇂ" + kor_maybedash + "ᄇ"
    to ref( 1 ) + "ᄑ"
  }
  sub {
