system "VAR:kor-Hang:Latn:mr-1939" {

metadata {
  authority_id var
  id mr-1939
  language iso-639-2:kor
  source_script Hang
  destination_script Latn
  name McCune-Reischauer System (Hangul-Latin)
  url 
  creation_date 1939
  adoption_date 
  description { E. O. Reischauer and G. M. McCune The Romanization of the Korean Language Based on Its Phonetic Structure. XXIX:1-55. Korea Branch of the Royal Asiatic Society. Volume XXIX (PDF) }
  notes {
    This file only handles Hangul to Latin.
  }
}

