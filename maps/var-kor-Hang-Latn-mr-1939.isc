dependency "var-kor-Hang-Hang-jamo" as hanghang

aliases {
  kor_beforeterm = any([any("A".."Z"), any("a".."z"), any("0".."9"), any("ᅡᅢᅣᅤᅥᅦᅧᅨᅩᅪᅫᅬᅭᅮᅯᅰᅱᅲᅳᅴᅵ")])

  kor_maybedash = capture(maybe("-"))
}

stage main {
  run  map.hanghang.stage.main

  # RULES


  # POSTRULES

  # Add space to the two ends of the string for easier word boundary handling
  sub line_start " "
  sub line_end " "

  # HANGUL JONGSEONG SSANGKIYEOK
  sub {
    from "ᆩ" + kor_maybedash + "ᄋ"
    to "ᆨ" + ref( 1 ) + "ᄁ"
  }
  sub {
    from "ᆩ" + kor_maybedash
    to "ᆨ" + ref( 1 )
  }

  # HANGUL JONGSEONG SSANGKIYEOK
  sub {
    from "ᆪ" + kor_maybedash + "ᄋ"
    to "ᆨ" + ref( 1 ) + "ᄉ"
  }
  sub {
    from "ᆪ" + kor_maybedash
    to "ᆨ" + ref( 1 )
  }

  # HANGUL JONGSEONG NIEUN-CIEUC
  sub {
    from "ᆬ" + kor_maybedash + "ᄋ"
    to "ᆫ" + ref( 1 ) + "ᄌ"
  }
  sub {
    from "ᆬ" + kor_maybedash
    to "ᆫ" + ref( 1 )
  }

  # HANGUL JONGSEONG NIEUN-CIEUC
  sub {
    from "ᆭ" + kor_maybedash + "ᄀ"
    to "ᆫ" + ref( 1 ) + "ᄏ"
  }
  sub {
    from "ᆭ" + kor_maybedash + "ᄃ"
    to "ᆫ" + ref( 1 ) + "ᄐ"
  }
  sub {
    from "ᆭ" + kor_maybedash + "ᄇ"
    to "ᆫ" + ref( 1 ) + "ᄑ"
  }
  sub {
    from "ᆭ" + kor_maybedash + "ᄌ"
    to "ᆫ" + ref( 1 ) + "ᄎ"
  }
  sub {
    from "ᆭ" + kor_maybedash
    to "ᆫ" + ref( 1 )
  }

  # HANGUL JONGSEONG TIEUT
  sub {
    from "ᆮ" + kor_maybedash
    to "ᆺ" + ref( 1 )
    after any("ᄀᄁᄂᄃᄄᄅᄆᄇᄈᄉᄊᄌᄍᄎᄏᄐᄑᄒ")
  }

  # HANGUL JONGSEONG RIEUL-SIOS
  sub {
    from "ᆳ" + kor_maybedash + "ᄋ"
    to "ᆯ" + ref( 1 ) + "ᄉ"
  }
  sub {
    from "ᆳ" + kor_maybedash
    to "ᆯ" + ref( 1 )
  }

  # HANGUL JONGSEONG RIEUL-THIEUTH
  sub {
    from "ᆴ" + kor_maybedash + "ᄋ"
    to "ᆯ" + ref( 1 ) + "ᄐ"
  }
  sub {
    from "ᆴ" + kor_maybedash
    to "ᆯ" + ref( 1 )
  }

  # HANGUL JONGSEONG RIEUL-PHIEUPH
  sub {
    from "ᆵ" + kor_maybedash + "ᄋ"
    to "ᆯ" + ref( 1 ) + "ᄑ"
  }
  sub {
    from "ᆵ" + kor_maybedash
    to "ᆯ" + ref( 1 )
    after any("ᄃᄄᄐ")
  }
  sub {
    from "ᆵ" + kor_maybedash
    to "ᄇ" + ref( 1 )
  }

  # HANGUL JONGSEONG RIEUL-HIEUH
  sub {
    from "ᆶ" + kor_maybedash + "ᄀ"
    to "ᆯ" + ref( 1 ) + "ᄏ"
  }
  sub {
    from "ᆶ" + kor_maybedash + "ᄃ"
    to "ᆯ" + ref( 1 ) + "ᄐ"
  }
  sub {
    from "ᆶ" + kor_maybedash + "ᄇ"
    to "ᆯ" + ref( 1 ) + "ᄑ"
  }
  sub {
    from "ᆶ" + kor_maybedash + "ᄌ"
    to "ᆯ" + ref( 1 ) + "ᄎ"
  }
  sub {
    from "ᆶ" + kor_maybedash
    to "ᆯ" + ref( 1 )
  }

  # HANGUL JONGSEONG PIEUP-SIOS
  sub {
    from "ᆹ" + kor_maybedash + "ᄋ"
    to "ᄇ" + ref( 1 ) + "ᄉ"
  }
  sub {
    from "ᆹ" + kor_maybedash
    to "ᄇ" + ref( 1 )
  }

  # HANGUL JONGSEONG SSANG-SIOS
  sub {
    from "ᆻ" + kor_maybedash + "ᄋ"
    to "ᆺ" + ref( 1 ) + "ᄊ"
  }
