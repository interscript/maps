    to ref( 1 ) + "ᄎ"
  }
  sub {
    from "ᇂ" + kor_maybedash
    to ref( 1 )
  }

  # From Unicode Chart
  # https://github.com/unicode-org/cldr/blob/master/common/transforms/Korean-Latin-BGN.xml

  sub {
    from "ᆮ" + kor_maybedash + "ᄋ"
    to ref( 1 ) + "d"
  }

  sub {
    from "ᆨ" + kor_maybedash + "ᄀ"
    to "k" + ref( 1 ) + "k"
  }
  sub {
    from "ᆨ" + kor_maybedash + "ᄂ"
    to "ng" + ref( 1 ) + "n"
  }
  sub {
    from "ᆨ" + kor_maybedash + "ᄃ"
    to "k" + ref( 1 ) + "ch"
    after any("ᅵᅣᅤᅧᅨᅭᅲ")
  }
  sub {
    from "ᆨ" + kor_maybedash + "ᄃ"
    to "k" + ref( 1 ) + "t"
  }
  sub {
    from "ᆨ" + kor_maybedash + "ᄅ"
    to "ng" + ref( 1 ) + "n"
  }
  sub {
    from "ᆨ" + kor_maybedash + "ᄆ"
    to "ng" + ref( 1 ) + "m"
  }
  sub {
