    to "ᆺ" + ref( 1 )
  }

  # HANGUL JONGSEONG CIEUC
  sub {
    from "ᆽ" + kor_maybedash + "ᄋ"
    to "ᆺ" + ref( 1 ) + "ᄌ"
  }
  sub {
    from "ᆽ" + kor_maybedash
    to "ᆺ" + ref( 1 )
  }

  # HANGUL JONGSEONG CHIEUCH
  sub {
    from "ᆾ" + kor_maybedash + "ᄋ"
    to "ᆺ" + ref( 1 ) + "ᄎ"
  }
  sub {
    from "ᆾ" + kor_maybedash
    to "ᆺ" + ref( 1 )
  }

  # HANGUL JONGSEONG KHIEUKH
  sub {
    from "ᆿ" + kor_maybedash + "ᄋ"
    to "ᆨ" + ref( 1 ) + "ᄏ"
  }
  sub {
    from "ᆿ" + kor_maybedash
    to "ᆨ" + ref( 1 )
  }

  # HANGUL JONGSEONG THIEUTH
  sub {
    from "ᇀ" + kor_maybedash + "ᄋ"
    to "ᆺ" + ref( 1 ) + "ᄐ"
  }
  sub {
