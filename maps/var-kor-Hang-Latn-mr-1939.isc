    to "k" + ref( 1 ) + "ch’"
  }
  sub {
    from "ᆨ" + kor_maybedash + "ᄏ"
    to "k" + ref( 1 ) + "k’"
  }
  sub {
    from "ᆨ" + kor_maybedash + "ᄐ"
    to "k" + ref( 1 ) + "ch’"
    after any("ᅵᅣᅤᅧᅨᅭᅲ")
  }
  sub {
    from "ᆨ" + kor_maybedash + "ᄐ"
    to "k" + ref( 1 ) + "t’"
  }
  sub {
    from "ᆨ" + kor_maybedash + "ᄑ"
    to "k" + ref( 1 ) + "p’"
