   "\uAA01\uAA18\uAA2D \uAA08\uAA23\uAA48" ->  "inâ garay"
   "\uAA02\uAA24 \uAA00\uAA18\uAA30\uAA4D" ->  "ula anaih"
   "\uAA06\uAA40" ->  "kak"
   "\uAA06\uAA42" ->  "kang"
   "\uAA06\uAA29" ->  "kaa"
   "\uAA06\uAA2F\uAA29" ->  "koo"
   "\uAA06\uAA32\uAA43" ->  "kung"
   "\uAA06\uAA33" ->  "kia"
   "\uAA06\uAA35" ->  "kla"
   "\uAA06\uAA30" ->  "kai"
   "\uAA57" ->  "7"
}

