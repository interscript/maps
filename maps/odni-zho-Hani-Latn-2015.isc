stage main {
  parallel {
    # APPENDIX C — List of Common Chinese Surnames (D-19..D-22)
    # Each rule: character -> IC transliteration; comment carries the
    # printed STC code and the non-IC alternate renditions.
    sub "丁" "Ding"  # STC 0002
    sub "于" "Yu"  # STC 0060
    sub "方" "Fang"  # STC 2455; as printed: Fang, Fong
    sub "孔" "Kong"  # STC 1313; as printed: Kong, Kung, Hung
    sub "毛" "Mao"  # STC 3029; as printed: Mao, Mo
    sub "王" "Wang"  # STC 3769; as printed: Wang, Wong, Voung, Ong, Heng
