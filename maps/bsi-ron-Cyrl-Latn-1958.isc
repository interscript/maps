system "BSI:ron-Cyrl:Latn:1958" {

metadata {
  authority_id bsi
  id 1958
  language iso-639-2:ron
  source_script Cyrl
  destination_script Latn
  name "BS 2979:1958 Transliteration of Cyrillic and Greek characters - Table E, Transliteration of Rumanian Cyrillic (Alfabetul Cirilic)"
  url https://www.bsigroup.com
  creation_date 1958
  confirmation_date 2000-05
  description {    BS 2979:1958, Table E: transliteration of Rumanian Cyrillic (Alfabetul Cirilic),
    the Cyrillic alphabet used for Romanian until 1860. For transliteration of
    Moldavian in the modern orthography, the table's companion note directs the
    reader to Table C (ISO/R9) in Section 2.
  }

  notes {
    note "The table's footnote marks variant renderings encountered in latinised Rumanian that make for ambiguity in retransliteration and should therefore be avoided in documents for export: No. 6 ie (after vowels); 8 z; 23 ch; 24 o; 29 a-breve alternatives; 30 i and a-circumflex alternatives; 32 e; 36 e and ia; 37 u-breve; 40 t; 41 i. This map applies the primary renderings as printed."
    note "K is romanized c, and ch before e and i; this map implements the context rule for the letters e, i and i-diaeresis following k, and renders c elsewhere. Dzhe (row 43, shaped like ts with a descender) is romanized g, the table conditioning the rendering on position before e and i."
    note "Yer is romanized a with breve; yery as a-circumflex plus i; yat as ea; the little yus as e with circumflex and the big yus as a with circumflex. The soft sign is u with breve, omitted when final; this map renders it u with breve in all positions and does not implement the final-omission rule, which requires word-boundary handling the note leaves to the user."
    note "The semiyus (row 42) is printed with the rendering i-circumflex and the parenthetical n; this map renders the letter as the two-letter reading in."
    note "The digraph uk (o plus u, with monograph-uk variants) is romanized u with breve, the table also showing the alternative rendering as the two separate letters."
    note "Fita is romanized th and izhitsa y, the source's own footnote listing t and i among the ambiguous variants to avoid."
    note "Transcribed visually from the scanned table page of the digitized BS 2979:1958 (BSI 05-2000 reprint); row 43's dzhe and the yus readings were confirmed at 14x-20x magnification."
  }
}

tests {
  # every table row, upper and lower
   "А" ->  "A"
   "а" ->  "a"
   "Б" ->  "B"
   "б" ->  "b"
   "В" ->  "V"
   "в" ->  "v"
   "Г" ->  "G"
   "г" ->  "g"
   "Д" ->  "D"
   "д" ->  "d"
   "Є" ->  "E"
   "є" ->  "e"
   "Ж" ->  "J"
   "ж" ->  "j"
   "Ѕ" ->  "Dz"
   "ѕ" ->  "dz"
   "З" ->  "Z"
   "з" ->  "z"
   "И" ->  "I"
   "и" ->  "i"
   "Й" ->  "Ĭ"
   "й" ->  "ĭ"
   "І" ->  "I"
   "і" ->  "i"
   "Ї" ->  "Ï"
   "ї" ->  "ï"
  # row 12: k is c, ch before e & i
   "К" ->  "C"
   "к" ->  "c"
   "ке" ->  "che"
   "Ки" ->  "Chi"
   "ка" ->  "ca"
   "Л" ->  "L"
   "л" ->  "l"
   "М" ->  "M"
   "м" ->  "m"
   "Н" ->  "N"
   "н" ->  "n"
   "О" ->  "O"
   "о" ->  "o"
   "П" ->  "P"
   "п" ->  "p"
   "Р" ->  "R"
   "р" ->  "r"
   "С" ->  "S"
   "с" ->  "s"
   "Т" ->  "T"
   "т" ->  "t"
   "ОУ" ->  "Ŭ"
   "оу" ->  "ŭ"
   "Ф" ->  "F"
   "ф" ->  "f"
   "Х" ->  "H"
   "х" ->  "h"
   "Ѡ" ->  "Ō"
   "ѡ" ->  "ō"
   "Ц" ->  "Ţ"
   "ц" ->  "ţ"
   "Ч" ->  "C"
   "ч" ->  "c"
   "Ш" ->  "Ş"
   "ш" ->  "ş"
   "Щ" ->  "Şt"
   "щ" ->  "şt"
   "Ъ" ->  "Ă"
   "ъ" ->  "ă"
   "Ы" ->  "Âi"
   "ы" ->  "âi"
   "Ь" ->  "Ŭ"
   "ь" ->  "ŭ"
   "Ѣ" ->  "Ea"
   "ѣ" ->  "ea"
   "Ю" ->  "Iu"
   "ю" ->  "iu"
   "ІА" ->  "Ia"
   "іа" ->  "ia"
   "Ѥ" ->  "Ie"
   "ѥ" ->  "ie"
   "Ѧ" ->  "Ê"
   "ѧ" ->  "ê"
   "Ѫ" ->  "Â"
   "ѫ" ->  "â"
   "Ѯ" ->  "X"
   "ѯ" ->  "x"
   "Ѱ" ->  "Ps"
   "ѱ" ->  "ps"
   "Ѳ" ->  "Th"
   "ѳ" ->  "th"
   "Ѵ" ->  "Y"
   "ѵ" ->  "y"
   "Ꙏ" ->  "În"
   "ꙏ" ->  "în"
   "Џ" ->  "G"
   "џ" ->  "g"
}

stage main {

  # RULES
  # row 12: k is ch before e & i, c elsewhere
  sub {
    from "К"
    to "Ch"
    after any("ЕеИиІіЇї")
  }
  sub {
    from "к"
    to "ch"
    after any("ЕеИиІіЇї")
  }

  # CHARACTERS
  parallel {
    sub "ІА" "Ia"
    sub "ОУ" "Ŭ"
    sub "Ѣ" "Ea"
    sub "Ѥ" "Ie"
    sub "Ѧ" "Ê"
    sub "Ѫ" "Â"
    sub "Ѯ" "X"
    sub "Ѱ" "Ps"
    sub "Ѳ" "Th"
    sub "Ѕ" "Dz"
    sub "Щ" "Şt"
    sub "Ы" "Âi"
    sub "Ю" "Iu"
    sub "Ѡ" "Ō"
    sub "Ц" "Ţ"
    sub "Ш" "Ş"
    sub "Ъ" "Ă"
    sub "Ь" "Ŭ"
    sub "Ж" "J"
    sub "И" "I"
    sub "Й" "Ĭ"
    sub "Ї" "Ï"
    sub "Є" "E"
    sub "А" "A"
    sub "Б" "B"
    sub "В" "V"
    sub "Г" "G"
    sub "Д" "D"
    sub "Е" "E"
    sub "З" "Z"
    sub "І" "I"
    sub "К" "C"
    sub "Л" "L"
    sub "М" "M"
    sub "Н" "N"
    sub "О" "O"
    sub "П" "P"
    sub "Р" "R"
    sub "С" "S"
    sub "Т" "T"
    sub "У" "U"
    sub "Ф" "F"
    sub "Х" "H"
    sub "Ѵ" "Y"
    sub "Ч" "C"
    sub "Ꙏ" "În"
    sub "Џ" "G"

    sub "іа" "ia"
    sub "оу" "ŭ"
    sub "ѣ" "ea"
    sub "ѥ" "ie"
    sub "ѧ" "ê"
    sub "ѫ" "â"
    sub "ѯ" "x"
    sub "ѱ" "ps"
    sub "ѳ" "th"
    sub "ѕ" "dz"
    sub "щ" "şt"
    sub "ы" "âi"
    sub "ю" "iu"
    sub "ѡ" "ō"
    sub "ц" "ţ"
    sub "ш" "ş"
    sub "ъ" "ă"
    sub "ь" "ŭ"
    sub "ж" "j"
    sub "и" "i"
    sub "й" "ĭ"
    sub "ї" "ï"
    sub "є" "e"
    sub "а" "a"
    sub "б" "b"
    sub "в" "v"
    sub "г" "g"
    sub "д" "d"
    sub "е" "e"
    sub "з" "z"
    sub "і" "i"
    sub "к" "c"
    sub "л" "l"
    sub "м" "m"
    sub "н" "n"
    sub "о" "o"
    sub "п" "p"
    sub "р" "r"
    sub "с" "s"
    sub "т" "t"
    sub "у" "u"
    sub "ф" "f"
    sub "х" "h"
    sub "ѵ" "y"
