  # RULES
  # A consonant followed by a vowel sign or virama loses its inherent a
  # (source table II: the abbreviated vowel characters are romanized by the
  # sign alone, the consonant carrying no vowel).
    sub {
    from "ক"
    to "k"
    after beng_signs
  }
    sub {
    from "খ"
    to "kh"
    after beng_signs
  }
    sub {
    from "গ"
    to "g"
    after beng_signs
  }
    sub {
    from "ঘ"
    to "gh"
    after beng_signs
  }
    sub {
    from "ঙ"
    to "ṅ"
    after beng_signs
  }
    sub {
    from "চ"
    to "ch"
    after beng_signs
  }
    sub {
    from "ছ"
    to "chh"
    after beng_signs
  }
    sub {
