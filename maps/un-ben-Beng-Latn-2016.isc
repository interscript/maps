  # CHARACTERS
  parallel {

    # I. Independent vowel characters

    sub "অ" "a"
    sub "আ" "ā"
    sub "ই" "i"
    sub "ঈ" "ī"
    sub "উ" "u"
    sub "ঊ" "ū"
    sub "ঋ" "ṛ"
    sub "এ" "e"
    sub "ঐ" "ai"
    sub "ও" "o"
    sub "ঔ" "au"

    # II. Abbreviated vowel characters (ক stands for any consonant character)

    # sub 'ক', 'a'   # 1
    sub "\u09be" "ā"
    sub "\u09bf" "i"
    sub "\u09c0" "ī"
    sub "\u09c1" "u"
    sub "\u09c2" "ū"
    sub "\u09c3" "ṛ"
    sub "\u09c7" "e"
    sub "\u09c8" "ai"
    sub "\u09cb" "o"
    sub "\u09cc" "au"

    # II 5 Exceptions
    # sub "গু", "gu" # We needed to comment this out to pass a test while converting to v2 maps
    sub "রু" "ru"
    sub "শু" "shu"
    sub "হু" "hu"
    # II 6 Exceptions
    sub "রূ" "rū"
    # II 7 Exceptions
    sub "হৃ" "hṛ"

    # III. Other symbols (ক stands for any consonant character)

    sub "\u0982" "ṁ"
    sub "\u0981" "m̐"
    sub "\u0983" "ḥ"
    sub "\u09cd\u200c" ""
    sub "\u09cd" ""

    # III 4 special form
    sub "ৎ" "t"

    # IV. Consonant characters

    sub "ক" "ka"
    sub "খ" "kha"
    sub "গ" "ga"
    sub "ঘ" "gha"
    sub "ঙ" "ṅa"
    sub "চ" "cha"
    sub "ছ" "chha"
    sub "জ" "ja"
    sub "ঝ" "jha"
    sub "ঞ" "ña"
    sub "ট" "ṭa"
