    to "th"
    after beng_signs
  }
    sub {
    from "দ"
    to "d"
    after beng_signs
  }
    sub {
    from "ধ"
    to "dh"
    after beng_signs
  }
    sub {
    from "ন"
    to "n"
    after beng_signs
  }
    sub {
    from "প"
    to "p"
    after beng_signs
  }
    sub {
    from "ফ"
    to "ph"
    after beng_signs
  }
    sub {
    from "ব"
    to "b"
    after beng_signs
  }
