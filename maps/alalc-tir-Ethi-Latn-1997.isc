    sub "ፐ" "pa"
    sub "ፑ" "pu"
    sub "ፒ" "pi"
    sub "ፓ" "pā"
    sub "ፔ" "pé"
    sub {
    from "ፕ"
    to any(["pe", "p"])
  }
    sub "ፖ" "po"

    sub "ቨ" "va"
    sub "ቩ" "vu"
    sub "ቪ" "vi"
    sub "ቫ" "vā"
    sub "ቬ" "vé"
    sub {
    from "ቭ"
    to any(["ve", "v"])
  }
    sub "ቮ" "vo"

    sub "ቈ" "qwa"
    sub "ቊ" "qwi"
    sub "ቋ" "qwā"
    sub "ቌ" "qwé"
    sub "ቍ" "qwe"

    # This section not present in Amharic
    sub "ቘ" "qw̄a"
    sub "ቚ" "qw̄i"
    sub "ቛ" "qw̄ā"
    sub "ቜ" "qw̄é"
    sub "ቝ" "qw̄e"

    sub "ኈ" "ẖwa"
    sub "ኊ" "ẖwi"
    sub "ኋ" "ẖwā"
    sub "ኌ" "ẖwé"
    sub "ኍ" "ẖwe"

    sub "ኰ" "kwa"
    sub "ኲ" "kwi"
    sub "ኳ" "kwā"
    sub "ኴ" "kwé"
    sub "ኵ" "kwe"

    # This section not present in Amharic
    sub "ዀ" "xwa"
    sub "ዂ" "xwi"
    sub "ዃ" "xwā"
    sub "ዄ" "xwé"
    sub "ዅ" "xwe"

    sub "ጐ" "gwa"
    sub "ጒ" "gwi"
    sub "ጓ" "gwā"
    sub "ጔ" "gwé"
    sub "ጕ" "gwe"

    # Original system did not contain numerals but they are necessary for
    # transliteration.

    # Numerals
    sub "፩" "1"
    sub "፪" "2"
    sub "፫" "3"
    sub "፬" "4"
    sub "፭" "5"
    sub "፮" "6"
    sub "፯" "7"
    sub "፰" "8"
    sub "፱" "9"
    sub "፲" "10"
    sub "፳" "20"
    sub "፴" "30"
    sub "፵" "40"
    sub "፶" "50"
    sub "፷" "60"
    sub "፸" "70"
    sub "፹" "80"
    sub "፺" "90"
    sub "፻" "100"
  }

}
}
