  "ၵု" -> "ku"
  "ၵူ" -> "kū"
  "ေၵ" -> "ke"
  "ၵဵ" -> "ke"
  "ေၵႃ်" -> "kò"
  "ေၵႃ" -> "ko"
  "ေၵါ" -> "ko"
  "ၵူဝ်" -> "kō"
  "ၵႆ" -> "kai"
  "ၵႂ်" -> "kái"
  "ၵႆွ" -> "koi"
  "ၵွ" -> "kau"
  "ၵုိ" -> "kui"
  "ၵူိ" -> "kūi"
  "ၵျ" -> "ky"
  "ၵႂ" -> "kv"

}

