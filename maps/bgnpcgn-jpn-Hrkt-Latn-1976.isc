system "BGN-PCGN:jpn-Hrkt:Latn:1976" {

metadata {
  authority_id bgnpcgn
  id 1976
  language iso-639-2:jpn
  source_script Hrkt
  destination_script Latn
  name Romanization of Japanese -- Kana Modified Hepburn (1930)
  url 
  creation_date 
  adoption_date 
  description 

  notes {
    note "Segmentation needs to be done before using this map"
    note "Note 5 in the specification states that when identical repeating vowels\n belong to different kanji characters, they shall be romanized\n individually and an apostrophe (’) shall be placed between the vowels.\n However since this is a map from Kana to Hepburn, there is no way to\n implement this feature."
    note "The documentation did not specify how the hyphen should be used."
  }
}

