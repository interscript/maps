dependency "posix"
dependency "var-kor"

stage main {

  # CHARACTERS
  parallel {
    sub "А" "A"
    sub "Б" "B"
    sub "В" "V"
    sub "Г" "G"
    sub "Д" "D"
    sub "Е" "E"
    sub "Ж" "Ž"
    sub "З" "Z"
    sub "И" "I"
    sub "Й" "J"
    sub "К" "K"
    sub "Л" "L"
    sub "М" "M"
    sub "Н" "N"
    sub "О" "O"
    sub "П" "P"
    sub "Р" "R"
    sub "С" "S"
    sub "Т" "T"
    sub "У" "U"
    sub "Ф" "F"
    sub "Х" "H"
    sub "Ц" "C"
    sub "Ч" "Č"
    sub "Ш" "Š"
    sub "Щ" "Št"
    sub "Ъ" "Ǎ"
    sub "Ь" "J"
    sub "Ю" "Ju"
    sub "Я" "Ja"

    sub "а" "a"
    sub "б" "b"
    sub "в" "v"
    sub "г" "g"
    sub "д" "d"
    sub "е" "e"
    sub "ж" "ž"
    sub "з" "z"
    sub "и" "i"
    sub "й" "j"
    sub "к" "k"
    sub "л" "l"
    sub "м" "m"
    sub "н" "n"
    sub "о" "o"
    sub "п" "p"
    sub "р" "r"
    sub "с" "s"
    sub "т" "t"
    sub "у" "u"
    sub "ф" "f"
    sub "х" "h"
    sub "ц" "c"
    sub "ч" "č"
    sub "ш" "š"
    sub "щ" "št"
    sub "ъ" "ǎ"
    sub "ь" "j"
    sub "ю" "ju"
    sub "я" "ja"

  }

  # ŠT
  sub {
    from capture(maybe(upper)) + "Št" + capture(upper)
    to ref(1) + "ŠT" + ref(2)
  }
  sub {
    from capture(upper) + "Št" + capture(maybe(upper))
    to ref(1) + "ŠT" + ref(2)
  }

  # YU
  sub {
    from capture(maybe(upper)) + "Ju" + capture(upper)
    to ref(1) + "JU" + ref(2)
  }
  sub {
    from capture(upper) + "Ju" + capture(maybe(upper))
    to ref(1) + "JU" + ref(2)
  }

  # YA
  sub {
    from capture(maybe(upper)) + "Ja" + capture(upper)
    to ref(1) + "JA" + ref(2)
  }
  sub {
    from capture(upper) + "Ja" + capture(maybe(upper))
    to ref(1) + "JA" + ref(2)
  }
}

}
