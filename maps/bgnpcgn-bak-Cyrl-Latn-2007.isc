    sub "\u0427" "Ç"
    sub "\u0428" "Ş"
    sub "\u0429" "ŞÇ"
    sub "\u042A" ""
    sub "\u042B" "I"
    sub "\u042C" ""
    sub "\u042D" "E"
    sub "\u04D8" "Ə"
    sub "\u042E" "Yu"
    sub "\u042F" "Ya"

    sub "\u0430" "a"
