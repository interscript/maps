system "BGN-PCGN:bak-Cyrl:Latn:2007" {

metadata {
  authority_id bgnpcgn
  id 2007
  language iso-639-2:bak
  source_script Cyrl
  destination_script Latn
  name Table of Correspondences for Bashkir (Cyrillic-Roman) (2007 Agreement)
  url https://assets.publishing.service.gov.uk/government/uploads/system/uploads/attachment_data/file/829203/TABLE_OF_CORRESPONDENCES__FOR_BASHKIR.pdf
  creation_date 2007
  confirmation_date 2019
  description {    Bashkir is an official language within Respublika Bashkortostan, one of the
    republics of the Russian Federation. It will normally be encountered in Cyrillic script, in
    which case it should be romanized by means of the Cyrillic-Roman table of
    correspondences given below
  }

  notes {
    note "The letter w is used word initially and before a vowel."
    note "The letter sequence ye is used word initially and before a vowel."
    note "The letter w is used between or after vowels."
    note "The letter w is used after e, u, ö and ə."
    note "      An inventory of letter-diacritic combinations, with their Unicode encoding,\n      in addition to the unmodified letters of the basic Roman script is:\n        Ğ (U+011E) ğ (U+011F)\n        Ź (U+0179) ź (U+017A)\n        Ë (U+00CB) ë (U+00EB)\n        Ñ (U+00D1) ñ (U+00F1)\n        Ö (U+00D6) ö (U+00F6)\n        Ś (U+015A) ś (U+015B)\n        Ü (U+00DC) ü (U+00FC)\n        Ç (U+00C7) ç (U+00E7)\n        Ş (U+015E) ş (U+015F)\n        Ə (U+018F) ə (U+0259)"
    note "      The Roman-script columns show only lowercase forms but, when applying the table,\n      uppercase and lowercase Roman letters as appropriate should be used."
  }
}

tests {
  # adopted http://www.eki.ee/knab/lat/kblba.pdf
   "Васйылға" ->  "Wasyılğa"
   "Еҙем" ->  "Yeźem"
   "Раевка" ->  "Raevka"
   "Сәйетҡол" ->  "Səyetqol"
   "Ауырғазы" ->  "Awırğazı"
   "Бурһыҡтау" ->  "Burhıqtaw"
   "Мәләүез" ->  "Mələwez"
   "Ҡыҙылъяр" ->  "Qıźılyar"
  # adopted https://en.wikipedia.org/wiki/Bashkir_language#Grammar
   "кемдең" ->  "kemdeñ"
   "кем" ->  "kem"
   "был" ->  "bıl"
   "ошо" ->  "oşo"
   "быларҙың" ->  "bılarźıñ"
   "һеҙҙән" ->  "heźźən"
   "һин" ->  "hin"
   "һеҙҙең" ->  "heźźeñ"
}

stage main {

  # RULES
  # note[1]
  sub {
    from boundary + "\u0412"
    to "W"
    after any("АаЕеЁёИиОоӨөУуҮЫыЭэӘәЮюЯя")
  }
  sub {
    from boundary + "\u0432"
    to "w"
    after any("АаЕеЁёИиОоӨөУуҮЫыЭэӘәЮюЯя")
  }
  # note[2]
  sub {
    from boundary + "\u0415"
    to "Ye"
  }
  sub {
    from boundary + "\u0435"
    to "ye"
  }
  sub {
    from "\u0415"
    to "Ye"
    before any("АаЕеЁёИиОоӨөУуҮЫыЭэӘәЮюЯя")
    after boundary
  }
  sub {
    from "\u0435"
    to "ye"
    before any("АаЕеЁёИиОоӨөУуҮЫыЭэӘәЮюЯя")
    after boundary
  }

  # note[3] # note[4]
  sub {
    from any("\u0423\u04AE")
    to "W"
    before any("АаЕеЁёИиОоӨөУуҮЫыЭэӘәЮюЯя")
  }
  sub {
    from any("\u0443\u04AF")
    to "w"
    before any("АаЕеЁёИиОоӨөУуҮЫыЭэӘәЮюЯя")
  }



  # CHARACTERS
  parallel {
    sub "\u0410" "A"
    sub "\u0411" "B"
    sub "\u0412" "V"
    sub "\u0413" "G"
    sub "\u0492" "Ğ"
    sub "\u0414" "D"
    sub "\u0498" "Ź"
    sub "\u0415" "E"
    sub "\u0401" "Ë"
    sub "\u0416" "J"
    sub "\u0417" "Z"
    sub "\u0418" "I"
    sub "\u0419" "Y"
    sub "\u041A" "K"
    sub "\u04A0" "Q"
    sub "\u041B" "L"
    sub "\u041C" "M"
    sub "\u041D" "N"
    sub "\u04A2" "Ñ"
    sub "\u041E" "O"
    sub "\u04E8" "Ö"
