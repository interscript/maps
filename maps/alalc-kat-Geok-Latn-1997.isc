system "ALA-LC:kat-Geok:Latn:1997" {

metadata {
  authority_id alalc
  id 1997
  language iso-639-2:kat
  source_script Geok
  destination_script Latn
  name Romanization Table -- Georgian Khutsuri (1997)
  url http://catdir.loc.gov/catdir/cpso/romanization/georgian.pdf
  creation_date 1997
  confirmation_date 1997
  description {    Values are shown for the Khutsuri alphabet.
  }
  notes {
  }
}

tests {
   "ႼႨႢႬႨ" ->  "CIGNI"
   "ⴜⴈⴂⴌⴈ" ->  "cigni"
