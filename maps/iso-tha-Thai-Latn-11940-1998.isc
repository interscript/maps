system "ISO:tha-Thai:Latn:11940-1998" {

metadata {
  authority_id iso
  id 11940-1998
  language iso-639-2:tha
  source_script Thai
  destination_script Latn
  name ISO 11940:1998 Information and documentation -- Transliteration of Thai
  url https://www.iso.org/standard/20574.html
  creation_date 1998
  adoption_date 
  description 

  notes {
  }
}

tests {
   "ภาษาไทย" ->  "p̣hās̛̄āịthy"
   "เชียงใหม่" ->  "echīyngıh̄m̀"
}


