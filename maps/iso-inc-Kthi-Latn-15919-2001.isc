system "ISO:inc-Kthi:Latn:15919-2001" {

metadata {
  authority_id iso
  id 15919-2001
  language iso-639-2:inc
  source_script Kthi
  destination_script Latn
  name "ISO 15919:2001 Information and documentation -- Transliteration of Devanagari and related Indic scripts into Latin characters (Kaithi)"
  url https://www.chatranjali.fr/Scripts/Standards/ISO15919.pdf
  creation_date 2001
  adoption_date 2001
  description {    ISO 15919:2001 first edition, Transliteration of Devanagari and related Indic scripts
    into Latin characters. Every printed row of the transcription-source table is encoded
    and embedded as a test row; see notes for provenance, cross-check rates, and findings.  }

  notes {
    note "Authority: ISO 15919:2001 first edition (Kaithi listed in its scope annex); the first edition printed no per-script Kaithi table, so the rows follow the transcription source below and are verified against the second edition's Table 7.13 where they overlap."
    note "Transcription source (owner blessing 2026-11-17): Wikipedia ISO 15919 article table, CC BY-SA, https://en.wikipedia.org/wiki/ISO_15919 - every printed Kaithi cell is encoded and embedded as a test row."
    note "Verification: all overlapping cells agree with ISO/DIS 15919 (2026) Table 7.13 (N125), which additionally prints vocalic r, candrabindu, anusvara and visarga rows not printed by the transcription source."
    note "Vowel-sign rows are not printed by the transcription source for Kaithi and are not encoded; see the 15919-2026 Kaithi map for the second edition's full sign inventory."
  }
}

tests {
   "𑂃" ->  "a"
