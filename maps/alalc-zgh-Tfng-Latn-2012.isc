system "ALA-LC:zgh-Tfng:Latn:2012" {

metadata {
  authority_id alalc
  id 2012
  language iso-639-2:zgh
  source_script Tfng
  destination_script Latn
  name "Moroccan Tamazight Romanization Table (2012)"
  url https://www.loc.gov/catdir/cpso/romanization/tamazight.pdf
  creation_date 2012
  adoption_date
  description {    ALA-LC Moroccan Tamazight Romanization Table, approved by
    CC:AAM 2012-01-22 (no version year printed on the document; the
    approval date is from the PDF metadata). The table follows, with
    minimal exceptions, the romanization method used by the Institut
    Royal de la Culture Amazighe (IRCAM) for texts published in the
    Central Atlas Tamazight and Standard Tamazight languages of
    Morocco, using neo-Tifinagh script. Characters needed to support
    the Tachelhit and Tarifit languages have also been included, so
    the scope covers all living Moroccan Tamazight languages in
    neo-Tifinagh. Forty-two letter rules plus the labialized digraphs
    and the labialization mark (tamatart). The spirant letters romanize
    with a macron below (ḇ ḡ ḏ ṯ, U+0331); the emphatic letters with a
    dot below (ḍ ḥ ṛ ṣ ṭ ẓ); the Tachelhit emphatic d with both marks.
  }

  notes {
    note "The document example romanizes ⴰⵖⵍⵢⴰⵙ as Aɣlyas, or as
    Aglyas if applying LCRI 1.0E / LCPS 1.4 (Note 1: extended Latin
    characters are used in the standard orthography; apply LCRI 1.0E /
    LCPS 1.4 as needed). The initial capital in the example is proper-
    noun capitalization, not a script property; the map yields the
    mechanical aɣlyas."
    note "Note 2: the Tifinagh modifier letter labialization mark
    (tamatart, ⵯ) romanizes as the superscript degree sign (°); the
    labialized digraphs ⴳⵯ and ⴽⵯ carry it as g° and k°."
    note "ⴺ (YADDH) romanizes as d with dot below and macron below
    (ḏ with underdot), per the printed table; the mark order in the
    encoded output is dot below (U+0323) then macron below (U+0331)."
  }
}

tests {
  "ⴰⵖⵍⵢⴰⵙ" -> "aɣlyas"
  "ⴲ" -> "ḇ"
  "ⴴ" -> "g̱"
  "ⴸ" -> "ḏ"
  "ⴹ" -> "ḍ"
  "ⴺ" -> "ḍ̱"
  "ⵃ" -> "ḥ"
  "ⵕ" -> "ṛ"
  "ⵚ" -> "ṣ"
  "ⵝ" -> "ṯ"
  "ⵟ" -> "ṭ"
  "ⵥ" -> "ẓ"
  "ⴳⵯ" -> "g°"
  "ⵯ" -> "°"

# Exhaustive per-row tests for alalc-zgh-Tfng-Latn-2012, generated from the source
# document's table.
# Source: ALA-LC Moroccan Tamazight Romanization Table (2012; no version
# year printed on the document, approval date CC:AAM 2012-01-22 from PDF
# metadata) (https://www.loc.gov/catdir/cpso/romanization/tamazight.pdf;
# local source interscript-private-references/alalc/alalc-tamazight.pdf).
# Single-page table, 43 rows, read as printed column streams (left column
# top-down, then right). Complete: no skipped rows — the table includes the
# labialized digraphs ⴳⵯ/ⴽⵯ and the tamatart ⵯ, all encodable. The PDF text
# layer drops the macron-below marks (U+0331) on the ⴲ ⴴ ⴸ ⵝ values and the
# entire value cells for ⵕ ⵟ ⴺ; those values are transcribed from the
# printed page image. Decomposed text-layer forms are NFC-normalized
# (h+U+0323 → ḥ U+1E25, s+U+0323 → ṣ, z+U+0323 → ẓ, d+U+0323 → ḍ). The ⴺ
# value (d with dot below and macron below) follows the printed glyph with
# the map's documented mark order (U+0323 then U+0331). The printed ⵄ ⵖ rows
# carry '(See note 1)' and ⵯ '(See note 2)' reference markers; transcribed
# as plain values.
# Provenance artifact: scripts/row-sources/alalc-zgh-Tfng-Latn-2012.json (43 rows).
# generated-by: maps/scripts/gen-row-tests.mjs (2026-11-14); regenerate from the artifact, do not hand-edit.
