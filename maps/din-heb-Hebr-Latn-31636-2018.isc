system "DIN:heb-Hebr:Latn:31636-2018" {

metadata {
  authority_id din
  id 31636-2018
  language iso-639-2:heb
  source_script Hebr
  destination_script Latn
  name "DIN 31636:2018-10 Information und Dokumentation - Umschrift des hebraeischen Alphabets"
  url https://www.din.de
  creation_date 2018
  confirmation_date 2018-10
  description {    Information and documentation -- Romanization of the Hebrew alphabet.
    2018-10 edition, replacing DIN 31636:2011-01. The norm fixes the rendering of the
    letters of the Hebrew alphabet (including Ivrit) in letters of the Latin alphabet.
    This map implements the Hebrew (including Ivrit) column over vocalized input;
    the Yiddish column of the same norm is a separate map.
  }

  notes {
    note "Consonants (Table 1): alef is rendered with the right half-ring U+02BE or ignored per the rules; bet with dagesh lene b, bet v; gimel g; dalet d; he always as consonant h; vav v with dot below (U+1E7F), vav with dagesh (shuruk) u; double vav (U+05F0) as consonant v with dot below; zayin z; het h with dot below (U+1E25); tet t with dot below (U+1E6D); yod y as consonant only when a vowel follows, otherwise omitted; kaf with dagesh k, khaf kh, end-khaf kh; lamed l; mem m, end-mem m; nun n, end-nun n; samekh s; ayin left half-ring U+02BF; pe with dagesh p, fe f, end-fe f; tsadi ts, end-tsadi ts; qof k with dot below (k + U+0323); resh r; shin sh, sin s with acute (U+015B); tav t."
    note "Vowels (Table 3): patach a (with following yod: ai); qamats a or o - this map renders a, the o-reading (qamats qatan) is a reading-side determination; segol e; tsere e; hireq i; holam (U+05B9) or holam male (U+FB4B) o; qubuts (U+05BB) or shuruk (U+FB35) u; sheva e or ignored per the rules; hataf-patach a; hataf-segol e; hataf-qamats o."
    note "Neo-Hebrew additional letters (Table 2) are marked with the straight apostrophe (geresh, U+02B9): gimel-geresh g-apostrophe, dalet-geresh d-apostrophe, zayin-geresh z-apostrophe, het-geresh h-dot-apostrophe, tet-geresh t-dot-apostrophe, ayin-geresh g with dot above (U+0307), tsadi-geresh ts-apostrophe for English names, or d with dot below for Arabic names (variant; this map renders ts-apostrophe)."
    note "Special characters (Table 5): right half-ring U+02BE for alef, left half-ring U+02BF for ayin, straight apostrophe U+02B9 for the geresh. Diacritics (Table 6): circumflex U+0302 for the facultative plene marking, acute U+0301 marking the sin, grave U+0300 for the Yiddish tav (Yiddish map), dot below U+0323 for v, h-dot, t-dot, k-dot, dot above U+0307 only for the neo-Hebrew g-dot."
    note "Rules (section 8): (a) a straight apostrophe separates two letters whose combination would render a different consonant; (b) vowel length is not marked, including the composed forms; (c) alef at the beginning or end of a word and at the end of a syllable is not transliterated; word-internal alef that merely indicates a vowel is likewise ignored, while alef with a vowel sign under it is rendered with U+02BE - this map implements word-initial, word-final, word-internal unvocalized (ignored) and word-internal vocalized (U+02BE) alef; the syllable-end condition is a reading-side determination; (d) bet, kaf and pe follow the modern Hebrew pronunciation with the dagesh lene observed; the distinction between dagesh forte and dagesh lene is not made - residual dagesh signs are deleted; (e) he is always transliterated as a consonant; (f) yod is transliterated as consonant y only when a vowel follows; otherwise it is omitted; (g) the plene spelling of vowels may optionally be shown by a circumflex - this map does not add it; (h) all shevas at the beginning of Hebrew words are rendered e; the sheva word-internally is generally not transliterated - the root-morphology exceptions (doubled third root consonant, yod as second consonant) are reading-side determinations and are not implemented; (i) capitalization follows the rules of the user community; this map outputs lower case and does not apply title case."
    note "Rules 8(h)(16)-(20) hyphenate preposed particles (ha-arets, mi-bayit, le-David) and 8(j)-(k) govern the punctuation of abbreviations; both require word-segmentation and lexical knowledge and are not implemented in this map."
    note "The map is deterministic over vocalized input (text carrying niqqud). Unvocalized text is an underspecified skeleton: matres lectionis (vav, yod, he standing for vowels), the qamats qatan reading, the sheva readings and defective spellings are resolved by a vocalization model, after which this map applies (composition, not duplication)."
  }
}

tests {
  # section 8 examples, vocalized
   "יִשְׂרָאֵל" ->  "yiśraʾel"
   "קְרִיאָה" ->  "ḳeriʾah"
   "תְּקוּפָה" ->  "teḳufah"
   "תְּשׁוּבָה" ->  "teshuvah"
   "מִשְׁנָה" ->  "mishnah"
   "רֹאשׁ" ->  "rosh"
   "אַהֲרֹן" ->  "aharon"
   "תּוֹרָה" ->  "torah"
      "שֶׂכֶל" ->  "śekhel"
      "יִצְחָק" ->  "yitsḥaḳ"
   "אִגֶּרֶת" ->  "igeret"
   "חַיֵּי" ->  "ḥaye"
   "סִפְרֵי" ->  "sifre"
  # table 1 rows
   "בּ" ->  "b"
   "בּ" ->  "b"
   "ב" ->  "v"
   "ג" ->  "g"
   "ד" ->  "d"
   "ה" ->  "h"
   "ו" ->  "ṿ"
   "וּ" ->  "u"
   "וּ" ->  "u"
   "װ" ->  "ṿ"
   "ז" ->  "z"
   "ח" ->  "ḥ"
   "ט" ->  "ṭ"
   "כּ" ->  "k"
   "כּ" ->  "k"
   "כ" ->  "kh"
   "ך" ->  "kh"
   "ל" ->  "l"
   "מ" ->  "m"
   "ם" ->  "m"
   "נ" ->  "n"
   "ן" ->  "n"
   "ס" ->  "s"
   "ע" ->  "ʿ"
   "פּ" ->  "p"
   "פּ" ->  "p"
   "פ" ->  "f"
   "ף" ->  "f"
   "צ" ->  "ts"
   "ץ" ->  "ts"
   "ק" ->  "ḳ"
   "ר" ->  "r"
   "שׁ" ->  "sh"
   "שׁ" ->  "sh"
   "שׂ" ->  "ś"
   "שׂ" ->  "ś"
   "ש" ->  "sh"
   "תּ" ->  "t"
   "תּ" ->  "t"
   "ת" ->  "t"
  # table 2 rows (geresh-marked)
   "גʹ" ->  "gʹ"
   "דʹ" ->  "dʹ"
   "זʹ" ->  "zʹ"
   "חʹ" ->  "ḥʹ"
   "טʹ" ->  "ṭʹ"
   "עʹ" ->  "ġ"
   "צʹ" ->  "tsʹ"
  # table 3 rows
   "בַּ" ->  "ba"
   "בָּ" ->  "ba"
   "בֶּ" ->  "be"
   "בֵּ" ->  "be"
   "בִּ" ->  "bi"
   "בֹּ" ->  "bo"
   "וֹ" ->  "o"
   "בֻּ" ->  "bu"
   "בַּי" ->  "ba"
   "בֲּ" ->  "ba"
   "בֱּ" ->  "be"
   "בֳּ" ->  "bo"
}

stage main {

  # RULES
  # Unicode mark-order normalization: move dagesh and the shin/sin dots
  # directly after their base letter when a vowel mark intervenes
  sub {
    from "ֲּ"
    to "ֲּ"
  }
  sub {
    from "ֲׂ"
    to "ֲׂ"
  }
  sub {
    from "ֲׁ"
    to "ֲׁ"
  }
  sub {
    from "ֱּ"
    to "ֱּ"
  }
  sub {
    from "ֱׂ"
    to "ֱׂ"
  }
  sub {
    from "ֱׁ"
    to "ֱׁ"
  }
  sub {
    from "ֳּ"
    to "ֳּ"
  }
  sub {
    from "ֳׂ"
    to "ֳׂ"
  }
  sub {
    from "ֳׁ"
    to "ֳׁ"
  }
  sub {
    from "ַּ"
    to "ַּ"
  }
  sub {
    from "ַׂ"
    to "ַׂ"
  }
  sub {
    from "ַׁ"
    to "ַׁ"
  }
  sub {
    from "ָּ"
    to "ָּ"
  }
  sub {
    from "ָׂ"
    to "ָׂ"
  }
  sub {
    from "ָׁ"
    to "ָׁ"
  }
  sub {
    from "ֶּ"
    to "ֶּ"
  }
  sub {
    from "ֶׂ"
    to "ֶׂ"
  }
  sub {
    from "ֶׁ"
    to "ֶׁ"
  }
  sub {
    from "ֵּ"
    to "ֵּ"
  }
  sub {
    from "ֵׂ"
    to "ֵׂ"
  }
  sub {
    from "ֵׁ"
    to "ֵׁ"
  }
  sub {
    from "ִּ"
    to "ִּ"
  }
  sub {
    from "ִׂ"
    to "ִׂ"
  }
  sub {
    from "ִׁ"
    to "ִׁ"
  }
  sub {
    from "ֹּ"
    to "ֹּ"
  }
  sub {
    from "ֹׂ"
    to "ֹׂ"
  }
  sub {
    from "ֹׁ"
    to "ֹׁ"
  }
  sub {
    from "ֻּ"
    to "ֻּ"
  }
  sub {
    from "ֻׂ"
    to "ֻׂ"
  }
  sub {
    from "ֻׁ"
    to "ֻׁ"
  }
  # 8(c): alef word-initially and word-finally is not transliterated
  sub {
    from boundary + "א"
    to ""
  }
  sub {
    from "א"
    to ""
    after boundary
  }
  # 8(c): word-internal alef with a vowel sign under it is rendered U+02BE
  sub {
    from "א"
    to "ʾ"
    after any("ְֱֲֳִֵֶַָֹֻ")
  }
  # remaining word-internal alefs merely indicate a vowel and are ignored
  sub {
    from "א"
    to ""
  }

  # 8(h): sheva word-initially (under the word-initial consonant) is e,
  # word-internally it is not transliterated
  sub {
    from "ְ"
    to "e"
    before boundary + any("אבגדהוזחטיכלמנסעפצקרשת")
  }
  sub {
    from "ְ"
    to ""
  }

  # sin and shin dots (the sheva between them is removed first)
  sub {
    from "שׂ"
    to "ś"
  }
  sub {
    from "שׁ"
    to "sh"
  }

  # 8(f): yod as consonant y only when a vowel follows; otherwise omitted
  sub {
    from "י"
    to "y"
    after any("ִֵֶַָֹֻּ")
  }
  sub {
    from "י"
    to ""
  }

  # CHARACTERS
  parallel {
    sub "גʹ" "gʹ"
    sub "דʹ" "dʹ"
    sub "זʹ" "zʹ"
    sub "חʹ" "ḥʹ"
    sub "טʹ" "ṭʹ"
    sub "עʹ" "ġ"
    sub "צʹ" "tsʹ"
    sub "שׂ" "ś"
    sub "שׁ" "sh"
    sub "בּ" "b"
    sub "כּ" "k"
    sub "פּ" "p"
    sub "וּ" "u"
    sub "וֹ" "o"
    sub "בּ" "b"
    sub "כּ" "k"
    sub "פּ" "p"
    sub "וּ" "u"
    sub "וֹ" "o"
    sub "שׁ" "sh"
    sub "שׂ" "ś"
    sub "תּ" "t"
    sub "װ" "ṿ"
    sub "ך" "kh"
    sub "כ" "kh"
    sub "ם" "m"
    sub "מ" "m"
    sub "ן" "n"
    sub "נ" "n"
    sub "ף" "f"
    sub "פ" "f"
    sub "ץ" "ts"
    sub "צ" "ts"
    sub "ב" "v"
    sub "ג" "g"
    sub "ד" "d"
    sub "ה" "h"
    sub "ו" "ṿ"
    sub "ז" "z"
    sub "ח" "ḥ"
    sub "ט" "ṭ"
    sub "ל" "l"
    sub "ס" "s"
    sub "ע" "ʿ"
    sub "ק" "ḳ"
    sub "ר" "r"
    sub "ש" "sh"
    sub "ת" "t"
    sub "ַ" "a"
    sub "ָ" "a"
    sub "ֶ" "e"
    sub "ֵ" "e"
    sub "ִ" "i"
    sub "ֹ" "o"
    sub "ֻ" "u"
    sub "ֲ" "a"
    sub "ֱ" "e"
    sub "ֳ" "o"
    sub "ּ" ""
  }

}

}
