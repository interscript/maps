    to "t"
    after any("ޓ")
  }
  sub {
    from "\u0781\u07b0"
    to "p"
    after any("ޕ")
  }
  sub {
    from "\u0781\u07b0"
    to "y"
    after any("ޔ")
  }

  sub {
    from "\u0787\u07b0"
    to "h"
    after boundary
  }
  sub {
    from "\u0781\u07b0"
    to "h"
    after boundary
  }

  # Note 5
  sub {
    from "\u0782"
    to "n’"
    not_after "=" + any("\u07a6\u07a7\u07a8\u07a9\u07aa\u07ab\u07ac\u07ad\u07ae\u07af\u07B0")
  }

  # Note 6
  sub {
    from "\u078C"
    to "iy"
    after "\u07B0"
  }


  # CHARACTERS
  parallel {
    # Vowels
    sub "ަ" "a"
    sub "ާ" "aa"
    sub "ި" "i"
    sub "ީ" "ee"
    sub "ު" "u"
    sub "ޫ" "oo"
    sub "ެ" "e"
    sub "ޭ" "ey"
    sub "ޮ" "o"
    sub "ޯ" "oa"
    sub "ް" ""


    # Consonants
    sub "ހ" "h"
    sub "ށ" "sh"
    sub "ނ" "n"
    sub "ރ" "r"
    sub "ބ" "b"
    sub "ޅ" "lh"
    sub "ކ" "k"
    sub "އ" ""
    sub "ވ" "v"
    sub "މ" "m"
    sub "ފ" "f"
    sub "ދ" "dh"
    sub "ތ" "th"
    sub "ލ" "l"
    sub "ގ" "g"
    sub "ޏ" "gn"
    sub "ސ" "s"
    sub "ޑ" "d"
    sub "ޖ" "j"
    sub "ޗ" "ch"
    sub "ޒ" "z"
    sub "ޓ" "t"
    sub "ޕ" "p"
    sub "ޔ" "y"
  }

