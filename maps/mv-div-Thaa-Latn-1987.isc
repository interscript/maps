    to "h"
    after any("ށ")
  }
  sub {
    from "\u0781\u07b0"
    to "n"
    after any("ނ")
  }
  sub {
    from "\u0781\u07b0"
    to "r"
    after any("ރ")
  }
  sub {
    from "\u0781\u07b0"
    to "b"
    after any("ބ")
  }
  sub {
    from "\u0781\u07b0"
    to "h"
    after any("ޅ")
  }
  sub {
    from "\u0781\u07b0"
