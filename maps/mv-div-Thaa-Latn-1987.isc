    after any("ކ")
  }
  sub {
    from "\u0781\u07b0"
    to "v"
    after any("ވ")
  }
  sub {
    from "\u0781\u07b0"
    to "m"
    after any("މ")
  }
  sub {
    from "\u0781\u07b0"
    to "f"
    after any("ފ")
  }
  sub {
    from "\u0781\u07b0"
    to "h"
    after any("ދ")
  }
  sub {
    from "\u0781\u07b0"
    to "h"
    after any("ތ")
  }
  sub {
    from "\u0781\u07b0"
    to "l"
    after any("ލ")
  }
  sub {
    from "\u0781\u07b0"
    to "g"
    after any("ގ")
  }
  sub {
    from "\u0781\u07b0"
    to "h"
    after any("ޏ")
  }
  sub {
    from "\u0781\u07b0"
