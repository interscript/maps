system "ISO:kor-Hang:Latn:1996-method2" {

metadata {
  authority_id iso
  id 1996-method2
  language iso-639-2:kor
  source_script Hang
  destination_script Latn
  name "ISO/TR 11941:1996 Information and documentation -- Transliteration of Korean script into Latin characters (Method 2)"
  url https://www.iso.org/standard/20564.html
  creation_date 1996
  adoption_date 
  description Establishes a system for the transliteration of the characters of Korean script into Latin characters. Intended to provide a means for international communication of written documents.

  notes { }
}

tests {
  # Tests from https://www.eki.ee/wgrs/rom2_ko.pdf
   "꽃이" ->  "ggoc'i" # Bad OCR
   "강에" ->  "gang'e"
   "앉아라" ->  "anj'ara"
   "아까" ->  "a'gga"
   "흰떡" ->  "hyin'ddeog"
  #- source: "유쾌하다" not present in method2
  #  expected: "yu'khwaehata"
  # Tests from https://github.com/interscript/interscript/files/5249245/ISO-TR-11941-1996.pdf
   "애기" ->  "aegi"
   "방" ->  "bang"
   "아이" ->  "a'i"
   "고양이" ->  "go'yang'i"
   "굽이" ->  "gub'i"
   "밖에" ->  "bagg'e"
   "박게" ->  "bagge"
   "바께" ->  "ba'gge"
   "간게" ->  "gange"
   "안자라" ->  "anjara"
   "오빠" ->  "o'bba"
   "어찌" ->  "eo'jji"
   "아씨" ->  "a'ssi"
}

dependency "var-kor"
dependency "var-kor-Hang-Hang-jamo" as hangjamo


stage main {
  run  map.hangjamo.stage.main

  # Marks A, B, C
  sub {
    from "ᄋ"
    to ""
    not_before jamo
  }
  sub "ᄋ" "'"
  sub "ᆼ" "ng"

  # Note 4: add apostrophe before 5 double consonants at initial position
  #         unless start of the word
  sub {
    from none
    to "'"
    before jamo
    after double_cons_jamo
  }
  # Note 4: (only method 1) same but with 4 aspirated
  #- pattern: "(?<=\\p{Hangul})([ᄏᄐᄑᄎ])"
  #  result: "'\\1"

  parallel {
    # Consonants differing between method1 and method2
    sub {
    from any("ᄀᆨ")
    to "g"
  }
    sub {
    from any("ᄏᆿ")
    to "k"
  }
    sub {
    from any("ᄁᆩ")
    to "gg"
  }
    sub {
    from any("ᄃᆮ")
    to "d"
  }
    sub {
    from any("ᄐᇀ")
    to "t"
  }
    sub {
    from any("ᄄퟍ")
    to "dd"
  }
    sub {
    from any("ᄇᆸ")
    to "b"
  }
    sub {
    from any("ᄑᇁ")
    to "p"
  }
    sub {
    from any("ᄈퟦ")
    to "bb"
  }
    sub {
    from any("ᄌᆽ")
    to "j"
  }
    sub {
    from any("ᄎᆾ")
    to "c"
  }
    sub {
    from any("ᄍퟹ")
    to "jj"
  }
    # End

    # Composite differing consonants (cons. https://en.wikipedia.org/wiki/ISO/TR_11941 )
    sub {
    from any("ᆪ")
    to "gs"
  }
    sub {
    from any("ꥤ")
    to "rg"
  }
    sub {
    from any("ᆰ")
    to "lg"
  }
    sub {
    from any("ᆴ")
    to "lt"
  }
    sub {
    from any("ꥩ")
    to "rb"
  }
    sub {
    from any("ᆲ")
    to "lb"
  }
    sub {
    from any("ᆵ")
    to "lp"
  }
    sub {
    from any("ᅜᆬ")
    to "nj"
  }
    sub {
    from any("ᄡᆹ")
    to "bs"
  }
    # End

    # Other consonants
    sub {
    from any("ᄉᆺ")
    to "s"
  }
    sub {
    from any("ᄊᆻ")
    to "ss"
  }
    sub {
    from any("ᄒᇂ")
    to "h"
  }
    sub {
    from any("ᄂᆫ")
    to "n"
  }
    sub {
    from any("ᄅ")
    to "r"
  }
    sub {
    from any("ᆯ")
    to "l"
  }
    sub {
    from any("ᄆᆷ")
    to "m"
  }
    # End

    # Other composite consonants (cons. https://en.wikipedia.org/wiki/ISO/TR_11941 )
    sub {
    from any("ꥬ")
    to "rs"
  }
    sub {
    from any("ᆳ")
    to "ls"
  }
    sub {
    from any("ꥨ")
    to "rm"
  }
    sub {
    from any("ᆱ")
    to "lm"
  }
    sub {
    from any("ᄚ")
    to "rh"
  }
    sub {
    from any("ᆶ")
    to "lh"
  }
    sub {
    from any("ᅝᆭ")
    to "nh"
  }
    # End

    # Vowels
    sub "ᅡ" "a"
    sub "ᅥ" "eo"
    sub "ᅩ" "o"
    sub "ᅮ" "u"
    sub "ᅳ" "eu"
    sub "ᅵ" "i"
    sub "ᅢ" "ae"
    sub "ᅦ" "e"
    sub "ᅬ" "oe"
    sub "ᅣ" "ya"
    sub "ᅧ" "yeo"
    sub "ᅭ" "yo"
    sub "ᅲ" "yu"
    sub "ᅤ" "yae"
    sub "ᅨ" "ye"
    sub "ᅪ" "wa"
    sub "ᅯ" "weo"
    sub "ᅱ" "wi"
    sub "ᅫ" "wae"
    sub "ᅰ" "we"
    sub "ᅴ" "yi"
    # End
  }
}
}
