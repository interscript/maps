  #   expected: al-ikhbār ‘ammā sa-yakūn
  # From Rule 14 - part a
  # - source:  أُصُولَهَا النَفسِيَّة وَطُرُق تَدرِيسِهَا # issue wa-ṭuruq
  #   expected: uṣūluhā al-nafsīyah wa-ṭuruq tadrīsihā
   "إلَى يَومِنَا هَذَا" ->  "ilá yawminā hādhā"
  # From Rule 15 - part a
  # - source: انا وانت # issue waw atf
  #   expected: anā wa-anta
   "هَذِهِ الحَال" ->  "hādhihi al-ḥāl"
  # - source: مُؤَلَّفَاتُهُ وَشُرُوحُهَا
  #   expected: mu’allafātuhu wa-shurūḥuhā
  # From Rule 15 - part b
  # - source: حياته وعصره
  #   expected: ḥayātuhu wa-‘aṣruh
   "تَوفِيق الحَكِيم، أَفكَارُه، آثَارُه" ->  "tawfīq al-ḥakīm, afkāruh, āthāruh"
  # From Rule 16 - part a
   "أَنَّ" ->  "anna"
   "أَنَّهُ" ->  "annahu"
   "بَينَ يَدَيهِ" ->  "bayna yadayhi"
  # From Rule 16 - part b
  # - source: به
  #   expected: bi-hi
  # - source: ومعه
  #   expected: wa-ma‘ahu
  # - source: لاسلكي
  #   expected: lā-silkī
  # From Rule 17 - part a
   "الكِتَاب الثَانِي" ->  "al-kitāb al-thānī"
   "الإتِّحَاد" ->  "al-ittiḥād"
   "الأَصل" ->  "al-aṣl"
   "الآثَار" ->  "al-āthār"
  # From Rule 17 - part b
   "إلَى الآن" ->  "ilá al-ān"
   "ابُو الوَفَاء" ->  "abū al-wafā’"
   "مَكتَبَة النَهضَة المِصرِيَّة" ->  "maktabat al-nahḍah al-miṣrīyah"
  # - source: بالتمام والكمال
  #   expected: bi-al-tamām wa-al-kamāl
  # - source: للشربيني
  #   expected: lil-Shirbīnī
  # From Rule 17 - part c
   "الحُرُوف الأَبجَدِيَّة" ->  "al-ḥurūf al-abjadīyah"
   "ابُو اللَيث السَمَرقَندِي" ->  "abū al-layth al-samarqandī"
  # From Rule 18 - part b
   "الإيجِي" ->  "al-ījī"
   "الآلُوسِي" ->  "al-ālūsī"
  # From Rule 19
  # - source: إبراهيم ، إبرهيم
  #   expected: Ibrāhīm
  # - source: داؤود ، داؤد
  #   expected: Dā’ūd
  # - source: ابو الحسن
  #   expected: Abū al-Ḥasan
   "رُؤُوس" ->  "ru’ūs"
  # - source: ذَلِكَ
  #   expected: dhālika
   "عَلَى العَين" ->  "‘alá al-‘ayn"
  #   # From Rule 21 - part a
  # - source: أدهم
  #   expected: Adʹham
  # - source: أكرمتها
  #   expected: akramatʹhā
  #   # From Rule 21 - part b
  # - source: قلعه‌جى
  #   expected: Qal‘ahʹjī
  # - source: شيخ زاده
  #   expected: Shaykhʹzādah
  # From Rule 22
   "جَارمَانُوس" ->  "jārmānūs" # not Germanos nor Germanus
   "لُورد غرَانفِيل" ->  "lūrd ghrānfīl" # not Lord Granville
   "إيسَاغُوجِي" ->  "īsāghūjī" # not Isagoge
  # - source: غرسيا خين
  #   expected: Gharsiyā Khayin # not García Jaén
  # From Rule 23
   "اللَّه" ->  "Allāh"
  # - source: بسم الله
  #   expected: bismillāh
  #   # From Rule 24
  # - source: طه
  #   expected: Ṭāhā
  # - source: يس ، يسن
  #   expected: Yāsīn
  # - source: عمرو
  #   expected: ‘Amr
  # - source: بهجت ، بهجة
  #   expected: Bahjat
  #   # From Rule 25
  # - source: احمد بن محمد بن ابي الربيع
  #   expected: Aḥmad ibn Muḥammad ibn Abī al-Rabī‘
  # - source: شرح ابن عقيل على الفية ابن مالك
  #   expected: Sharḥ Ibn ‘Aqīl ‘alá Alfīyat Ibn Mālik
  # - source: بن خده
  #   expected: Bin Khiddah
  # - source: بنعبد الله
  #   expected: Bin-‘Abd Allāh
}

