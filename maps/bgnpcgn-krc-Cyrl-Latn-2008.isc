system "BGN-PCGN:krc-Cyrl:Latn:2008" {

metadata {
  authority_id bgnpcgn
  id 2008
  language iso-639-2:krc
  source_script Cyrl
  destination_script Latn
  name Table of Correspondences for Karachay-Balkar (Cyrillic-Roman) (2008 Agreement)
  url https://www.gov.uk/government/organisations/permanent-committee-on-geographical-names
  creation_date 2008
  confirmation_date 2017-10
  description {
    Karachay-Balkar is an official language within Karachayevo-Cherkesiya and
    Kabardino-Balkariya, two of the republics of the Russian Federation. It will normally
    be encountered in Cyrillic script, in which case it should be romanized by means of
    the Cyrillic-Roman table of correspondences given below.
  }

  notes {
    note "The characters в, ц, щ and ь occur only in loan words."
    note "J is the appropriate Roman rendering for ж, except when it occurs as a component of дж, which is rendered in Roman as a unitary character c."
    note "У should be romanized as u, except when preceded by а, е, ё, и, о, у, ы, ю or я when it should be rendered w (e.g. яу = yaw)."
    note "Ъ is not romanized, except in the combinations гъ, къ or нъ, which are rendered in Roman as ğ, q and ng respectively."
    note "The Roman rendering yu is sometimes encountered in loan words and after certain vowels; this map renders ю as ü throughout."
    note "An inventory of letter-diacritic combinations, with their Unicode encoding, in addition to the unmodified letters of the basic Roman script is:"
    note "Ğ (U+011E)  ğ (U+011F)  Ö (U+00D6)  ö (U+00F6)  İ (U+0130)  ı (U+0131)  Ç (U+00C7)  ç (U+00E7)  Ş (U+015E)  ş (U+015F)  Ü (U+00DC)  ü (U+00FC)"
    note "The Roman-script columns show only lowercase forms but, when applying the table, uppercase and lowercase Roman letters as appropriate should be used."
  }
}

tests {
  # every table row, upper and lower
   "А" ->  "A"
   "а" ->  "a"
   "Б" ->  "B"
   "б" ->  "b"
   "В" ->  "V"
   "в" ->  "v"
   "Г" ->  "G"
   "г" ->  "g"
   "Гъ" ->  "Ğ"
   "гъ" ->  "ğ"
   "Д" ->  "D"
   "д" ->  "d"
   "Дж" ->  "C"
   "дж" ->  "c"
   "Е" ->  "E"
   "е" ->  "e"
   "Ё" ->  "Ö"
   "ё" ->  "ö"
   "Ж" ->  "J"
   "ж" ->  "j"
   "З" ->  "Z"
   "з" ->  "z"
   "И" ->  "İ"
   "и" ->  "i"
   "Й" ->  "Y"
   "й" ->  "y"
   "К" ->  "K"
   "к" ->  "k"
   "Къ" ->  "Q"
   "къ" ->  "q"
   "Л" ->  "L"
   "л" ->  "l"
   "М" ->  "M"
   "м" ->  "m"
   "Н" ->  "N"
   "н" ->  "n"
   "Нъ" ->  "Ng"
   "нъ" ->  "ng"
   "нг" ->  "ng"
   "Нг" ->  "Ng"
   "О" ->  "O"
   "о" ->  "o"
   "П" ->  "P"
   "п" ->  "p"
   "Р" ->  "R"
   "р" ->  "r"
   "С" ->  "S"
   "с" ->  "s"
   "Т" ->  "T"
   "т" ->  "t"
   "Ў" ->  "W"
   "ў" ->  "w"
   "Ф" ->  "F"
   "ф" ->  "f"
   "Х" ->  "X"
   "х" ->  "x"
   "Ц" ->  "S"
   "ц" ->  "s"
   "Ч" ->  "Ç"
   "ч" ->  "ç"
   "Ш" ->  "Ş"
   "ш" ->  "ş"
   "Щ" ->  "Şç"
   "щ" ->  "şç"
   "Ъ" ->  ""
   "ъ" ->  ""
   "Ы" ->  "I"
   "ы" ->  "ı"
   "Ь" ->  ""
   "ь" ->  ""
   "Э" ->  "E"
   "э" ->  "e"
   "Ю" ->  "Ü"
   "ю" ->  "ü"
   "Я" ->  "Ya"
   "я" ->  "ya"
  # note 3: у after the listed vowels is w; source example яу = yaw
   "яу" ->  "yaw"
   "ую" ->  "uü"  # у + ю
   "эу" ->  "eu"
   "у" ->  "u"
}

stage main {

  # RULES
  # note 3: у after а, е, ё, и, о, у, ы, ю or я is w
  sub {
    from "У"
    to "W"
    before any("АаЕеЁёИиОоУуЫыЮюЯя")
  }
  sub {
    from "у"
    to "w"
    before any("АаЕеЁёИиОоУуЫыЮюЯя")
  }

  # CHARACTERS
  parallel {
    sub "НГ" "NG"
    sub "Нг" "Ng"
    sub "Гъ" "Ğ"
    sub "Къ" "Q"
    sub "Нъ" "Ng"
    sub "Дж" "C"
    sub "Ё" "Ö"
    sub "И" "İ"
    sub "Ч" "Ç"
    sub "Ш" "Ş"
    sub "Щ" "Şç"
    sub "Ы" "I"
    sub "Ю" "Ü"
    sub "Я" "Ya"
    sub "Ў" "W"
    sub "Ъ" ""
    sub "Ь" ""
    sub "А" "A"
    sub "Б" "B"
    sub "В" "V"
    sub "Г" "G"
    sub "Д" "D"
    sub "Е" "E"
    sub "Ж" "J"
    sub "З" "Z"
    sub "Й" "Y"
    sub "К" "K"
    sub "Л" "L"
    sub "М" "M"
    sub "Н" "N"
    sub "О" "O"
    sub "П" "P"
    sub "Р" "R"
    sub "С" "S"
    sub "Т" "T"
    sub "У" "U"
    sub "Ф" "F"
    sub "Х" "X"
    sub "Ц" "S"
    sub "Э" "E"

    sub "нг" "ng"
    sub "нъ" "ng"
    sub "гъ" "ğ"
    sub "къ" "q"
    sub "дж" "c"
    sub "ё" "ö"
    sub "и" "i"
    sub "ч" "ç"
    sub "ш" "ş"
    sub "щ" "şç"
    sub "ы" "ı"
    sub "ю" "ü"
    sub "я" "ya"
    sub "ў" "w"
    sub "ъ" ""
    sub "ь" ""
    sub "а" "a"
    sub "б" "b"
    sub "в" "v"
    sub "г" "g"
    sub "д" "d"
    sub "е" "e"
    sub "ж" "j"
    sub "з" "z"
    sub "й" "y"
    sub "к" "k"
    sub "л" "l"
    sub "м" "m"
    sub "н" "n"
    sub "о" "o"
    sub "п" "p"
    sub "р" "r"
    sub "с" "s"
    sub "т" "t"
    sub "у" "u"
    sub "ф" "f"
    sub "х" "x"
    sub "ц" "s"
    sub "э" "e"
  }

}

}
