system "BGN-PCGN:krc-Cyrl:Latn:2008" {

metadata {
  authority_id bgnpcgn
  id 2008
  language iso-639-2:krc
  source_script Cyrl
  destination_script Latn
  name Table of Correspondences for Karachay-Balkar (Cyrillic-Roman) (BGN/PCGN 2008 Agreement)
  url https://geonames.nga.mil/gns/html/Romanization/TABLE%20OF%20CORRESPONDENCES%20FOR%20KARACHAY-BALKAR.pdf
  creation_date 2008
  confirmation_date 2017-10
  description {    Karachay-Balkar is an official language within Karachayevo-Cherkesiya and
    Kabardino-Balkariya, two of the republics of the Russian Federation. It will normally
    be encountered in Cyrillic script, in which case it should be romanized by means of
    the Cyrillic-Roman table of correspondences given below.
  }

  notes {
    note "Rows В, Щ and Ь occur only in loan words."
    note "J is the appropriate Roman rendering for Ж, except when it occurs as a component of дж, which is rendered in Roman as a unitary character c."
    note "У should be romanized as u, except when preceded by а, е, ë, и, о, у, ы, ю or я when it should be rendered “w” (eg. яу = yaw)."
    note "Ъ is not romanized, except in the combinations гъ, къ or нъ, which are rendered in Roman as ğ, q and ng respectively."
    note "The Roman rendering yu is sometimes encountered in loan words and after certain vowels."
    note "An inventory of letter-diacritic combinations, with their Unicode encoding, in addition to the unmodified letters of the basic Roman script is:\n\nĞ (U+011E) ğ (U+011F)\nÖ (U+00D6) ö (U+00F6)\nİ (U+0130) ı (U+0131)\nÇ (U+00C7) ç (U+00E7)\nŞ (U+015E) ş (U+015F)\nÜ (U+00DC) ü (U+00FC)"
    note "The Roman-script columns show only lowercase forms but, when applying the table, uppercase and lowercase Roman letters as appropriate should be used."
    note "Row 19 of the source table renders both нъ (U+041D+U+042A / U+043D+U+044A) and нг (U+041D+U+0413 / U+043D+U+0433) as Ng/ng; only нъ’s Unicode points are listed in the source."
  }
}

tests {
   "Къарачай-Малкъар" ->  "Qaraçay-Malqar"
   "Минги Тау" ->  "Mingi Taw"
   "яу" ->  "yaw"
   "ачыу" ->  "açıw"
   "ауруу" ->  "awruw"
   "джуукъ" ->  "cuwq"
   "жюрек" ->  "jürek"
   "жылдыз" ->  "jıldız"
   "Къобан" ->  "Qoban"
   "Эль-Джугъу" ->  "El-Cuğu"
   "церковь" ->  "serkov"
   "борщ" ->  "borşç"
   "Исмайыл" ->  "İsmayıl"
   "энчи" ->  "ençi"
   "аўул" ->  "awul"
}

aliases {
  krc_vowel = any("АаЕеЁёИиОоУуЫыЮюЯя")
}

stage main {

  # RULES
  # note[3]: У is romanized u, except when preceded by а, е, ë, и, о,
  # у, ы, ю or я when it is rendered "w" (eg. яу = yaw)
  sub {
    from "у"
    to "w"
    before krc_vowel
  }
  sub {
    from "У"
    to "W"
    before krc_vowel
  }

  # CHARACTERS
  parallel {
    sub "А" "A"
    sub "а" "a"
    sub "Б" "B"
    sub "б" "b"
    sub "В" "V"
    sub "в" "v"
    sub "Г" "G"
    sub "г" "g"
    sub "Гъ" "Ğ"
    sub "гъ" "ğ"
    sub "Д" "D"
    sub "д" "d"
    sub "Дж" "C"
    sub "дж" "c"
    sub "Е" "E"
    sub "е" "e"
    sub "Ё" "Ö"
    sub "ё" "ö"
    sub "Ж" "J"
    sub "ж" "j"
    sub "З" "Z"
    sub "з" "z"
    sub "И" "İ"
    sub "и" "i"
    sub "Й" "Y"
    sub "й" "y"
    sub "К" "K"
    sub "к" "k"
    sub "Къ" "Q"
    sub "къ" "q"
    sub "Л" "L"
    sub "л" "l"
    sub "М" "M"
    sub "м" "m"
    sub "Н" "N"
    sub "н" "n"
    sub "Нъ" "Ng"
    sub "нъ" "ng"
    sub "Нг" "Ng"
    sub "нг" "ng"
    sub "О" "O"
    sub "о" "o"
    sub "П" "P"
    sub "п" "p"
    sub "Р" "R"
    sub "р" "r"
    sub "С" "S"
    sub "с" "s"
    sub "Т" "T"
    sub "т" "t"
    sub "У" "U"
    sub "у" "u"
    sub "Ў" "W"
    sub "ў" "w"
    sub "Ф" "F"
    sub "ф" "f"
    sub "Х" "X"
    sub "х" "x"
    sub "Ц" "S"
    sub "ц" "s"
    sub "Ч" "Ç"
    sub "ч" "ç"
    sub "Ш" "Ş"
    sub "ш" "ş"
    sub "Щ" "Şç"
    sub "щ" "şç"
    sub "Ъ" ""
    sub "ъ" ""
    sub "Ы" "I"
    sub "ы" "ı"
    sub "Ь" ""
    sub "ь" ""
    sub "Э" "E"
    sub "э" "e"
    sub "Ю" "Ü"
    sub "ю" "ü"
    sub "Я" "Ya"
    sub "я" "ya"
  }
}
}
