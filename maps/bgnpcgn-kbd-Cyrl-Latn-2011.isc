   "Г" ->  "G"
   "г" ->  "g"
   "Гу" ->  "Gw"
   "гу" ->  "gw"
   "Гъ" ->  "Gh"
   "гъ" ->  "gh"
   "Гъу" ->  "Ghw"
   "гъу" ->  "ghw"
   "Д" ->  "D"
