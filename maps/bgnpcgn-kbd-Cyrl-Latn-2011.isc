   "КӀу" ->  "Kw’"
   "кӀу" ->  "kw’"
   "Къ" ->  "Q’"
   "къ" ->  "q’"
   "Къу" ->  "Qw’"
   "къу" ->  "qw’"
   "Кхъ" ->  "Q"
   "кхъ" ->  "q"
   "Кхъу" ->  "Qw"
   "кхъу" ->  "qw"
   "Л" ->  "L"
   "л" ->  "l"
   "Лъ" ->  "Lh"
   "лъ" ->  "lh"
   "ЛӀ" ->  "L’"
   "лӀ" ->  "l’"
