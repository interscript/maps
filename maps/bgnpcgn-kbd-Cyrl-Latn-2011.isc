    sub "Ч" "Ch"
    sub "ч" "ch"
    sub "Ш" "Sh"
    sub "ш" "sh"
    sub "Щ" "Ś"
    sub "щ" "ś"
    sub "ЩӀ" "Ś’"
    sub "щӀ" "ś’"
    sub "Ъ" "’’"
    sub "ъ" "’’"
    sub "Ы" "Y"
    sub "ы" "y"
    sub "Ь" "’"
    sub "ь" "’"
    sub "Ю" "Yu"
    sub "ю" "yu"
    sub "Я" "Ya"
    sub "я" "ya"
    sub "Ӏ" "’"
    sub "Ӏу" "’w"
  }
}
}
