   "п" ->  "p"
   "ПӀ" ->  "P’"
   "пӀ" ->  "p’"
   "Р" ->  "R"
   "р" ->  "r"
   "С" ->  "S"
   "с" ->  "s"
   "Т" ->  "T"
   "т" ->  "t"
   "ТӀ" ->  "T’"
   "тӀ" ->  "t’"
   "Ф" ->  "F"
   "ф" ->  "f"
   "ФӀ" ->  "F’"
   "фӀ" ->  "f’"
   "Х" ->  "Kh"
   "х" ->  "kh"
   "Ху" ->  "Khw"
   "ху" ->  "khw"
   "Хь" ->  "H̱"
   "хь" ->  "ẖ"
   "Хъ" ->  "X"
   "хъ" ->  "x"
   "Хъу" ->  "Xw"
   "хъу" ->  "xw"
   "Ц" ->  "Ts"
   "ц" ->  "ts"
   "ЦӀ" ->  "Ts’"
   "цӀ" ->  "ts’"
   "Ч" ->  "Ch"
   "ч" ->  "ch"
   "Ш" ->  "Sh"
   "ш" ->  "sh"
   "Щ" ->  "Ś"
   "щ" ->  "ś"
   "ЩӀ" ->  "Ś’"
   "щӀ" ->  "ś’"
   "Ъ" ->  "’’"
   "ъ" ->  "’’"
   "Ы" ->  "Y"
   "ы" ->  "y"
   "Ь" ->  "’"
   "ь" ->  "’"
   "Ю" ->  "Yu"
   "ю" ->  "yu"
   "Я" ->  "Ya"
   "я" ->  "ya"
   "Ӏ" ->  "’"
   "Ӏу" ->  "’w"
  # note 1: У word-initially w, elsewhere u
   "У" ->  "W"
   "у" ->  "w"
   "Ужи" ->  "Wzhi"
   "мау" ->  "mau"
}

stage main {

  # RULES
  # note 1: У word-initially w, elsewhere u
  sub {
    from boundary + "У"
    to "W"
  }
  sub {
    from boundary + "у"
    to "w"
  }

  # CHARACTERS
  parallel {
    sub "Кхъу" "Qw"
    sub "Гъу" "Ghw"
    sub "Къу" "Qw’"
    sub "КӀу" "Kw’"
