system "ALA-LC:bod-Tibt:Latn:2015" {

metadata {
  authority_id alalc
  id 2015
  language iso-639-2:bod
  source_script Tibt
  destination_script Latn
  name "Tibetan Romanization Table (2015)"
  url https://www.loc.gov/catdir/cpso/romanization/tibetan.pdf
  creation_date 2015
  adoption_date
  description {    ALA-LC Tibetan Romanization Table, 2015 version — the Wylie
    system. Every base consonant carries the inherent vowel a (Note 2);
    stacked consonants romanize as the consonant sequence with the
    implicit a of the final member; the thirteen vowel signs include
    the vocalic r and l and the a-chung lengthening (ā); the ʼa chung
    (འ) romanizes as the alif. Non-Tibetan retroflex and aspirate
    extensions per the special-letter section. Transcribed from the
    loc.gov document.
  }

  notes {
    note "Note 3: the ʼa chung is the alif unless marked with a vowel
    sign (then alif + vowel). Notes 8-9: the non-joiner disambiguator
    ʹ appears in the documented stacks gʹya and nʹya (p. 2-3), and in
    the Note 9 example tʹsa, the stack of ཏ + ས, now encoded. Stacked
    consonants are explicit in Unicode as subjoined letters (U+0F90
    ff.); per the Wylie principles the table follows (p. 1) and Note 9
    (p. 3, there is no need to indicate the stacking), each stack
    romanizes as its consonant sequence with the implicit vowel a of
    the final member. The 2025 corpus repair applied this to the
    combination grid (e.g. ཀྐ = kka) and used the source letter values
    for the subjoined non-Tibetan letters (ṣa ཥ, p. 2; ḍha ཌྷ, p. 2;
    dzha ཛྷ, p. 2). Anomalies recorded, behavior unchanged: the
    standalone ཤ ས ཧ ཨ rows carry concatenated vowel artifacts of the
    original text-layer transcription (the source consonant table,
    p. 1, gives sha, sa, ha, a); the non-Tibetan letters ཛྷ ཥ ཌྷ (p. 2)
    are not encoded as standalone base consonants; tsheg is dropped
    rather than spaced or hyphenated (Punctuation 1, p. 3)."
  }
}

tests {
   "\u0f40\u0f0b" ->  "ka"
   "\u0f40\u0f71\u0f0b" ->  "kā"
   "\u0f40\u0f90\u0f0b" ->  "kka"
   "\u0f40\u0f7a\u0f0b" ->  "ke"
   "\u0f40\u0f72\u0f42\u0f0b" ->  "kiga"
}

