system "ALA-LC:sat-Olck:Latn:2017" {

metadata {
  authority_id alalc
  id 2017
  language iso-639-2:sat
  source_script Olck
  destination_script Latn
  name "Santali (in Ol script) Romanization Table (2017)"
  url https://www.loc.gov/catdir/cpso/romanization/santali.pdf
  creation_date 2017
  adoption_date
  description {    ALA-LC Santali (Ol Chiki) Romanization Table, 2017 version.
    Pure letter substitution: seven vowels, twenty-five consonants and
    marks including the relwa (ᱽ), the nasalization dot (ᱸ → m̐), the
    omitted low-pitch mark (ᱹ), and the prolongation mark (ᱻ,
    omitted). Transcribed from the loc.gov document's complete text
    layer.
  }

  notes {
    note "Note 1: relwa ᱽ follows the four checked consonants (g j d b
    written with it as ᱜ ᱡ ᱫ ᱵ — the table lists the modified
    letterforms as letters in their own right). Note 2: ᱸ = m̐ after
    the vowel; ᱹ is omitted."
  }
}

tests {
   "\u1c60" ->  "k"
# Exhaustive per-row tests for alalc-sat-Olck-Latn-2017, generated from the source
# document's table.
# Source: ALA-LC Santali (in Ol script) Romanization Table, 2017 version, p.
# 1 (letter table) + p. 2 (other marks); held source
# interscript-private-references/alalc/alalc-santali.pdf. Extraction: PDF
# text layer, every value cell cross-checked against the rendered page
# image. ᱟᱹ is the table's own composite row (ᱟ + the nasalization dot) with
# printed value ạ̄ (a + dot below, U+0323). The ᱽ row's printed value is "’
# (apostrophe)" with "(see Note 1)" stripped per the proven pattern; Note
# 1's statement that the four checked host consonants romanize plain
# (g/j/d/b) is instruction prose, not a value cell. ᱦ and ᱷ are two distinct
# printed keys both romanized h. Document order = vowels then consonants, as
# printed. Skipped printed rows: ᱸ — printed value cell "m̐ (see Note 2)":
# the mark romanizes as m̐ after the vowel it modifies — a mark applied to a
# preceding vowel, not a standalone transliteration string; skipped as
# context-dependent. (The composite row ᱟᱹ -> ạ̄ above is the table's own
# printed composite and is tested.) | The marks ᱻ (vowel prolongation,
# omitted) and ᱼ (separator, omitted) — instruction rows on p. 2, no
# romanization values. Failing printed rows (findings): ᱱ — printed cell
# "n"; runtime gives 'ᱱ'. Failing row, finding below — never forced green.
# Provenance artifact: scripts/row-sources/alalc-sat-Olck-Latn-2017.json (31 rows).
# generated-by: maps/scripts/gen-row-tests.mjs (2026-11-16); regenerate from the artifact, do not hand-edit.
  "ᱚ" -> "a"
  "ᱩ" -> "u"
  "ᱟ" -> "ā"
  "ᱮ" -> "e"
  "ᱟᱹ" -> "ạ̄"
  "ᱳ" -> "o"
