  "ᱴ" -> "ṭ"
  "ᱣ" -> "w"
  "ᱰ" -> "ḍ"
  "ᱥ" -> "s"
  "ᱲ" -> "ṛ"
  "ᱦ" -> "h"
  "ᱬ" -> "ṇ"
  "ᱷ" -> "h"
  "ᱛ" -> "t"
  "ᱫ" -> "d"
  "ᱝ" -> "ṃ"
  "ᱽ" -> "’"
}

