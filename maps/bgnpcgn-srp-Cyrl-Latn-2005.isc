system "BGN-PCGN:srp-Cyrl:Latn:2005" {

metadata {
  authority_id bgnpcgn
  id 2005
  language iso-639-2:srp
  source_script Cyrl
  destination_script Latn
  name Table of Correspondences for Serbian (Cyrillic-Roman) (2005 Agreement)
  url https://assets.publishing.service.gov.uk/government/uploads/system/uploads/attachment_data/file/816783/TABLE_OF_CORRESPONDENCES_FOR_SERBIAN.pdf
  creation_date 2005
  confirmation_date 2019-06
  description {    The tabulation below reflects the Serbian Cyrillic alphabet and the standard Roman script equivalents
    used in both Serbia and Montenegro.
  }

  notes {
    note "The Serbian Cyrillic lowercase italic Д may sometimes be seen as g.\n There is no specific Unicode encoding for this variant form so a comparable character\n has been used here for illustrative purposes."

    note "The digraph dj(Dj) will occasionally be found as an alternative form of đ(Đ)."

    note "The Serbian Cyrillic lowercase italic П may sometimes be seen as ӣ.\n There is no specific Unicode encoding for this variant form so a comparable character\n has been used here for illustrative purposes."

    note "The Serbian Cyrillic lowercase italic Т may sometimes be seen as w.\n There is no specific Unicode encoding for this variant form so a comparable character\n has been used here for illustrative purposes."

    note "      An inventory of letter-diacritic combinations, with their Unicode encoding,\n      in addition to the unmodified letters of the basic Roman script is:\n      | Đ (U+0110)   | đ (U+0111)   |\n      | Ž (U+017D)   | ž (U+017E)   |\n      | Lj (U+01C8)* | lj (U+01C9)* |\n      | Ć (U+0106)   | ć (U+0107)   |\n      | Dž (U+01C5)* | dž (U+01C6)* |\n      | Š (U+0160)   | š (U+0161)   |\n      * Note that these characters can also be reproduced with individual letters (e.g. l+j)."

    note "The Roman-script columns show only lowercase forms but, when applying the table,\n uppercase and lowercase Roman letters as appropriate should be used."
  }
}

tests {
   "Шупља Стена" ->  "Šuplja Stena"
   "Чукарица" ->  "Čukarica"
   "Црна Трава" ->  "Crna Trava"
   "Херцег Нови" ->  "Herceg Novi"
   "Улцињ" ->  "Ulcinj"
   "Ужице" ->  "Užice"
   "Тресаначка Река" ->  "Tresanačka Reka"
   "Сјеница" ->  "Sjenica"
   "Рожаје" ->  "Rožaje"
   "Пљевља" ->  "Pljevlja"
   "Оџаци" ->  "Odžaci"
   "Никшић" ->  "Nikšić"
   "Медвеђа" ->  "Medveđa"
   "Лозница" ->  "Loznica"
   "Књажевац" ->  "Knjaževac"
   "Зрењанин" ->  "Zrenjanin"
   "Житорађа" ->  "Žitorađa"
   "Ервеник" ->  "Ervenik"
   "Доње Љупче" ->  "Donje Ljupče"
   "Гусиње" ->  "Gusinje"
   "ГУСИЊЕ" ->  "GUSINJE"
   "Врњачка Бања" ->  "Vrnjačka Banja"
   "Бијело Поље" ->  "Bijelo Polje"
   "Алибунар" ->  "Alibunar"
}

aliases {
  srp_multichar = any(["Lj", "Nj", "Dž"])
  srp_latupper = any("A".."Z")
}

stage main {
  # CHARACTERS
  parallel {
    sub "А" "A"
    sub "Б" "B"
    sub "В" "V"
    sub "Г" "G"
    sub "Д" "D"
    sub "Ђ" "Đ"
    sub "Е" "E"
    sub "Ж" "Ž"
    sub "З" "Z"
    sub "И" "I"
    sub "Ј" "J"
    sub "К" "K"
    sub "Л" "L"
    sub "Љ" "Lj"
    sub "М" "M"
    sub "Н" "N"
    sub "Њ" "Nj"
    sub "О" "O"
    sub "П" "P"
    sub "Р" "R"
    sub "С" "S"
    sub "Т" "T"
    sub "Ћ" "Ć"
    sub "У" "U"
    sub "Ф" "F"
    sub "Х" "H"
    sub "Ц" "C"
    sub "Ч" "Č"
    sub "Џ" "Dž"
    sub "Ш" "Š"
    sub "а" "a"
    sub "б" "b"
    sub "в" "v"
    sub "г" "g"
    sub "д" "d"
    sub "ђ" "đ"
    sub "е" "e"
    sub "ж" "ž"
    sub "з" "z"
    sub "и" "i"
    sub "ј" "j"
    sub "к" "k"
    sub "л" "l"
    sub "љ" "lj"
    sub "м" "m"
    sub "н" "n"
    sub "њ" "nj"
    sub "о" "o"
    sub "п" "p"
    sub "р" "r"
    sub "с" "s"
    sub "т" "t"
    sub "ћ" "ć"
    sub "у" "u"
    sub "ф" "f"
    sub "х" "h"
    sub "ц" "c"
    sub "ч" "č"
    sub "џ" "dž"
    sub "ш" "š"
  }

  # POSTRULES
  sub {
    from srp_multichar
    to upcase
    before srp_latupper
  }
  sub {
    from srp_multichar
    to upcase
    after srp_latupper
  }
  compose
}
}
