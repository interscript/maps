    sub "ノ" "no"
    sub "ハ" "ha"  # chart note i
    sub "ヒ" "hi"
    sub "フ" "fu"  # footnote 3
    sub "ヘ" "he"  # chart note i
    sub "ホ" "ho"
    sub "マ" "ma"
    sub "ミ" "mi"
    sub "ム" "mu"
    sub "メ" "me"
    sub "モ" "mo"
    sub "ヤ" "ya"
    sub "ユ" "yu"
    sub "ヨ" "yo"
    sub "ラ" "ra"
    sub "リ" "ri"
    sub "ル" "ru"
    sub "レ" "re"
    sub "ロ" "ro"
    sub "ワ" "wa"
    sub "ヰ" "i"
    sub "ヱ" "e"
    sub "ヲ" "o"  # footnote 4
    sub "ン" "n"  # footnote 5

    # Katakana dakuten/handakuten
    sub "ガ" "ga"
