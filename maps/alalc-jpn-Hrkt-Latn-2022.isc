   "じ" ->  "ji"
   "ん" ->  "n"
   "ン" ->  "n"
   "ア" ->  "a"
   "シ" ->  "shi"
  # Chart B cells.
   "いぇ" ->  "ye"
   "うぁ" ->  "wa"
   "うぃ" ->  "wi"
   "うぇ" ->  "we"
   "うぉ" ->  "wo"
   "くぁ" ->  "kwa"
   "くぃ" ->  "kwi"
   "くぇ" ->  "kwe"
   "くぉ" ->  "kwo"
   "すぃ" ->  "si"
   "すぇ" ->  "swe"
   "ぐぁ" ->  "gwa"
   "ぐぃ" ->  "gwi"
   "ぐぇ" ->  "gwe"
   "ぐぉ" ->  "gwo"
   "ずぃ" ->  "zi"
   "つぁ" ->  "tsa"
