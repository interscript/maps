   "ひぇ" ->  "hye"
   "ひぉ" ->  "hyo"
   "みぃ" ->  "mī"
   "りぃ" ->  "rī"
   "ぎぃ" ->  "gī"
   "ぢゃ" ->  "ja"
   "ぢゅ" ->  "ju"
   "ぢぇ" ->  "je"
   "びぃ" ->  "bī"
   "びぉ" ->  "byo"
   "ぴぃ" ->  "pī"
   "ぴょ" ->  "pyo"
   "ぴぉ" ->  "pyo"
   "ゐ" ->  "i"
   "ゑ" ->  "e"
   "ヰ" ->  "i"
   "ヱ" ->  "e"
   "を" ->  "o"
   "ヲ" ->  "o"
   "ぢ" ->  "ji"
