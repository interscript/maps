    sub "みゃ" "mya"
    sub "ミャ" "mya"
    sub "みぃ" "mī"
    sub "ミィ" "mī"
    sub "みゅ" "myu"
    sub "ミュ" "myu"
    sub "みぇ" "mye"
    sub "ミェ" "mye"
    sub "みょ" "myo"
    sub "ミョ" "myo"
    sub "りゃ" "rya"
    sub "リャ" "rya"
    sub "りぃ" "rī"
    sub "リィ" "rī"
    sub "りゅ" "ryu"
    sub "リュ" "ryu"
    sub "りぇ" "rye"
    sub "リェ" "rye"
    sub "りょ" "ryo"
    sub "リョ" "ryo"
    sub "ぎゃ" "gya"
    sub "ギャ" "gya"
    sub "ぎぃ" "gī"
    sub "ギィ" "gī"
    sub "ぎゅ" "gyu"
    sub "ギュ" "gyu"
    sub "ぎぇ" "gye"
    sub "ギェ" "gye"
    sub "ぎょ" "gyo"
    sub "ギョ" "gyo"
    sub "じゃ" "ja"  # footnote 10: zya, zyu, zyo (Kunrei, Nippon)
    sub "ジャ" "ja"  # footnote 10
    sub "じゅ" "ju"  # footnote 10
    sub "ジュ" "ju"  # footnote 10
    sub "じぇ" "je"
    sub "ジェ" "je"
    sub "じょ" "jo"  # footnote 10
    sub "ジョ" "jo"  # footnote 10
    sub "ぢゃ" "ja"  # footnote 11: zya, zyu, zyo (Kunrei); dya, dyu, dyo (Nippon)
    sub "ヂャ" "ja"  # footnote 11
    sub "ぢゅ" "ju"  # footnote 11
    sub "ヂュ" "ju"  # footnote 11
    sub "ぢぇ" "je"
    sub "ヂェ" "je"
    sub "ぢょ" "jo"  # footnote 11
    sub "ヂョ" "jo"  # footnote 11
    sub "びゃ" "bya"
    sub "ビャ" "bya"
    sub "びぃ" "bī"
    sub "ビィ" "bī"
    sub "びゅ" "byu"
    sub "ビュ" "byu"
    sub "びぇ" "bye"
