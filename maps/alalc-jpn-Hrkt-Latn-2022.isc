    sub "ヴュ" "vyu"
    sub "でぃ" "di"
    sub "ディ" "di"
    sub "どぅ" "du"
    sub "ドゥ" "du"
    sub "でゅ" "dyu"
    sub "デュ" "dyu"

    # Chart B note iii: sequences not found in the tables romanize as
    # if the added small characters were regular characters
    # (e.g. アィ ai, スェ sue, ヴィァ via).
    sub "ぁ" "a"
    sub "ぃ" "i"
    sub "ぅ" "u"
    sub "ぇ" "e"
    sub "ぉ" "o"
    sub "ァ" "a"
    sub "ィ" "i"
    sub "ゥ" "u"
    sub "ェ" "e"
    sub "ォ" "o"

    # 4.2 punctuation and typographical marks with roman equivalents
    sub "、" ","
    sub "。" "."
    sub "？" "?"
    sub "！" "!"
    sub "〜" "-"  # tilde: hyphen between dates, from ... to ...
    # 4.2 quotation mark types 1 and 2
    sub "「" "\""
    sub "」" "\""
    sub "『" "\""
    sub "』" "\""
    # 4.3 brackets and parentheses
    sub "〈" "<"
    sub "〉" ">"
    sub "《" "<"  # double angle brackets
    sub "》" ">"
    sub "〔" "["
    sub "〕" "]"
    sub "〘" "["
    sub "〙" "]"
    sub "〚" "["
    sub "〛" "]"
    sub "（" "("
    sub "）" ")"
  }

  # POSTRULES
  # Chart A note ii: double consonants (促音) are represented by a
  # doubling of the corresponding consonant (e.g. 圧迫 appaku, 学会
  # gakkai, 突進 tosshin); if a double consonant occurs with ch-, add
  # t instead of doubling c (e.g. 密着 mitchaku, 熱中 netchū, 出張
  # shutchō).
  sub {
    from any("っッ") + capture(any("BbDdFfGgHhJjKkLlMmNnPpQqRrSsTtVvWwXxYyZz"))
    to ref( 1 ) + ref( 1 )
  }
  sub {
    from any("っッ") + capture(any("Cc"))
    to "t" + ref( 1 )
  }
  # A sokuon not followed by a consonant has no romanization in the
  # document; it is realized as an abrupt stop and is dropped here.
  sub {
    from any("っッ")
    to ""
  }

  # 2.5.1: vowels written with a lengthening bar are romanized with a
  # macron (e.g. コンピュータ konpyūta, ニューヨーク Nyū Yōku, そーっと
  # sōtto); 2.5.4: long i after the bar is the macron ī.
  sub {
    from "a" + "ー"
    to "ā"
  }
  sub {
    from "i" + "ー"
    to "ī"
  }
  sub {
    from "u" + "ー"
    to "ū"
  }
  sub {
    from "e" + "ー"
    to "ē"
  }
  sub {
    from "o" + "ー"
    to "ō"
  }
}
}
