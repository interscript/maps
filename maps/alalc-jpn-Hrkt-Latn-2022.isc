   "つぉ" ->  "tso"
   "てぃ" ->  "ti"
   "とぅ" ->  "tu"
   "てゅ" ->  "tyu"
   "ふぁ" ->  "fa"
   "ふぃ" ->  "fi"
   "ふゅ" ->  "fyu"
   "ふぇ" ->  "fe"
   "ふぉ" ->  "fo"
   "ふぃぇ" ->  "fye"
   "ふょ" ->  "fyo"
   "ヴァ" ->  "va"
   "ヴィ" ->  "vi"
   "ヴ" ->  "vu"
   "ヴェ" ->  "ve"
   "ヴォ" ->  "vo"
   "ヴュ" ->  "vyu"
   "でぃ" ->  "di"
   "どぅ" ->  "du"
   "でゅ" ->  "dyu"
  # Chart B note iii examples (as printed; the スェ example contradicts
  # the chart B row swe - see notes).
   "アィ" ->  "ai"
   "ヴィァ" ->  "via"
  # Document examples, 2.4.2.1 (kana-by-kana primary forms).
   "コミユニテイ" ->  "komiyunitei"
   "スタア" ->  "sutaa"
   "テレビジオン" ->  "terebijion"
   "シンポジウム" ->  "shinpojiumu"
   "シンポジューム" ->  "shinpojūmu"
  # 2.5.1 lengthening bar -> macron.
   "コンピュータ" ->  "konpyūta"
   "ウィーク" ->  "wīku"
   "ビードロ" ->  "bīdoro"
   "そーっと" ->  "sōtto"
  # 2.5.4 long i doubled; after the bar, the macron i.
   "ジイサン" ->  "jiisan"
   "びいどろ" ->  "biidoro"
   "ものいい" ->  "monoii"
  # 2.5.5.2.1 morphemic final u verbs (unmerged).
   "ぬう" ->  "nuu"
   "とう" ->  "tou"
   "おもう" ->  "omou"
  # 2.5.5.1 morpheme-boundary examples (unmerged; the 本居 example is
  # kanji-level - Moto+ori - and the contracted kana もとい reads
  # motoi kana-by-kana, so only the kana-expressible cases are tested).
   "こうし" ->  "koushi"
   "ながあめ" ->  "nagaame"
   "かいしゃあん" ->  "kaishaan"
   "くされえん" ->  "kusareen"
  # 5.2 n-apostrophe examples.
   "しんえつ" ->  "shin'etsu"
   "ほんやく" ->  "hon'yaku"
   "しんあいなる" ->  "shin'ainaru"
   "さんおくえん" ->  "san'okuen"
   "しんうち" ->  "shin'uchi"
  # Chart A note ii sokuon examples.
   "あっぱく" ->  "appaku"
   "がっかい" ->  "gakkai"
   "とっしん" ->  "tosshin"
   "みっちゃく" ->  "mitchaku"
}

stage main {

  # RULES
  # 4.4.1: the repetition markers ゝ and ゞ indicate repetition of the
  # previous syllable; the kana is doubled so the charts romanize it
  # twice.
  sub {
    from capture(any("あいうえおかきくけこさしすせそたちつてとなにぬねのはひふへほまみむめもやゆよらりるれろわゐゑをんがぎぐげござじずぜぞだぢづでどばびぶべぼぱぴぷぺぽアイウエオカキクケコサシスセソタチツテトナニヌネノハヒフヘホマミムメモヤユヨラリルレロワヰヱヲンガギグゲゴザジズゼゾダヂヅデドバビブベボパピプペポ")) + any("ゝゞ")
    to ref( 1 ) + ref( 1 )
  }

  # 5.2: transcribe the apostrophe between syllables when the first
  # syllable ends with n and the following syllable begins with a
  # vowel (a, i, u, e, o) or y.
  sub {
    from capture(any("んン"))
    to ref( 1 ) + "'"
    after any("あいうえおやゆよゐゑアイウエオヤユヨヰヱ")
  }

  # CHARACTERS
  parallel {

    # Chart A - Standard Chart

    # Hiragana gojūon
    sub "あ" "a"
    sub "い" "i"
    sub "う" "u"
    sub "え" "e"
    sub "お" "o"
    sub "か" "ka"
    sub "き" "ki"
    sub "く" "ku"
    sub "け" "ke"
    sub "こ" "ko"
    sub "さ" "sa"
    sub "し" "shi"  # footnote 1: si (Kunrei, Nippon)
    sub "す" "su"
    sub "せ" "se"
    sub "そ" "so"
    sub "た" "ta"
    sub "ち" "chi"  # footnote 2: ti, tu (Kunrei, Nippon)
    sub "つ" "tsu"  # footnote 2
    sub "て" "te"
    sub "と" "to"
    sub "な" "na"
    sub "に" "ni"
    sub "ぬ" "nu"
    sub "ね" "ne"
    sub "の" "no"
    sub "は" "ha"  # chart note i: wa as particle (not encoded, see notes)
    sub "ひ" "hi"
    sub "ふ" "fu"  # footnote 3: hu (Kunrei, Nippon)
    sub "へ" "he"  # chart note i: e as particle (not encoded, see notes)
    sub "ほ" "ho"
    sub "ま" "ma"
    sub "み" "mi"
    sub "む" "mu"
    sub "め" "me"
    sub "も" "mo"
    sub "や" "ya"
    sub "ゆ" "yu"
    sub "よ" "yo"
    sub "ら" "ra"
    sub "り" "ri"
    sub "る" "ru"
    sub "れ" "re"
    sub "ろ" "ro"
    sub "わ" "wa"
    sub "ゐ" "i"
    sub "ゑ" "e"
    sub "を" "o"  # footnote 4: always o regardless of usage
    sub "ん" "n"  # footnote 5: always n, never m

    # Hiragana dakuten/handakuten
    sub "が" "ga"
    sub "ぎ" "gi"
    sub "ぐ" "gu"
    sub "げ" "ge"
    sub "ご" "go"
    sub "ざ" "za"
    sub "じ" "ji"  # footnote 6: zi (Kunrei, Nippon)
    sub "ず" "zu"
    sub "ぜ" "ze"
    sub "ぞ" "zo"
    sub "だ" "da"
    sub "ぢ" "ji"  # footnote 7: zi, zu (Kunrei); di, du (Nippon)
    sub "づ" "zu"  # footnote 7
    sub "で" "de"
    sub "ど" "do"
    sub "ば" "ba"
    sub "び" "bi"
    sub "ぶ" "bu"
    sub "べ" "be"
    sub "ぼ" "bo"
    sub "ぱ" "pa"
    sub "ぴ" "pi"
    sub "ぷ" "pu"
    sub "ぺ" "pe"
    sub "ぽ" "po"

    # Katakana gojūon
    sub "ア" "a"
    sub "イ" "i"
    sub "ウ" "u"
    sub "エ" "e"
    sub "オ" "o"
    sub "カ" "ka"
    sub "キ" "ki"
    sub "ク" "ku"
