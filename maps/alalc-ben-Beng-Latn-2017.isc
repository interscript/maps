system "ALA-LC:ben-Beng:Latn:2017" {

metadata {
  authority_id alalc
  id 2017
  language iso-639-2:ben
  source_script Beng
  destination_script Latn
  name Romanization Table -- Bengali (2017)
  url https://www.loc.gov/catdir/cpso/romanization/bengali.pdf
  creation_date 2017
  description {    ALA-LC Romanization table for Bengali
  }

  notes {

    note "Only the vowel forms that appear at the beginning of a syllable are\n listed; the forms used for vowels following a consonant can be found in\n grammars; no distinction between the two is made in transliteration."

    note "      The vowel a is implicit after all consonants and consonant clusters\n      and is supplied in transliteration, with the following exceptions:\n\n      a) when another vowel is indicated by its appropriate sign; and\n      b) when the absence of any vowel is indicated by the subscript symbol ( ্ )\n        called hasanta or birāma."

    note "ব is used both as a labial and as a semivowel. When it occurs as the\n second or subsequent consonant of a consonant cluster, it is\n transliterated va. When ব is doubled, it is transliterated bba."

    note "Candrabindu before guttural, palatal, cerebral, and dental occlusives\n is transliterated n̐. Before labials, sibilants, semivowels, the\n aspirate, vowels, and in final position it is transliterated m̐."

    note "When doubled, abagraha is transliterated by two apostrophes ( ’’ )."
  }
}

tests {
   "র্ক" ->  "rka"
   "গ্র" ->  "gra"
   "ত্য" ->  "tya"
# Exhaustive per-row tests for alalc-ben-Beng-Latn-2017, generated from the source
# document's table.
# Source: ALA-LC Bengali Romanization Table, 2017 version, p. 1 (vowels and
# diphthongs, consonants, anusvara/bisarga/candrabindu/abagraha) + p. 2
# (notes); held source
# interscript-private-references/alalc/alalc-bengali.pdf. Extraction: PDF
# text layer, every value cell cross-checked against the rendered page
# image. The vowel table prints ই as capital "I" (long ī lowercase with
# macron) — transcribed as printed. ঋ -> ṛ, ৠ -> ṝ, ঌ -> ḹ have no
# text-layer values; visually identified from the rendered page. ৎ (khanda
# ta) -> t as printed. The ড়/ঢ়/য় keys are the printed nukta composites.
# Abagraha ঽ -> ’ (apostrophe) as printed. Skipped printed rows: ব second
# listing — the printed table lists ব twice (labial column and semivowel
# column), both "ba (see Note 3)"; Note 3's cluster-position value va is
# context-dependent and un-expressible as a plain row. One ব -> ba row is
# transcribed; the duplicate printed listing is documented here. | ঁ
# (candrabindu) — printed value cell "n̐, m̐ (see Note 4)": Note 4 splits
# the value by the following consonant class — position-dependent,
# un-expressible as a plain row; skipped. E3 corpus-fixes round (2026-11-17): all 11 failing rows are fixed. The
# map's own letter table already carried the printed values but sat AFTER
# the "run map.benglatn.stage.main" item in stage main — the base stage
# consumes the Bengali letters, so those rules matched nothing and every
# divergent cell emitted the base map's 1997-era value. The fix applies the
# printed values to the raw text BEFORE the base run (a pre-empt parallel
# with elision variants mirroring the base RULES machinery and both nukta
# composite forms), so the eleven cells — and every cluster string embedding
# them — now transliterate per the printed table. The rows are part of the
# generated set; the provenance artifact's note replaces this findings
# record.
# Provenance artifact: scripts/row-sources/alalc-ben-Beng-Latn-2017.json (52 rows).
# generated-by: maps/scripts/gen-row-tests.mjs (2026-11-16); regenerate from the artifact, do not hand-edit.
  "অ" -> "a"
  "আ" -> "ā"
  "ই" -> "I"
  "ঈ" -> "ī"
  "উ" -> "u"
  "ঊ" -> "ū"
  "ঋ" -> "ṛ"
  "এ" -> "e"
  "ঐ" -> "ai"
  "ও" -> "o"
  "ঔ" -> "au"
  "ৠ" -> "ṝ"
  "ঌ" -> "ḹ"
  "ক" -> "ka"
  "খ" -> "kha"
  "গ" -> "ga"
  "ঘ" -> "gha"
  "ঙ" -> "ṅa"
  "চ" -> "ca"
  "ছ" -> "cha"
  "জ" -> "ja"
  "ঝ" -> "jha"
  "ঞ" -> "ña"
  "ট" -> "ṭa"
  "ঠ" -> "ṭha"
  "ড" -> "ḍa"
  "ড়" -> "ṛa"
  "ঢ" -> "ḍha"
  "ঢ়" -> "ṛha"
  "ণ" -> "ṇa"
  "ত" -> "ta"
  "ৎ" -> "t"
  "থ" -> "tha"
  "দ" -> "da"
  "ধ" -> "dha"
  "ন" -> "na"
  "প" -> "pa"
  "ফ" -> "pha"
  "ব" -> "ba"
  "ভ" -> "bha"
  "ম" -> "ma"
  "য" -> "ya"
  "য়" -> "ẏa"
  "র" -> "ra"
  "ল" -> "la"
  "শ" -> "śa"
  "ষ" -> "sha"
  "স" -> "sa"
  "হ" -> "ha"
  "ং" -> "ṃ"
  "ঃ" -> "ḥ"
  "ঽ" -> "’"
}

dependency "un-ben-Beng-Latn-2016" as benglatn

aliases {
  beng_signs = any("\u09be\u09bf\u09c0\u09c1\u09c2\u09c3\u09c7\u09c8\u09cb\u09cc\u09cd")
}

stage main {

  # E3 corpus-fixes round (2026-11-17): the printed 2017 values for the
  # eleven letter-table cells where ALA-LC diverges from the UN 2016 base
  # machinery (the depth-batch findings: ই I, চ ca, ছ cha, ড় ṛa, ঢ় ṛha,
  # য ya, য় ẏ, শ śa, ষ sha, ং ṃ, ঽ ’) are applied to the RAW text BEFORE
  # the base stage runs. The base stage consumes the Bengali letters, so a
  # rule placed after the run can never fire — the map's own table sat
  # there and matched nothing, leaving the base's 1997-era values in every
  # divergent cell. Elision variants mirror the base RULES machinery (a
  # consonant followed by a vowel sign or hasanta loses its inherent a);
  # the two-glyph nukta composites are keyed in both the precomposed and
  # the decomposed form; constrained variants precede their unconstrained
  # forms; longer keys precede their shorter prefixes.
  parallel {
    sub "ড়" "ṛa"
    sub { from "ড়" to "ṛ" after beng_signs }
    sub "ড়" "ṛa"
    sub { from "ড়" to "ṛ" after beng_signs }
    sub "ঢ়" "ṛha"
    sub { from "ঢ়" to "ṛh" after beng_signs }
    sub "ঢ়" "ṛha"
    sub { from "ঢ়" to "ṛh" after beng_signs }
    sub "য়" "ẏa"
    sub { from "য়" to "ẏ" after beng_signs }
    sub "য়" "ẏa"
    sub { from "য়" to "ẏ" after beng_signs }
    sub "ই" "I"
    sub "চ" "ca"
    sub { from "চ" to "c" after beng_signs }
    sub "ছ" "cha"
    sub { from "ছ" to "ch" after beng_signs }
    sub "য" "ya"
    sub { from "য" to "y" after beng_signs }
    sub "শ" "śa"
    sub { from "শ" to "ś" after beng_signs }
    sub "ষ" "sha"
    sub { from "ষ" to "sh" after beng_signs }
    sub "ং" "ṃ"
    sub "ঽ" "’"
    sub "ঽ" "’"
  }

  run  map.benglatn.stage.main

  # CHARACTERS
  parallel {

    # I. Vowels and Diphthongs (see Note 1)

    sub "অ" "a"
    sub "ৠ" "ṝ"
    sub "আ" "ā"
    sub "ঌ" "ḹ"
    sub "ই" "I"
    sub "এ" "e"
    sub "ঈ" "ī"
    sub "ঐ" "ai"
    sub "উ" "u"
    sub "ও" "o"
    sub "ঊ" "ū"
    sub "ঔ" "au"
    sub "ঋ" "ṛ"

    # II. Consonants (see Note 2)
    # Gutturals
    sub "ক" "ka"
    sub "খ" "kha"
    sub "গ" "ga"
    sub "ঘ" "gha"
    sub "ঙ" "ṅa"

    # Palatals
    sub "চ" "ca"
    sub "ছ" "cha"
    sub "জ" "ja"
    sub "ঝ" "jha"
    sub "ঞ" "ña"

    # Cerebrals
    sub "ট" "ṭa"
    sub "ঠ" "ṭha"
    sub "ড" "ḍa"
    sub "ড়" "ṛa"
    sub "ঢ" "ḍha"
    sub "ঢ়" "ṛha"
    sub "ণ" "ṇa"

    # Dentals
    sub "ত" "ta"
    sub "ৎ" "t"
    sub "থ" "tha"
    sub "দ" "da"
    sub "ধ" "dha"
    sub "ন" "na"

    # Labials
    sub "প" "pa"
    sub "ফ" "pha"
    sub "ব" "ba"
    sub "ভ" "bha"
    sub "ম" "ma"

    # Semivowels
    sub "য" "ya"
    sub "য়" "ẏa"
    sub "র" "ra"
    sub "ল" "la"
    sub "ব" "ba"

    # Sibilants
    sub "শ" "śa"
    sub "ষ" "sha"
    sub "স" "sa"

    # Aspirate
    sub "হ" "ha"

    # Anusvāra
    sub " ং" "ṃ"

    # Bisarga
    sub " ঃ" "ḥ"

    # Candrabindu (anunāsika) see note 4
    sub "\u0981" "n̐"

    # Abagraha (see Note 5)
    sub "ऽ" "’"
  }
}
}
