system "ALA-LC:ben-Beng:Latn:2017" {

metadata {
  authority_id alalc
  id 2017
  language iso-639-2:ben
  source_script Beng
  destination_script Latn
  name Romanization Table -- Bengali (2017)
  url https://www.loc.gov/catdir/cpso/romanization/bengali.pdf
  creation_date 2017
  description {    ALA-LC Romanization table for Bengali
  }

  notes {

    note "Only the vowel forms that appear at the beginning of a syllable are\n listed; the forms used for vowels following a consonant can be found in\n grammars; no distinction between the two is made in transliteration."

    note "      The vowel a is implicit after all consonants and consonant clusters\n      and is supplied in transliteration, with the following exceptions:\n\n      a) when another vowel is indicated by its appropriate sign; and\n      b) when the absence of any vowel is indicated by the subscript symbol ( ্ )\n        called hasanta or birāma."

    note "ব is used both as a labial and as a semivowel. When it occurs as the\n second or subsequent consonant of a consonant cluster, it is\n transliterated va. When ব is doubled, it is transliterated bba."

    note "Candrabindu before guttural, palatal, cerebral, and dental occlusives\n is transliterated n̐. Before labials, sibilants, semivowels, the\n aspirate, vowels, and in final position it is transliterated m̐."

    note "When doubled, abagraha is transliterated by two apostrophes ( ’’ )."
  }
}

tests {
   "র্ক" ->  "rka"
   "গ্র" ->  "gra"
   "ত্য" ->  "tya"
# Exhaustive per-row tests for alalc-ben-Beng-Latn-2017, generated from the source
# document's table.
# Source: ALA-LC Bengali Romanization Table, 2017 version, p. 1 (vowels and
# diphthongs, consonants, anusvara/bisarga/candrabindu/abagraha) + p. 2
# (notes); held source
# interscript-private-references/alalc/alalc-bengali.pdf. Extraction: PDF
# text layer, every value cell cross-checked against the rendered page
# image. The vowel table prints ই as capital "I" (long ī lowercase with
# macron) — transcribed as printed. ঋ -> ṛ, ৠ -> ṝ, ঌ -> ḹ have no
# text-layer values; visually identified from the rendered page. ৎ (khanda
# ta) -> t as printed. The ড়/ঢ়/য় keys are the printed nukta composites.
# Abagraha ঽ -> ’ (apostrophe) as printed. Skipped printed rows: ব second
# listing — the printed table lists ব twice (labial column and semivowel
# column), both "ba (see Note 3)"; Note 3's cluster-position value va is
# context-dependent and un-expressible as a plain row. One ব -> ba row is
# transcribed; the duplicate printed listing is documented here. | ঁ
# (candrabindu) — printed value cell "n̐, m̐ (see Note 4)": Note 4 splits
# the value by the following consonant class — position-dependent,
# un-expressible as a plain row; skipped. Failing printed rows (findings): ই
# — printed cell "I"; runtime gives 'i'. Failing row, finding below — never
# forced green. | চ — printed cell "ca"; runtime gives 'cha'. Failing row,
# finding below — never forced green. | ছ — printed cell "cha"; runtime
# gives 'chha'. Failing row, finding below — never forced green. | ড় —
# printed cell "ṛa"; runtime gives 'ṙa'. Failing row, finding below — never
# forced green. | ঢ় — printed cell "ṛha"; runtime gives 'ṙha'. Failing row,
# finding below — never forced green. | য — printed cell "ya"; runtime gives
# 'j̱a'. Failing row, finding below — never forced green. | য় — printed
# cell "ẏ"; runtime gives 'ya'. Failing row, finding below — never forced
# green. | শ — printed cell "śa"; runtime gives 'sha'. Failing row, finding
# below — never forced green. | ষ — printed cell "sha"; runtime gives 'ṣha'.
# Failing row, finding below — never forced green. | ং — printed cell "ṃ";
# runtime gives 'ṁ'. Failing row, finding below — never forced green. | ঽ —
# printed cell "’"; runtime gives 'ঽ'. Failing row, finding below — never
# forced green.
# Provenance artifact: scripts/row-sources/alalc-ben-Beng-Latn-2017.json (41 rows).
# generated-by: maps/scripts/gen-row-tests.mjs (2026-11-16); regenerate from the artifact, do not hand-edit.
  "অ" -> "a"
  "আ" -> "ā"
  "ঈ" -> "ī"
  "উ" -> "u"
  "ঊ" -> "ū"
  "ঋ" -> "ṛ"
  "এ" -> "e"
  "ঐ" -> "ai"
  "ও" -> "o"
  "ঔ" -> "au"
  "ৠ" -> "ṝ"
  "ঌ" -> "ḹ"
  "ক" -> "ka"
  "খ" -> "kha"
  "গ" -> "ga"
  "ঘ" -> "gha"
  "ঙ" -> "ṅa"
  "জ" -> "ja"
  "ঝ" -> "jha"
  "ঞ" -> "ña"
  "ট" -> "ṭa"
  "ঠ" -> "ṭha"
  "ড" -> "ḍa"
  "ঢ" -> "ḍha"
  "ণ" -> "ṇa"
  "ত" -> "ta"
  "ৎ" -> "t"
  "থ" -> "tha"
  "দ" -> "da"
  "ধ" -> "dha"
  "ন" -> "na"
  "প" -> "pa"
  "ফ" -> "pha"
  "ব" -> "ba"
  "ভ" -> "bha"
  "ম" -> "ma"
  "র" -> "ra"
  "ল" -> "la"
  "স" -> "sa"
  "হ" -> "ha"
  "ঃ" -> "ḥ"
}

dependency "un-ben-Beng-Latn-2016" as benglatn


stage main {
  run  map.benglatn.stage.main

  # CHARACTERS
  parallel {

    # I. Vowels and Diphthongs (see Note 1)

    sub "অ" "a"
    sub "ৠ" "ṝ"
    sub "আ" "ā"
    sub "ঌ" "ḹ"
    sub "ই" "I"
    sub "এ" "e"
    sub "ঈ" "ī"
    sub "ঐ" "ai"
    sub "উ" "u"
    sub "ও" "o"
    sub "ঊ" "ū"
    sub "ঔ" "au"
    sub "ঋ" "ṛ"

    # II. Consonants (see Note 2)
    # Gutturals
    sub "ক" "ka"
    sub "খ" "kha"
    sub "গ" "ga"
    sub "ঘ" "gha"
    sub "ঙ" "ṅa"

    # Palatals
    sub "চ" "ca"
    sub "ছ" "cha"
    sub "জ" "ja"
    sub "ঝ" "jha"
    sub "ঞ" "ña"

    # Cerebrals
    sub "ট" "ṭa"
    sub "ঠ" "ṭha"
    sub "ড" "ḍa"
    sub "ড়" "ṛa"
    sub "ঢ" "ḍha"
    sub "ঢ়" "ṛha"
    sub "ণ" "ṇa"

    # Dentals
    sub "ত" "ta"
    sub "ৎ" "t"
    sub "থ" "tha"
    sub "দ" "da"
    sub "ধ" "dha"
    sub "ন" "na"

    # Labials
    sub "প" "pa"
    sub "ফ" "pha"
    sub "ব" "ba"
    sub "ভ" "bha"
    sub "ম" "ma"

    # Semivowels
    sub "য" "ya"
    sub "য়" "ẏa"
    sub "র" "ra"
    sub "ল" "la"
    sub "ব" "ba"

    # Sibilants
    sub "শ" "śa"
    sub "ষ" "sha"
    sub "স" "sa"

    # Aspirate
    sub "হ" "ha"

    # Anusvāra
    sub " ং" "ṃ"

    # Bisarga
    sub " ঃ" "ḥ"

    # Candrabindu (anunāsika) see note 4
    sub "\u0981" "n̐"

    # Abagraha (see Note 5)
    sub "ऽ" "’"
  }
}
}
