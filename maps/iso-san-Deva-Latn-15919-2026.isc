   "ॠ" ->  "r̥̄"
   "ॄ" ->  "r̥̄"
   "ज" ->  "ja"
   "ऌ" ->  "l̥"
   "ॢ" ->  "l̥"
   "झ" ->  "jha"
   "ॡ" ->  "l̥̄"
   "ॣ" ->  "l̥̄"
   "ञ" ->  "ña"
   "ऎ" ->  "e"
   "ॆ" ->  "e"
   "ट" ->  "ṭa"
   "ए" ->  "ē"
   "े" ->  "ē"
   "ठ" ->  "ṭha"
   "ऐ" ->  "ai"
