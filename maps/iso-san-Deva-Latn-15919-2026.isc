   "ी" ->  "ī"
   "घ" ->  "gha"
   "उ" ->  "u"
   "ु" ->  "u"
   "ङ" ->  "ṅa"
   "ऊ" ->  "ū"
   "ू" ->  "ū"
   "च" ->  "ca"
   "ऋ" ->  "r̥"
   "ृ" ->  "r̥"
