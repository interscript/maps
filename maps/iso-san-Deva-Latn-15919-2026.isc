   "ं" ->  "ṁ"
   "ँ" ->  "m̐"
   "ः" ->  "ḥ"
   "ऽ" ->  "'"
   "ᳵ" ->  "ẖ"
   "ᳶ" ->  "ḫ"
   "०" ->  "0"
   "१" ->  "1"
   "२" ->  "2"
   "३" ->  "3"
   "४" ->  "4"
   "५" ->  "5"
   "६" ->  "6"
   "७" ->  "7"
   "८" ->  "8"
   "९" ->  "9"
}

stage main {

  # Table 7.1 rows (clause 7), Table A.2 numerals, clause 6 virama, options 9.8/9.9/9.10
  parallel {

    sub "अ" "a"
    sub "अ" "A" when opt98
    sub "क" "ka"
    sub "आ" "ā"
    sub "ा" "ā"
    sub "आ" "Ā" when opt98
    sub "ख" "kha"
    sub "इ" "i"
    sub "ि" "i"
    sub "इ" "I" when opt98
    sub "ग" "ga"
    sub "ई" "ī"
    sub "ी" "ī"
    sub "ई" "Ī" when opt98
    sub "घ" "gha"
    sub "उ" "u"
    sub "ु" "u"
    sub "उ" "U" when opt98
    sub "ङ" "ṅa"
    sub "ऊ" "ū"
    sub "ू" "ū"
    sub "ऊ" "Ū" when opt98
    sub "च" "ca"
    sub "ऋ" "r̥"
    sub "ृ" "r̥"
    sub "ऋ" "R̥" when opt98
    sub "छ" "cha"
    sub "ॠ" "r̥̄"
    sub "ॄ" "r̥̄"
    sub "ॠ" "R̥̄" when opt98
    sub "ज" "ja"
    sub "ऌ" "l̥"
    sub "ॢ" "l̥"
    sub "ऌ" "L̥" when opt98
    sub "झ" "jha"
    sub "ॡ" "l̥̄"
    sub "ॣ" "l̥̄"
    sub "ॡ" "L̥̄" when opt98
    sub "ञ" "ña"
    sub "ऎ" "e"
    sub "ॆ" "e"
    sub "ऎ" "E" when opt98
    sub "ट" "ṭa"
    sub "ए" "ē"
    sub "े" "ē"
    sub "ए" "Ē" when opt98
    sub "ठ" "ṭha"
    sub "ऐ" "ai"
    sub "ै" "ai"
    sub "ऐ" "Ai" when opt98
    sub "ड" "ḍa"
    sub "ऒ" "o"
    sub "ॊ" "o"
    sub "ऒ" "O" when opt98
    sub "ढ" "ḍha"
    sub "ओ" "ō"
    sub "ो" "ō"
    sub "ओ" "Ō" when opt98
    sub "ण" "ṇa"
    sub "औ" "au"
    sub "ौ" "au"
    sub "औ" "Au" when opt98
    sub "ऩ" "ṉa"
    sub "ऍ" "ê"
    sub "ॅ" "ê"
    sub "ऍ" "Ê" when opt98
    sub "ऑ" "ô"
    sub "ॉ" "ô"
    sub "ऑ" "Ô" when opt98
    sub "त" "ta"
    sub "थ" "tha"
    sub "द" "da"
    sub "ध" "dha"
    sub "न" "na"
    sub "प" "pa"
    sub "फ" "pha"
    sub "ब" "ba"
    sub "भ" "bha"
    sub "म" "ma"
    sub "य" "ya"
    sub "य़" "ẏ"
    sub "र" "ra"
    sub "ऱ" "ṟa"
    sub "ल" "la"
    sub "ळ" "ḷa"
    sub "ऴ" "ḻa"
    sub "व" "va"
    sub "श" "śa"
    sub "ष" "ṣa"
    sub "स" "sa"
    sub "ह" "ha"
    sub "क़" "qa"
    sub "ख़" "k͟ha"
    sub "ग़" "ġa"
    sub "ज़" "za"
    sub "ड़" "ṛa"
    sub "ॹ" "źa"
    sub "ढ़" "ṛha"
    sub "फ़" "fa"
    sub "ऱ्" "r̆"  # Table 7.1 printed row: ṟa + virāma (0931 094D), footnote b
    sub "र्‍" "r̆"  # footnote b: implementations might also encounter ra + virāma + ZWJ (0930 094D 200D)
    sub "ं" "ṁ"  # Rules 3, 5, 8
    sub "ँ" "m̐"  # Rules 4, 5, 8
    sub "ः" "ḥ"
    sub "ऽ" "'"  # Rule 15
    sub "ᳵ" "ẖ"  # Rule 17: jihvāmūlīya (Hex 1CF5) → ẖ (Hex 1E96)
    sub "ᳶ" "ḫ"  # Rule 17: upadhmānīya (Hex 1CF6) → ḫ (Hex 1E2B)
    sub "्" ""
    sub "्" "·" when opt10
    sub "‍" ""
    sub "‍" "=" when opt99
    sub "०" "0"
    sub "१" "1"
    sub "२" "2"
    sub "३" "3"
    sub "४" "4"
    sub "५" "5"
    sub "६" "6"
    sub "७" "7"
    sub "८" "8"
    sub "९" "9"
  }

  compose
}
