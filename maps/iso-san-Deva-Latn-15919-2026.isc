   "ॅ" ->  "ê"
   "ऑ" ->  "ô"
   "ॉ" ->  "ô"
   "त" ->  "ta"
   "थ" ->  "tha"
   "द" ->  "da"
   "ध" ->  "dha"
   "न" ->  "na"
   "प" ->  "pa"
   "फ" ->  "pha"
