    sub "𑐉" "L̥̄" when opt98
    sub "𑐗" "jha"
    sub "𑐊" "ē"
    sub "𑐾" "ē"
    sub "𑐊" "Ē" when opt98
    sub "𑐘" "ña"
    sub "𑐋" "ai"
    sub "𑐿" "ai"
    sub "𑐋" "Ai" when opt98
    sub "𑐙" "n̤a"
