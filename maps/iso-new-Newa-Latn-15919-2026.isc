   "𑐞" ->  "ṇa"
}

stage main {

  # Table 7.17 rows (clause 7), Table A.2 numerals, clause 6 virama, options 9.8/9.9/9.10
  parallel {

    sub "𑐀" "a"
    sub "𑐀" "A" when opt98
    sub "𑐎" "ka"
    sub "𑐁" "ā"
    sub "𑐵" "ā"
    sub "𑐁" "Ā" when opt98
    sub "𑐏" "kha"
    sub "𑐂" "i"
