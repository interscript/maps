   "ু" ->  "u"
   "ঙ" ->  "ṅa"
   "ঊ" ->  "ū"
   "ূ" ->  "ū"
   "চ" ->  "ca"
   "ঋ" ->  "r̥"
   "ৃ" ->  "r̥"
   "ছ" ->  "cha"
   "ৠ" ->  "r̥̄"
   "ৄ" ->  "r̥̄"
