   "ে" ->  "ē"
   "ট" ->  "ṭa"
   "ঐ" ->  "ai"
   "ৈ" ->  "ai"
   "ঠ" ->  "ṭha"
   "ও" ->  "ō"
   "ো" ->  "ō"
   "ড" ->  "ḍa"
