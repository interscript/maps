   "ব়" ->  "wa"
   "য" ->  "ya"
   "ং" ->  "ṁ"
   "য়" ->  "ẏa"
   "ঁ" ->  "m̐"
   "র" ->  "ra"
   "ঃ" ->  "ḥ"
   "ৰ" ->  "ṟa"
   "ঽ" ->  "'"
   "০" ->  "0"
   "১" ->  "1"
   "২" ->  "2"
   "৩" ->  "3"
   "৪" ->  "4"
   "৫" ->  "5"
   "৬" ->  "6"
   "৭" ->  "7"
   "৮" ->  "8"
   "৯" ->  "9"
   "ণ" ->  "ṇa"
   "ড়" ->  "ṛa"
   "ঢ়" ->  "ṛha"
   "য়" ->  "ẏa"
}

stage main {

  # Table 7.2 rows (clause 7), Table A.2 numerals, clause 6 virama, options 9.8/9.9/9.10
  parallel {

    sub "অ" "a"
    sub "অ" "A" when opt98
    sub "ক" "ka"
    sub "আ" "ā"
    sub "া" "ā"
    sub "আ" "Ā" when opt98
    sub "খ" "kha"
    sub "ই" "i"
    sub "ি" "i"
    sub "ই" "I" when opt98
    sub "গ" "ga"
    sub "ঈ" "ī"
    sub "ী" "ī"
    sub "ঈ" "Ī" when opt98
    sub "ঘ" "gha"
    sub "উ" "u"
    sub "ু" "u"
    sub "উ" "U" when opt98
    sub "ঙ" "ṅa"
    sub "ঊ" "ū"
    sub "ূ" "ū"
    sub "ঊ" "Ū" when opt98
    sub "চ" "ca"
    sub "ঋ" "r̥"
    sub "ৃ" "r̥"
    sub "ঋ" "R̥" when opt98
    sub "ছ" "cha"
    sub "ৠ" "r̥̄"
    sub "ৄ" "r̥̄"
    sub "ৠ" "R̥̄" when opt98
    sub "জ" "ja"
    sub "ঌ" "l̥"
    sub "ৢ" "l̥"
    sub "ঌ" "L̥" when opt98
    sub "ঝ" "jha"
    sub "ৡ" "l̥̄"
    sub "ৣ" "l̥̄"
    sub "ৡ" "L̥̄" when opt98
    sub "ঞ" "ña"
    sub "এ" "ē"
    sub "ে" "ē"
    sub "এ" "Ē" when opt98
    sub "ট" "ṭa"
    sub "ঐ" "ai"
    sub "ৈ" "ai"
    sub "ঐ" "Ai" when opt98
    sub "ঠ" "ṭha"
    sub "ও" "ō"
    sub "ো" "ō"
    sub "ও" "Ō" when opt98
    sub "ড" "ḍa"
    sub "ঔ" "au"
    sub "ৌ" "au"
    sub "ঔ" "Au" when opt98
    sub "ঢ" "ḍha"
    sub "ণ" "ṇa"
    sub "ত" "ta"
    sub "ল" "la"
    sub "থ" "tha"
    sub "ৱ" "va"
    sub "দ" "da"
    sub "শ" "śa"
    sub "ধ" "dha"
    sub "ষ" "ṣa"
    sub "ন" "na"
    sub "স" "sa"
    sub "প" "pa"
    sub "হ" "ha"
    sub "ফ" "pha"
    sub "ড়" "ṛa"
    sub "ড়" "ṛa"  # precomposed (clause 7.3: precomposed and decomposed equal on input)
    sub "ব" "ba"
    sub "ঢ়" "ṛha"
    sub "ঢ়" "ṛha"  # precomposed (clause 7.3: precomposed and decomposed equal on input)
    sub "ভ" "bha"
    sub "জ়" "za"
    sub "ম" "ma"
    sub "ব়" "wa"
    sub "য" "ya"
    sub "ং" "ṁ"
    sub "য়" "ẏa"
    sub "য়" "ẏa"  # precomposed (clause 7.3: precomposed and decomposed equal on input)
    sub "ঁ" "m̐"
    sub "র" "ra"
    sub "ঃ" "ḥ"
    sub "ৰ" "ṟa"
    sub "ঽ" "'"
    sub "্" ""
    sub "্" "·" when opt10
    sub "‍" ""
    sub "‍" "=" when opt99
    sub "০" "0"
    sub "১" "1"
    sub "২" "2"
    sub "৩" "3"
    sub "৪" "4"
    sub "৫" "5"
    sub "৬" "6"
    sub "৭" "7"
    sub "৮" "8"
    sub "৯" "9"
  }

  compose
}
}
