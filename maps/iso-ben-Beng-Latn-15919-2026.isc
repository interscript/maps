   "প" ->  "pa"
   "হ" ->  "ha"
   "ফ" ->  "pha"
   "ড়" ->  "ṛa"
   "ব" ->  "ba"
   "ঢ়" ->  "ṛha"
   "ভ" ->  "bha"
