   "ੰ" ->  "ṃ"
   "ਲ਼" ->  "ḷa"
   "ਁ" ->  "m̐"
   "ਵ" ->  "va"
   "ਃ" ->  "ḥ"
   "ੜ" ->  "ṛa"
   "੦" ->  "0"
