   "ਗ਼" ->  "ġa"
   "ਭ" ->  "bha"
   "ਜ਼" ->  "za"
   "ਮ" ->  "ma"
   "ਫ਼" ->  "fa"
   "ਯ" ->  "ya"
   "ਰ" ->  "ra"
   "ਂ" ->  "ṁ"
