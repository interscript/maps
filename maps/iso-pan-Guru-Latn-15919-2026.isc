   "੨" ->  "2"
   "੩" ->  "3"
   "੪" ->  "4"
   "੫" ->  "5"
   "੬" ->  "6"
   "੭" ->  "7"
   "੮" ->  "8"
   "੯" ->  "9"
   "ਲ਼" ->  "ḷa"
   "ਸ਼" ->  "śa"
   "ਖ਼" ->  "k͟ha"
   "ਗ਼" ->  "ġa"
   "ਜ਼" ->  "za"
   "ਫ਼" ->  "fa"
   "ਕ਼" ->  "qa"
}

stage main {

  # Table 7.3 rows (clause 7), Table A.2 numerals, clause 6 virama, options 9.8/9.9/9.10
  parallel {

    sub "ਅ" "a"
    sub "ਅ" "A" when opt98
    sub "ਚ" "ca"
    sub "ਆ" "ā"
    sub "ਾ" "ā"
    sub "ਆ" "Ā" when opt98
    sub "ਛ" "cha"
    sub "ਇ" "i"
    sub "ਿ" "i"
    sub "ਇ" "I" when opt98
    sub "ਜ" "ja"
    sub "ਈ" "ī"
    sub "ੀ" "ī"
    sub "ਈ" "Ī" when opt98
    sub "ਝ" "jha"
    sub "ਉ" "u"
    sub "ੁ" "u"
    sub "ਉ" "U" when opt98
    sub "ਞ" "ña"
    sub "ਊ" "ū"
    sub "ੂ" "ū"
    sub "ਊ" "Ū" when opt98
    sub "ਟ" "ṭa"
    sub "ਏ" "ē"
    sub "ੇ" "ē"
    sub "ਏ" "Ē" when opt98
    sub "ਠ" "ṭha"
    sub "ਐ" "ai"
    sub "ੈ" "ai"
    sub "ਐ" "Ai" when opt98
    sub "ਡ" "ḍa"
    sub "ਓ" "ō"
    sub "ੋ" "ō"
    sub "ਓ" "Ō" when opt98
    sub "ਢ" "ḍha"
    sub "ਔ" "au"
    sub "ੌ" "au"
    sub "ਔ" "Au" when opt98
    sub "ਣ" "ṇa"
    sub "ਸ" "sa"
    sub "ਸ" "Sa" when opt98
    sub "ਤ" "ta"
    sub "ਹ" "ha"
    sub "ਹ" "Ha" when opt98
    sub "ਥ" "tha"
    sub "ਕ" "ka"
    sub "ਕ਼" "qa"
    sub "ਕ" "Ka" when opt98
    sub "ਦ" "da"
    sub "ਖ" "kha"
    sub "ਖ" "Kha" when opt98
    sub "ਧ" "dha"
    sub "ਗ" "ga"
    sub "ਗ" "Ga" when opt98
    sub "ਨ" "na"
    sub "ਘ" "gha"
    sub "ਘ" "Gha" when opt98
    sub "ਙ" "ṅa"
    sub "ਙ" "Ṅa" when opt98
    sub "ਪ" "pa"
    sub "ਸ਼" "śa"
    sub "ਸ਼" "śa"  # precomposed (clause 7.3: precomposed and decomposed equal on input)
    sub "ਫ" "pha"
    sub "ਖ਼" "k͟ha"
    sub "ਖ਼" "k͟ha"  # precomposed (clause 7.3: precomposed and decomposed equal on input)
    sub "ਬ" "ba"
    sub "ਗ਼" "ġa"
    sub "ਗ਼" "ġa"  # precomposed (clause 7.3: precomposed and decomposed equal on input)
    sub "ਭ" "bha"
    sub "ਜ਼" "za"
    sub "ਜ਼" "za"  # precomposed (clause 7.3: precomposed and decomposed equal on input)
    sub "ਮ" "ma"
    sub "ਫ਼" "fa"
    sub "ਫ਼" "fa"  # precomposed (clause 7.3: precomposed and decomposed equal on input)
    sub "ਯ" "ya"
    sub "ਰ" "ra"
    sub "ਂ" "ṁ"
    sub "ਲ" "la"
    sub "ਲ਼" "ḷa"
    sub "ੰ" "ṃ"
    sub "ਲ਼" "ḷa"
    sub "ਁ" "m̐"
    sub "ਵ" "va"
    sub "ਃ" "ḥ"
    sub "ੜ" "ṛa"
    sub "੍" ""
    sub "੍" "·" when opt10
    sub "‍" ""
    sub "‍" "=" when opt99
    sub "੦" "0"
    sub "੧" "1"
    sub "੨" "2"
    sub "੩" "3"
    sub "੪" "4"
    sub "੫" "5"
    sub "੬" "6"
    sub "੭" "7"
    sub "੮" "8"
    sub "੯" "9"
  }

  compose
}
}
