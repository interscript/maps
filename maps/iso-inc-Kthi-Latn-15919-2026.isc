    sub "𑂉" "ē"
    sub "𑂵" "ē"
    sub "𑂉" "Ē" when opt98
    sub "𑂊" "ai"
    sub "𑂶" "ai"
    sub "𑂊" "Ai" when opt98
    sub "𑂋" "ō"
    sub "𑂷" "ō"
    sub "𑂋" "Ō" when opt98
    sub "𑂌" "au"
