    sub "𑂞" "ta"
    sub "𑂟" "tha"
    sub "ᄊ9ᄋ2ᄌ2" "r̥"
    sub "𑂀" "m̐"
    sub "𑂁" "ṁ"
    sub "𑂂" "ḥ"
    sub "𑃁" ""
    sub "𑃁" "·" when opt10
    sub "‍" ""
    sub "‍" "=" when opt99
    sub "०" "0"
    sub "१" "1"
    sub "२" "2"
