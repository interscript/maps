    sub "𑂦" "bha"
    sub "𑂔" "ja"
    sub "𑂧" "ma"
    sub "𑂕" "jha"
    sub "𑂨" "ya"
    sub "𑂖" "ña"
    sub "𑂩" "ra"
    sub "𑂗" "ṭa"
    sub "𑂪" "la"
