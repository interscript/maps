   "२" ->  "2"
   "३" ->  "3"
   "४" ->  "4"
   "५" ->  "5"
   "६" ->  "6"
   "७" ->  "7"
   "८" ->  "8"
   "९" ->  "9"
   "𑂀" ->  "m̐"
   "𑂁" ->  "ṁ"
   "𑂂" ->  "ḥ"
}

stage main {

  # Table 7.13 rows (clause 7), Table A.2 numerals, clause 6 virama, options 9.8/9.9/9.10
  parallel {

    sub "𑂃" "a"
    sub "𑂃" "A" when opt98
    sub "𑂄" "ā"
    sub "𑂰" "ā"
    sub "𑂄" "Ā" when opt98
    sub "𑂅" "i"
    sub "𑂱" "i"
