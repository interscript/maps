system "ALA-LC:btk-Batk:Latn:2012" {

metadata {
  authority_id alalc
  id 2012
  language iso-639-2:btk
  source_script Batk
  destination_script Latn
  name "Batak Romanization Table (2012)"
  url https://www.loc.gov/catdir/cpso/romanization/batak.pdf
  creation_date 2012
  adoption_date
  description {    ALA-LC Batak Romanization Table, 2012 version (earlier: 2002). Fourteen
    consonant letters carry an implicit /a/ (suppressed by the pangolat
    or overridden by a vowel sign); I and U are pure vowels; the vowel
    signs e i o u follow the letter a when it is already present (aek);
    the ng and h consonant signs are codas that keep the implicit vowel.
    Dialect notes from the table: Mandailing S/H/CA and the ka letter
    (Mandailing HA), Dairi t/v readings. Transcribed from the loc.gov
    document; the PDF renders Batak glyphs through a shape-based
    substitute font, so the letter-to-codepoint correspondence follows
    the standard Batak block with the table's dialect footnotes
    (all 31 assignments verified against Unicode names).
  }

  notes {
    note "Northern TA (U+1BD7) is the Dairi-variant of the t letter
    (U+1BD6); it maps identically. Dialect vowel signs (U+1BE8 U+1BEB
    U+1BED U+1BEF) carry the same values as their base signs."
  }
}

tests {
   "\u1BC0" ->  "a"
   "\u1BC5" ->  "ba"
   "\u1BD8" ->  "sa"
   "\u1BD1" ->  "da"
   "\u1BCE" ->  "ga"
