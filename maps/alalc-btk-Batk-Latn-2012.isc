   "\u1BC5\u1BEA" ->  "bi"
   "\u1BC5\u1BEC" ->  "bo"
   "\u1BC0\u1BE7" ->  "ae"
   "\u1BC5\u1BF0" ->  "bang"
   "\u1BC5\u1BF2" ->  "b"
