system "ALA-LC:und-Dsrt:Latn:2016" {

metadata {
  authority_id alalc
  id 2016
  language iso-639-2:und
  source_script Dsrt
  destination_script Latn
  name "Deseret Romanization Table (2016)"
  url https://www.loc.gov/catdir/cpso/romanization/deseret.pdf
  creation_date 2016
  adoption_date
  description {    ALA-LC Deseret Romanization Table, 2016 version (no earlier
    versions). The table is scoped to the Deseret script (the Deseret
    alphabet), not to any one language, so the language field carries
    the undetermined code; the alphabet was devised in the 1850s for
    English. Forty letters (six vowels and thirty-four consonants and
    vowel-length and diphthong forms), each mapping one-to-one; the
    letter values follow the printed table. The source document's
    text layer doubles every letter glyph in the vernacular column; a
    visual check of the rendered pages confirms a single letter per
    row, and the codepoints below are the Unicode Deseret block values
    corresponding to the table's letter order.
  }

  notes {
    note "Vowel-length letters: Ē (𐐀/𐐨), Ī (𐐌/𐐴), Ō (𐐄/𐐬), Ū (𐐅/𐐭),
    Ā (𐐁/𐐩) are the long-vowel letters; Ä (𐐂/𐐪), Ô (𐐉/𐐱), Ü (𐐋/𐐳)
    the broad-vowel letters. The digraph values Dh Zh Th Sh Ch and the
    diphthong values Aw Oy and the letter Yū (𐐧/𐑏) are single letters
    in the script."
  }
}

